# @public — tula weight-file format: header + typed tensor manifest + payload.
#
# Layout (all fields i64-aligned; little-endian i64 words):
#
#   HEADER (64 bytes)
#     +0  magic          (TULA_MAGIC)
#     +8  version        (TULA_VERSION)
#     +16 tensor_count
#     +24 manifest_off   (= 64)
#     +32 payload_off
#     +40 payload_len
#     +48 sig_off        (0 = unsigned; else payload_off + payload_len)
#     +56 sig_len        (0 = unsigned; else 64, an Ed25519 signature)
#
#   MANIFEST — tensor_count × ENTRY (144 bytes each), at manifest_off
#     +0   name[48]      (cstring, null-padded; ≤47 chars)
#     +48  dtype         (TulaDType)
#     +56  ndim
#     +64  shape[8]      (8 × i64; unused dims zero)
#     +128 data_off      (offset within payload)
#     +136 data_len      (bytes)
#
#   PAYLOAD — raw tensor bytes at payload_off; each tensor 8-byte aligned, the
#             0..7 padding bytes after it zero.
#
#   SIGNATURE — optional 64-byte Ed25519 block at sig_off (src/sign.cyr).
#
# This module is the in-memory codec: builder -> serialize, and validate ->
# accessors. File I/O is src/fileio.cyr; signing is src/sign.cyr.

enum TulaDType {
    TULA_DT_F64     = 0;   # raw f64 (IEEE-754 i64 bit patterns)
    TULA_DT_INT8    = 1;   # int8 activations / quantized
    TULA_DT_TERNARY = 2;   # packed {-1,0,+1} (tentib)
    TULA_DT_NF4     = 3;   # 4-bit blockwise NormalFloat (anukulana / QLoRA)
    TULA_DT_F32     = 4;   # IEEE binary32, 4 bytes LE (1.3.0, ADR 0005)
    TULA_DT_F16     = 5;   # IEEE binary16, 2 bytes LE (1.3.0, ADR 0005)
    TULA_DT_BF16    = 6;   # bfloat16 (binary32's top half), 2 bytes LE (1.3.0, ADR 0005)
    TULA_DT_I16     = 7;   # signed 16-bit, two's complement, 2 bytes LE (1.7.0, ADR 0009)
    TULA_DT_I32     = 8;   # signed 32-bit, two's complement, 4 bytes LE (1.7.0, ADR 0009)
    TULA_DT_I64     = 9;   # signed 64-bit, two's complement, 8 bytes LE (1.7.0, ADR 0009)
    TULA_DT_U8      = 10;  # unsigned 8-bit, 1 byte (1.7.0, ADR 0009)
    TULA_DT_BOOL    = 11;  # 1 byte: 0 false, 1 true, nothing else (1.7.0, ADR 0009)
    TULA_DT_F8_E4M3 = 12;  # OCP FP8 E4M3 (no inf; NaN S.1111.111), 1 byte (1.8.0, ADR 0010)
    TULA_DT_F8_E5M2 = 13;  # OCP FP8 E5M2 (IEEE-like), 1 byte (1.8.0, ADR 0010)
    TULA_DT_INT4    = 14;  # signed 4-bit codes, 2 per byte, low nibble first (1.8.0, ADR 0011)
    TULA_DT_UINT4   = 15;  # unsigned 4-bit codes, INT4's layout; .scale + .min sidecars (1.12.0, ADR 0015)
}

# The long-name table (1.3.0, ADR 0004): a reserved int8 tensor named
# "__tula.names__", the last manifest entry, whose payload is the magic, a record
# count L, L records {entry_index, name_off, name_len}, then the names (each
# NUL-terminated). An entry with a long name stores its KEY in the 48-byte field:
# the name's first TULA_NAMES_PREFIX bytes, '~', 16 lowercase hex digits of the
# name's FNV-1a-64.
enum TulaNames {
    TULA_NAMES_MAGIC  = 0x316D6E2E616C7574;   # "tula.nm1", little-endian
    TULA_NAMES_HDR    = 16;                   # magic + record count
    TULA_NAMES_REC    = 24;                   # entry_index, name_off, name_len
    TULA_NAMES_PREFIX = 30;                   # name bytes kept in its key
}

# File metadata (1.6.0, ADR 0008): a reserved int8 tensor "__tula.meta__", after
# every ordinary tensor and before the names table, whose payload is the magic,
# a pair count P, P records {key_off, key_len, val_off, val_len} sorted by key
# (unique), then each key, NUL, value, NUL — packed in record order.
enum TulaMeta {
    TULA_META_MAGIC     = 0x31746D2E616C7574;   # "tula.mt1", little-endian
    TULA_META_HDR       = 16;                   # magic + pair count
    TULA_META_REC       = 32;                   # key_off, key_len, val_off, val_len
    TULA_META_KEY_MAX   = 255;
    TULA_META_VALUE_MAX = 16777216;             # 16 MiB per value
    TULA_META_MAX_PAIRS = 4096;
    TULA_META_MAX_BYTES = 67108864;             # 64 MiB of table
}

enum TulaSigStatus {
    TULA_SIG_UNSIGNED = 0;   # no signature present
    TULA_SIG_OK       = 1;   # sigil signature verified (M0b)
    TULA_SIG_BAD      = 2;   # signature present but invalid (M0b)
}

enum TulaFmt {
    TULA_MAGIC       = 0x54554C41;   # "TULA"
    TULA_VERSION     = 1;
    TULA_HEADER_SIZE = 64;
    TULA_ENTRY_SIZE  = 144;
    TULA_NAME_CAP    = 48;           # name field width (bytes)
    TULA_NAME_MAX    = 47;           # max name chars (+1 null)
    TULA_MAXDIM      = 8;
    TULA_BUILDER_MAX = 256;          # max tensors per builder
}

# Reader resource caps (M3) — a foreign/lying file must never make us trust an
# absurd tensor count or allocate/read a bomb-sized payload. These bound the
# validator's arithmetic well inside i64 (count*ENTRY_SIZE and the offset sums
# can never overflow) and give the file readers a pre-alloc sanity ceiling.
enum TulaLimits {
    TULA_READ_MAX_TENSORS = 1048576;       # 1<<20 — reject absurd manifest counts
    TULA_READ_MAX_BYTES   = 0x10000000000; # 1<<40 (1 TiB) — total-size ceiling
}

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

# Round n up to the next multiple of 8.
fn tula_align8(n): i64 {
    return ((n + 7) / 8) * 8;
}

# Copy n bytes src -> dst, a 64-bit word at a time with a byte tail. Unaligned
# word access is fine on every cyrius target (x86_64, aarch64, cx). The stdlib
# memcpy is a byte loop, which made tula_serialize copy the whole payload one
# byte at a time. n <= 0 copies nothing.
fn _tula_copy(dst, src, n): i64 {
    var i = 0;
    while (i + 32 <= n) {
        store64(dst + i, load64(src + i));
        store64(dst + i + 8, load64(src + i + 8));
        store64(dst + i + 16, load64(src + i + 16));
        store64(dst + i + 24, load64(src + i + 24));
        i = i + 32;
    }
    while (i + 8 <= n) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    while (i < n) {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
    return dst;
}

# Zero n bytes at dst (n <= 0 writes nothing).
fn _tula_zero(dst, n): i64 {
    var i = 0;
    while (i < n) {
        store8(dst + i, 0);
        i = i + 1;
    }
    return dst;
}

# Copy a cstring into a 48-byte name field: truncate to 47, null-pad the rest.
# (1.9.0) The cstring is measured only up to 47 bytes, and the field is zeroed
# and filled a word at a time.
fn tula_name_write(dst, src): i64 {
    var n = 0;
    while (n < TULA_NAME_MAX) {
        if (load8(src + n) == 0) { break; }
        n = n + 1;
    }
    _tula_zero48(dst);
    _tula_copy(dst, src, n);
    return 0;
}

# Zero a 48-byte name field.
fn _tula_zero48(dst): i64 {
    store64(dst, 0);
    store64(dst + 8, 0);
    store64(dst + 16, 0);
    store64(dst + 24, 0);
    store64(dst + 32, 0);
    store64(dst + 40, 0);
    return 0;
}

# 1 if the 8 bytes of w include a zero byte (exact: (w - 0x01..) & ~w & 0x80..
# is nonzero iff some byte is zero).
fn _tula_has_zero(w): i64 {
    if (((w - 0x0101010101010101) & (w ^ (0 - 1)) & 0x8080808080808080) != 0) { return 1; }
    return 0;
}

# Packed version int: major*10000 + minor*100 + patch (1.13.0 -> 11300).
fn tula_version_int(): i64 {
    return 11300;
}

# ---------------------------------------------------------------------------
# builder — accumulate tensors, then serialize into one contiguous buffer
# ---------------------------------------------------------------------------
# Builder layout (private; only the +0 count and +8 payload_total words are
# relied on outside this file, by the tests):
#   +0  count            +8  payload_total (sum of 8-aligned data_len, without
#                            the names table, which serialize appends)
#   +16 cap              +24 name-index table ptr      +32 index mask
#   +40 long names held  +48 their bytes, NULs included (1.3.0)
#   +56 metadata (1.6.0): 0, or a 32-byte block {pairs, capacity, sorted array
#       of 32-byte pairs {key ptr, key len, value ptr, value len}, key+value
#       bytes with their NULs}
#   +64 entries, TULA_BENTRY_SIZE each:
#       [0, 144)  the tensor's manifest entry, ready to copy into the file —
#                 name (truncated to 47, zero-padded) or, for a long name, its
#                 key; dtype, ndim, shape (unused dims zero), data_off (the
#                 payload cursor at add time), data_len
#       +144      data ptr (borrowed until finish)
#       +152      the full name's builder-owned copy (a long name only), +160 its length
# The name and shape are COPIED at add time (1.2.0), so a caller can reuse one
# name or shape buffer for every add; only the payload bytes stay borrowed.
#
# The name index is an open-addressing hash set over the stored 48-byte names,
# 2..4 slots per tensor, so checked adds find a duplicate in O(1). The builder
# is the caller's own trusted code, so an unkeyed hash is fine here; the reader
# side never hashes untrusted names (tula_validate_strict sorts them instead).

enum TulaBuilderLayout {
    TULA_BHDR_SIZE   = 64;
    TULA_BENTRY_SIZE = 168;
}

# FNV-1a-64 over the bytes a[0..alen) then b[0..blen) (ADR 0004's key hash).
fn _tula_fnv2(a, alen, b, blen): i64 {
    var h = 0xCBF29CE484222325;
    var i = 0;
    while (i < alen) {
        h = (h ^ load8(a + i)) * 0x100000001B3;
        i = i + 1;
    }
    i = 0;
    while (i < blen) {
        h = (h ^ load8(b + i)) * 0x100000001B3;
        i = i + 1;
    }
    return h;
}

# Write into the 48-byte field `dst` the key of the full name a ‖ b, which must
# be longer than 47 bytes (ADR 0004): its first TULA_NAMES_PREFIX bytes, '~',
# 16 lowercase hex digits of its FNV-1a-64, NUL. Returns dst.
fn _tula_key2(dst, a, alen, b, blen): i64 {
    var k = 0;
    while (k < TULA_NAMES_PREFIX) {
        if (k < alen) { store8(dst + k, load8(a + k)); }
        else          { store8(dst + k, load8(b + k - alen)); }
        k = k + 1;
    }
    store8(dst + TULA_NAMES_PREFIX, 126);   # '~'
    var h = _tula_fnv2(a, alen, b, blen);
    var d = 0;
    while (d < 16) {
        var nib = (h >> (60 - d * 4)) & 0xF;
        if (nib < 10) { store8(dst + TULA_NAMES_PREFIX + 1 + d, 48 + nib); }
        else          { store8(dst + TULA_NAMES_PREFIX + 1 + d, 87 + nib); }
        d = d + 1;
    }
    store8(dst + TULA_NAME_MAX, 0);
    return dst;
}

# Bytes in the names table holding `nl` long names of `nb` bytes (NULs included).
fn _tula_names_size(nl, nb): i64 {
    return TULA_NAMES_HDR + nl * TULA_NAMES_REC + nb;
}

# ---- metadata keys and values (ADR 0008) ----------------------------------

# 1 if p[0..n) is a metadata key: 1..255 bytes of ASCII letters, digits, '.',
# '_' or '-', starting with a letter.
fn _tula_meta_key_ok(p, n): i64 {
    if (n < 1) { return 0; }
    if (n > TULA_META_KEY_MAX) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        var ok = 0;
        if (c >= 97) { if (c <= 122) { ok = 1; } }      # a-z
        if (c >= 65) { if (c <= 90) { ok = 1; } }       # A-Z
        if (i > 0) {
            if (c >= 48) { if (c <= 57) { ok = 1; } }   # 0-9
            if (c == 46) { ok = 1; }                    # .
            if (c == 95) { ok = 1; }                    # _
            if (c == 45) { ok = 1; }                    # -
        }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if p[0..n) is well-formed UTF-8 with no NUL: no overlong forms, no UTF-16
# surrogates (U+D800..DFFF), nothing past U+10FFFF, no truncated sequence.
fn _tula_utf8_ok(p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c < 128) {
            if (c == 0) { return 0; }
            i = i + 1;
        } else {
            var need = 0;
            var lo = 128;                 # bounds for the first continuation byte
            var hi = 191;
            if (c < 194) { return 0; }    # a continuation byte, or overlong C0/C1
            if (c < 224) { need = 1; }
            else {
                if (c < 240) {
                    need = 2;
                    if (c == 224) { lo = 160; }   # overlong
                    if (c == 237) { hi = 159; }   # surrogates
                } else {
                    if (c > 244) { return 0; }    # past U+10FFFF
                    need = 3;
                    if (c == 240) { lo = 144; }   # overlong
                    if (c == 244) { hi = 143; }   # past U+10FFFF
                }
            }
            if (i + need >= n) { return 0; }   # truncated: the last byte is past the end
            var b1 = load8(p + i + 1);
            if (b1 < lo) { return 0; }
            if (b1 > hi) { return 0; }
            var k = 2;
            while (k <= need) {
                var bk = load8(p + i + k);
                if ((bk & 192) != 128) { return 0; }
                k = k + 1;
            }
            i = i + need + 1;
        }
    }
    return 1;
}

# Byte order of a[0..an) and b[0..bn): -1 / 0 / +1 (a prefix sorts first).
fn _tula_bytes_cmp(a, an, b, bn): i64 {
    var n = an;
    if (bn < n) { n = bn; }
    var i = 0;
    while (i < n) {
        var x = load8(a + i);
        var y = load8(b + i);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        i = i + 1;
    }
    if (an < bn) { return 0 - 1; }
    if (an > bn) { return 1; }
    return 0;
}

# Allocate an empty builder (room for TULA_BUILDER_MAX tensors). 0 if the
# allocation fails.
fn tula_builder_new(): i64 {
    return tula_builder_new_cap(TULA_BUILDER_MAX);
}

# Allocate an empty builder with room for `max` tensors (1.2.0). Real checkpoints
# pass TULA_BUILDER_MAX (Llama-2-7B has 291 tensors). Returns 0 if max is outside
# [1, TULA_READ_MAX_TENSORS] — a file can't hold more than the reader accepts — or
# if the allocation fails.
fn tula_builder_new_cap(max): i64 {
    if (max < 1) { return 0; }
    if (max > TULA_READ_MAX_TENSORS) { return 0; }
    var b = alloc(TULA_BHDR_SIZE + max * TULA_BENTRY_SIZE);
    if (b == 0) { return 0; }
    var slots = 2;
    while (slots < max * 2) { slots = slots * 2; }
    var tab = alloc(slots * 8);
    if (tab == 0) { return 0; }
    _tula_zero(tab, slots * 8);
    store64(b + 0, 0);           # count
    store64(b + 8, 0);           # payload_total
    store64(b + 16, max);        # cap
    store64(b + 24, tab);        # name index
    store64(b + 32, slots - 1);  # index mask
    store64(b + 40, 0);          # long names held
    store64(b + 48, 0);          # their bytes
    store64(b + 56, 0);          # metadata (none yet)
    return b;
}

# Pointer to builder entry i.
fn _tula_bentry(b, i): i64 {
    return b + TULA_BHDR_SIZE + i * TULA_BENTRY_SIZE;
}

# Hash of a 48-byte name field: six rounds of (h ^ word) * prime, then
# h ^ (h >> 31), one per word (unrolled in 1.9.0; the same value).
fn _tula_name_hash(k): i64 {
    var h = (0x6A09E667F3BCC908 ^ load64(k)) * 0x100000001B3;
    h = h ^ (h >> 31);
    h = (h ^ load64(k + 8)) * 0x100000001B3;
    h = h ^ (h >> 31);
    h = (h ^ load64(k + 16)) * 0x100000001B3;
    h = h ^ (h >> 31);
    h = (h ^ load64(k + 24)) * 0x100000001B3;
    h = h ^ (h >> 31);
    h = (h ^ load64(k + 32)) * 0x100000001B3;
    h = h ^ (h >> 31);
    h = (h ^ load64(k + 40)) * 0x100000001B3;
    return h ^ (h >> 31);
}

# 1 if two 48-byte name fields are identical.
fn _tula_name_eq(a, b): i64 {
    var w = 0;
    while (w < 6) {
        if (load64(a + w * 8) != load64(b + w * 8)) { return 0; }
        w = w + 1;
    }
    return 1;
}

# The index slot holding name field `k`, or the empty slot where it belongs.
fn _tula_bidx_slot(b, k): i64 {
    var tab = load64(b + 24);
    var mask = load64(b + 32);
    var s = _tula_name_hash(k) & mask;
    loop {
        var v = load64(tab + s * 8);
        if (v == 0) { return s; }
        if (_tula_name_eq(_tula_bentry(b, v - 1), k) == 1) { return s; }
        s = (s + 1) & mask;
    }
    return 0;
}

# The shared add. `mode` 0 = plain, 1 = checked (also refuses a name over 47
# chars and a name the builder already holds), 2 = long (as checked, but a name
# over 47 chars goes to the names table under its key). On any error the
# builder is unchanged.
fn _tula_builder_add(b, name, dtype, shape, ndim, data, data_len, mode): i64 {
    var c = load64(b);
    if (c >= load64(b + 16))   { return TULA_ERR_TOO_MANY; }
    if (load64(b + 56) != 0) {
        if (_tula_builder_has_shards(b) == 1) { return TULA_ERR_SHARDS; }   # a manifest holds no tensors (1.11.0)
    }
    if (ndim < 0)              { return TULA_ERR_NDIM; }
    if (ndim > TULA_MAXDIM)    { return TULA_ERR_NDIM; }
    if (data_len < 0)          { return TULA_ERR_BOUNDS; }
    # data_len <= cap first, so the sums below cannot overflow.
    if (data_len > TULA_READ_MAX_BYTES) { return TULA_ERR_TOO_BIG; }
    var nlen = 0;
    if (mode >= 1) { nlen = strlen(name); }
    if (nlen > TULA_READ_MAX_BYTES) { return TULA_ERR_TOO_BIG; }
    if (mode == 1) {
        if (nlen > TULA_NAME_MAX) { return TULA_ERR_NAME_LONG; }
    }
    var is_long = 0;
    if (mode == 2) {
        if (nlen > TULA_NAME_MAX) { is_long = 1; }
    }
    var nl = load64(b + 40);
    var nb = load64(b + 48);
    # With long names the file gets one more tensor, the names table, after
    # every other; with metadata another, the metadata table. Each needs a
    # manifest slot and room under the size cap.
    var resv = 0;
    var tbl = 0;
    if (nl + is_long > 0) {
        resv = 1;
        tbl = _tula_names_size(nl + is_long, nb);
        if (is_long == 1) { tbl = tbl + nlen + 1; }
    }
    var msize = _tula_meta_size(b);
    if (msize > 0) { resv = resv + 1; }
    if (c + 1 + resv > TULA_READ_MAX_TENSORS) { return TULA_ERR_TOO_MANY; }
    var cur = load64(b + 8);
    var grown = cur + tula_align8(data_len);
    if (grown + tula_align8(tbl) + tula_align8(msize) > TULA_READ_MAX_BYTES) { return TULA_ERR_TOO_BIG; }
    # Stage the entry in slot c (not yet counted), then look its name up.
    var m = _tula_bentry(b, c);
    if (is_long == 1) { _tula_key2(m, name, nlen, "", 0); }
    else {
        if (mode >= 1) {               # nlen is known and <= 47: no second scan
            _tula_zero48(m);
            _tula_copy(m, name, nlen);
        } else {
            tula_name_write(m, name);
        }
    }
    if (mode >= 1) {
        # The table's own name: refused by the long add always, and by the
        # checked add once a long name is held (the table will take it). The
        # first-byte test keeps the string compare off the common path.
        if (load8(m) == 95) {
            if (streq(m, "__tula.names__")) {
                if (mode == 2) { return TULA_ERR_DUP_NAME; }
                if (nl > 0)    { return TULA_ERR_DUP_NAME; }
            }
            if (streq(m, "__tula.meta__")) {       # the metadata table's (1.6.0)
                if (mode == 2) { return TULA_ERR_DUP_NAME; }
                if (msize > 0) { return TULA_ERR_DUP_NAME; }
            }
        }
    }
    if (is_long == 1) {
        if (nl == 0) {
            # The first long name needs the table's name free.
            var rk[48];
            tula_name_write(&rk, "__tula.names__");
            var rs = _tula_bidx_slot(b, &rk);
            if (load64(load64(b + 24) + rs * 8) != 0) { return TULA_ERR_DUP_NAME; }
        }
    }
    var s = _tula_bidx_slot(b, m);
    var tab = load64(b + 24);
    var seen = load64(tab + s * 8);
    if (mode >= 1) {
        if (seen != 0) { return TULA_ERR_DUP_NAME; }
    }
    var fp = 0;
    if (is_long == 1) {
        fp = alloc(nlen + 1);
        if (fp == 0) { return TULA_ERR_OOM; }
        _tula_copy(fp, name, nlen);
        store8(fp + nlen, 0);
    }
    store64(m + 48, dtype);
    store64(m + 56, ndim);
    var k = 0;
    while (k < TULA_MAXDIM) {
        if (k < ndim) { store64(m + 64 + k * 8, load64(shape + k * 8)); }
        else          { store64(m + 64 + k * 8, 0); }
        k = k + 1;
    }
    store64(m + 128, cur);        # data_off
    store64(m + 136, data_len);
    store64(m + 144, data);
    store64(m + 152, fp);
    if (is_long == 1) {
        store64(m + 160, nlen);
        store64(b + 40, nl + 1);
        store64(b + 48, nb + nlen + 1);
    } else {
        store64(m + 160, 0);
    }
    if (seen == 0) { store64(tab + s * 8, c + 1); }
    store64(b, c + 1);
    store64(b + 8, grown);
    return 0;
}

# Append a tensor. Returns 0 on success, or (builder unchanged):
#   TULA_ERR_TOO_MANY — the builder's cap (TULA_BUILDER_MAX by default) reached;
#   TULA_ERR_NDIM     — ndim outside [0, TULA_MAXDIM];
#   TULA_ERR_BOUNDS   — data_len < 0;
#   TULA_ERR_TOO_BIG  — the payload would pass TULA_READ_MAX_BYTES;
#   TULA_ERR_SHARDS   — (1.11.0) the builder is a shard-set manifest
#                       (tula_builder_set_shards), which holds no tensors.
# Names over 47 chars are truncated and duplicates are allowed (frozen v1
# behaviour; two long names can become one stored name, see SECURITY.md) — use
# tula_builder_add_checked to refuse both.
fn tula_builder_add(b, name, dtype, shape, ndim, data, data_len): i64 {
    return _tula_builder_add(b, name, dtype, shape, ndim, data, data_len, 0);
}

# Append a tensor, refusing what tula_builder_add would silently accept (1.2.0):
# every tula_builder_add error, plus (builder unchanged)
#   TULA_ERR_NAME_LONG — the name is over 47 chars (it would be truncated);
#   TULA_ERR_DUP_NAME  — the builder already holds this stored name, from either
#                        kind of add (an earlier plain add's truncated name too).
# A builder fed only through this produces files tula_validate_strict accepts,
# provided each data_len is the dtype's packed length for the shape, (1.7.0)
# each BOOL payload holds only 0 and 1 bytes, and (1.8.0) an INT4 tensor of odd
# length leaves its last high nibble zero. Payloads are never read here.
fn tula_builder_add_checked(b, name, dtype, shape, ndim, data, data_len): i64 {
    return _tula_builder_add(b, name, dtype, shape, ndim, data, data_len, 1);
}

# Append a tensor whose name may be any length (1.3.0, ADR 0004). A name of 47
# chars or fewer is added exactly as tula_builder_add_checked adds it. A longer
# name is stored whole in the file's names table — the reserved
# "__tula.names__" tensor, which finish appends after every other tensor — and
# its entry holds the name's 47-byte key. Read it back with tula_find_name /
# tula_entry_full_name. Errors (builder unchanged): every
# tula_builder_add_checked error except TULA_ERR_NAME_LONG, and
#   TULA_ERR_DUP_NAME — the stored name (or key) is already held; the name is
#                       "__tula.names__"; or this is the first long name and
#                       the builder already holds a tensor of that name;
#   TULA_ERR_OOM      — the long name's copy could not be allocated.
# Two different long names refuse each other only if they share their first 30
# bytes AND their 64-bit hash: loud, never a silent collision.
fn tula_builder_add_long(b, name, dtype, shape, ndim, data, data_len): i64 {
    return _tula_builder_add(b, name, dtype, shape, ndim, data, data_len, 2);
}

# The file layout a builder serializes to (shared by tula_serialize and the
# streaming writer, so both produce the same bytes). Entries: the tensors, then
# the metadata table (if any), then the names table (if any) — always last, as
# 1.3–1.5 readers expect. Fills `lay` (12 words):
#   +0 count_out   +8 payload_off   +16 payload_len
#   +24 content_len (= sig_off when signed)   +32 sig_off   +40 sig_len
#   +48 names table bytes (0 = none)   +56 tensors' payload bytes
#   +64 metadata table bytes (0 = none)   +72 its payload offset
#   +80 the names table's payload offset
fn _tula_layout(b, sig_len, lay): i64 {
    var count = load64(b);
    var nl = load64(b + 40);
    var tsize = 0;
    var count_out = count;
    var msize = _tula_meta_size(b);
    if (msize > 0) { count_out = count_out + 1; }
    if (nl > 0) {
        tsize = _tula_names_size(nl, load64(b + 48));
        count_out = count_out + 1;
    }
    var payload_off = TULA_HEADER_SIZE + count_out * TULA_ENTRY_SIZE;
    var payload_user = load64(b + 8);
    var names_off = payload_user + tula_align8(msize);
    var payload_len = names_off + tula_align8(tsize);
    var content_len = payload_off + payload_len;
    var sig_off = 0;
    if (sig_len > 0) { sig_off = content_len; }
    store64(lay + 0, count_out);
    store64(lay + 8, payload_off);
    store64(lay + 16, payload_len);
    store64(lay + 24, content_len);
    store64(lay + 32, sig_off);
    store64(lay + 40, sig_len);
    store64(lay + 48, tsize);
    store64(lay + 56, payload_user);
    store64(lay + 64, msize);
    store64(lay + 72, payload_user);
    store64(lay + 80, names_off);
    return 0;
}

# The 64-byte header for layout `lay`, at h.
fn _tula_header_write(h, lay): i64 {
    store64(h + 0, TULA_MAGIC);
    store64(h + 8, TULA_VERSION);
    store64(h + 16, load64(lay + 0));
    store64(h + 24, TULA_HEADER_SIZE);
    store64(h + 32, load64(lay + 8));
    store64(h + 40, load64(lay + 16));
    store64(h + 48, load64(lay + 32));   # 0 = unsigned; else offset of the sig block
    store64(h + 56, load64(lay + 40));   # 0 = unsigned; else 64 (Ed25519)
    return 0;
}

# The names table's manifest entry (ADR 0004) at e: its payload is tsize bytes at
# payload offset `off`.
fn _tula_names_entry_write(e, off, tsize): i64 {
    _tula_zero(e, TULA_ENTRY_SIZE);
    tula_name_write(e, "__tula.names__");
    store64(e + 48, TULA_DT_INT8);
    store64(e + 56, 1);
    store64(e + 64, tsize);
    store64(e + 128, off);
    store64(e + 136, tsize);
    return 0;
}

# ---- metadata (1.6.0, ADR 0008) -------------------------------------------

# Bytes the metadata table will take (0 = the builder holds none).
fn _tula_meta_size(b): i64 {
    var mt = load64(b + 56);
    if (mt == 0) { return 0; }
    var np = load64(mt);
    if (np == 0) { return 0; }
    return TULA_META_HDR + np * TULA_META_REC + load64(mt + 24);
}

# Set (or replace) a metadata pair (1.6.0, ADR 0008). `key`: 1–255 bytes of ASCII
# letters, digits, '.', '_' or '-', starting with a letter — `<namespace>.<name>`
# by convention; keys starting "tula." are reserved for tula and refused.
# `value`: UTF-8 text (no NUL), at most 16 MiB. Both are copied. The table is
# written at finish (or by the streaming writers) in key order, so the same
# pairs give the same bytes whatever order they were set in. Returns 0, or
# (builder unchanged):
#   TULA_ERR_META     — a bad key, a bad or oversized value, past 4,096 pairs
#                       or 64 MiB of table;
#   TULA_ERR_DUP_NAME — the first pair, and the builder already holds a tensor
#                       named "__tula.meta__";
#   TULA_ERR_TOO_MANY — no manifest slot left for the table;
#   TULA_ERR_TOO_BIG  — the file would pass TULA_READ_MAX_BYTES;
#   TULA_ERR_OOM      — a copy could not be allocated.
fn tula_builder_set_meta(b, key, value): i64 {
    var klen = strlen(key);
    if (_tula_meta_key_ok(key, klen) == 0) { return TULA_ERR_META; }
    if (klen >= 5) {
        if (_tula_bytes_cmp(key, 5, "tula.", 5) == 0) { return TULA_ERR_META; }
    }
    var vlen = strlen(value);
    if (vlen > TULA_META_VALUE_MAX) { return TULA_ERR_META; }
    if (_tula_utf8_ok(value, vlen) == 0) { return TULA_ERR_META; }
    return _tula_builder_put_meta(b, key, klen, value, vlen);
}

# Index of `key` among the builder's metadata pairs, or -1 (1.11.0).
fn _tula_builder_meta_find(b, key, klen): i64 {
    var mt = load64(b + 56);
    if (mt == 0) { return 0 - 1; }
    var arr = load64(mt + 16);
    var lo = 0;
    var hi = load64(mt);
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        var c = _tula_bytes_cmp(load64(arr + mid * 32), load64(arr + mid * 32 + 8), key, klen);
        if (c == 0) { return mid; }
        if (c < 0) { lo = mid + 1; }
        else { hi = mid; }
    }
    return 0 - 1;
}

# 1 if the builder is a shard-set manifest: it holds `tula.shards` (1.11.0).
fn _tula_builder_has_shards(b): i64 {
    if (_tula_builder_meta_find(b, "tula.shards", 11) >= 0) { return 1; }
    return 0;
}

# Set (or replace) a metadata pair whose key and value are already checked:
# tula_builder_set_meta's checks passed, or tula itself sets a reserved key
# (1.11.0: tula.shards). The builder is unchanged on error.
fn _tula_builder_put_meta(b, key, klen, value, vlen): i64 {
    var mt = load64(b + 56);
    var np = 0;
    var bytes = 0;
    var arr = 0;
    if (mt != 0) {
        np = load64(mt);
        arr = load64(mt + 16);
        bytes = load64(mt + 24);
    }
    # where the key is, or belongs (binary search over the sorted pairs)
    var lo = 0;
    var hi = np;
    var found = 0 - 1;
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        var rec = arr + mid * 32;
        var c = _tula_bytes_cmp(load64(rec), load64(rec + 8), key, klen);
        if (c == 0) {
            found = mid;
            lo = hi;
        } else {
            if (c < 0) { lo = mid + 1; }
            else { hi = mid; }
        }
    }
    var np2 = np;
    var bytes2 = bytes;
    if (found >= 0) {
        bytes2 = bytes - load64(arr + found * 32 + 24) + vlen;
    } else {
        np2 = np + 1;
        bytes2 = bytes + klen + 1 + vlen + 1;
    }
    if (np2 > TULA_META_MAX_PAIRS) { return TULA_ERR_META; }
    var msize2 = TULA_META_HDR + np2 * TULA_META_REC + bytes2;
    if (msize2 > TULA_META_MAX_BYTES) { return TULA_ERR_META; }
    var nl = load64(b + 40);
    var tbl = 0;
    if (nl > 0) { tbl = _tula_names_size(nl, load64(b + 48)); }
    if (np == 0) {
        var resv = 1;
        if (nl > 0) { resv = 2; }
        if (load64(b) + resv > TULA_READ_MAX_TENSORS) { return TULA_ERR_TOO_MANY; }
        # the first pair needs the table's name free
        var rk[48];
        tula_name_write(&rk, "__tula.meta__");
        var rs = _tula_bidx_slot(b, &rk);
        if (load64(load64(b + 24) + rs * 8) != 0) { return TULA_ERR_DUP_NAME; }
    }
    if (load64(b + 8) + tula_align8(tbl) + tula_align8(msize2) > TULA_READ_MAX_BYTES) { return TULA_ERR_TOO_BIG; }
    var vc = alloc(vlen + 1);
    if (vc == 0) { return TULA_ERR_OOM; }
    _tula_copy(vc, value, vlen);
    store8(vc + vlen, 0);
    if (found >= 0) {
        store64(arr + found * 32 + 16, vc);
        store64(arr + found * 32 + 24, vlen);
        store64(mt + 24, bytes2);
        return 0;
    }
    var kc = alloc(klen + 1);
    if (kc == 0) { return TULA_ERR_OOM; }
    _tula_copy(kc, key, klen);
    store8(kc + klen, 0);
    if (mt == 0) {
        mt = alloc(32);
        if (mt == 0) { return TULA_ERR_OOM; }
        arr = alloc(8 * 32);
        if (arr == 0) { return TULA_ERR_OOM; }
        store64(mt, 0);
        store64(mt + 8, 8);
        store64(mt + 16, arr);
        store64(mt + 24, 0);
        store64(b + 56, mt);
    }
    if (np + 1 > load64(mt + 8)) {
        var cap2 = load64(mt + 8) * 2;
        var arr2 = alloc(cap2 * 32);
        if (arr2 == 0) { return TULA_ERR_OOM; }
        _tula_copy(arr2, arr, np * 32);
        arr = arr2;
        store64(mt + 8, cap2);
        store64(mt + 16, arr);
    }
    var at = lo;   # the insertion point
    var q = np;
    while (q > at) {
        _tula_copy(arr + q * 32, arr + (q - 1) * 32, 32);
        q = q - 1;
    }
    store64(arr + at * 32, kc);
    store64(arr + at * 32 + 8, klen);
    store64(arr + at * 32 + 16, vc);
    store64(arr + at * 32 + 24, vlen);
    store64(mt, np + 1);
    store64(mt + 24, bytes2);
    return 0;
}

# The metadata table's manifest entry (ADR 0008) at e: msize bytes at payload
# offset `off`.
fn _tula_meta_entry_write(e, off, msize): i64 {
    _tula_zero(e, TULA_ENTRY_SIZE);
    tula_name_write(e, "__tula.meta__");
    store64(e + 48, TULA_DT_INT8);
    store64(e + 56, 1);
    store64(e + 64, msize);
    store64(e + 128, off);
    store64(e + 136, msize);
    return 0;
}

# The metadata table's payload at t (msize bytes), from the builder's sorted
# pairs, then its zero padding.
fn _tula_write_meta(b, t, msize): i64 {
    var mt = load64(b + 56);
    var np = load64(mt);
    var arr = load64(mt + 16);
    store64(t, TULA_META_MAGIC);
    store64(t + 8, np);
    var cur = TULA_META_HDR + np * TULA_META_REC;
    var q = 0;
    while (q < np) {
        var src = arr + q * 32;
        var rec = t + TULA_META_HDR + q * TULA_META_REC;
        var kl = load64(src + 8);
        var vl = load64(src + 24);
        store64(rec, cur);
        store64(rec + 8, kl);
        _tula_copy(t + cur, load64(src), kl);
        store8(t + cur + kl, 0);
        cur = cur + kl + 1;
        store64(rec + 16, cur);
        store64(rec + 24, vl);
        _tula_copy(t + cur, load64(src + 16), vl);
        store8(t + cur + vl, 0);
        cur = cur + vl + 1;
        q = q + 1;
    }
    _tula_zero(t + msize, tula_align8(msize) - msize);
    return 0;
}

# Serialize the builder into a fresh contiguous tula buffer. sig_len is 0 for an
# unsigned file, or 64 to reserve an appended Ed25519 signature block (filled by
# src/sign.cyr — this writes the LAYOUT, not the signature). Returns the buf ptr,
# or 0 if the allocation fails. Every byte is written — the alignment padding
# after each tensor and the reserved signature block are zeroed — so the output
# is a pure function of the builder's inputs, whatever the allocator hands back.
# A builder holding long names (tula_builder_add_long) gets the names table
# appended as the last tensor (ADR 0004). The whole file is one allocation, so
# the stdlib's 2 GiB per-allocation cap bounds it; tula_builder_write_file
# streams the same bytes to disk with no such bound (ADR 0006).
fn tula_serialize(b, sig_len): i64 {
    var lay[96];
    _tula_layout(b, sig_len, &lay);
    var payload_off = load64(&lay + 8);
    var content_len = load64(&lay + 24);
    var tsize = load64(&lay + 48);
    var buf = alloc(content_len + sig_len);
    if (buf == 0) { return 0; }
    _tula_header_write(buf, &lay);
    var count = load64(b);
    var i = 0;
    while (i < count) {
        var m = _tula_bentry(b, i);
        var e = buf + TULA_HEADER_SIZE + i * TULA_ENTRY_SIZE;
        _tula_copy(e, m, TULA_ENTRY_SIZE);     # the entry image built at add time
        var dlen = load64(m + 136);
        var dst = buf + payload_off + load64(m + 128);
        _tula_copy(dst, load64(m + 144), dlen);
        var padded = tula_align8(dlen);
        _tula_zero(dst + dlen, padded - dlen);   # 0..7 padding bytes
        i = i + 1;
    }
    var ei = count;
    var msize = load64(&lay + 64);
    if (msize > 0) {
        var moff = load64(&lay + 72);
        _tula_meta_entry_write(buf + TULA_HEADER_SIZE + ei * TULA_ENTRY_SIZE, moff, msize);
        _tula_write_meta(b, buf + payload_off + moff, msize);
        ei = ei + 1;
    }
    if (tsize > 0) {
        var off = load64(&lay + 80);
        _tula_names_entry_write(buf + TULA_HEADER_SIZE + ei * TULA_ENTRY_SIZE, off, tsize);
        _tula_write_names(b, buf + payload_off + off, tsize);
    }
    if (sig_len > 0) { _tula_zero(buf + content_len, sig_len); }
    return buf;
}

# The names table's payload (ADR 0004) at t, tsize bytes, from the builder's long
# names in entry order, then its zero padding.
fn _tula_write_names(b, t, tsize): i64 {
    var nl = load64(b + 40);
    store64(t, TULA_NAMES_MAGIC);
    store64(t + 8, nl);
    var rec = t + TULA_NAMES_HDR;
    var noff = TULA_NAMES_HDR + nl * TULA_NAMES_REC;
    var count = load64(b);
    var i = 0;
    while (i < count) {
        var m = _tula_bentry(b, i);
        var fp = load64(m + 152);
        if (fp != 0) {
            var len = load64(m + 160);
            store64(rec, i);
            store64(rec + 8, noff);
            store64(rec + 16, len);
            _tula_copy(t + noff, fp, len);
            store8(t + noff + len, 0);
            noff = noff + len + 1;
            rec = rec + TULA_NAMES_REC;
        }
        i = i + 1;
    }
    _tula_zero(t + tsize, tula_align8(tsize) - tsize);
    return 0;
}

# Serialize an UNSIGNED buffer. (Signed variant: tula_builder_finish_signed in
# src/sign.cyr, which reserves sig_len=64 then fills it with an Ed25519 sig.)
fn tula_builder_finish(b): i64 {
    return tula_serialize(b, 0);
}

# Total serialized length of a finished/opened buffer (incl. any signature).
fn tula_total_len(buf): i64 {
    return load64(buf + 32) + load64(buf + 40) + load64(buf + 56);   # payload_off + payload_len + sig_len
}

# Total length implied by a 64-byte HEADER read from an untrusted file, with the
# resource cap applied so the file readers can sanity-check BEFORE allocating or
# mmap'ing. Returns -1 if any size field is negative or exceeds the cap (so the
# sum can never overflow); the caller rejects total < HEADER_SIZE or > cap. Full
# structural validation still runs later in tula_open.
fn tula_hdr_total(hdr): i64 {
    var po = load64(hdr + 32);
    var pl = load64(hdr + 40);
    var sl = load64(hdr + 56);
    if (po < 0) { return 0 - 1; }
    if (pl < 0) { return 0 - 1; }
    if (sl < 0) { return 0 - 1; }
    if (po > TULA_READ_MAX_BYTES) { return 0 - 1; }
    if (pl > TULA_READ_MAX_BYTES) { return 0 - 1; }
    if (sl > TULA_READ_MAX_BYTES) { return 0 - 1; }
    return po + pl + sl;
}

# ---------------------------------------------------------------------------
# reader — validate + accessors over a tula buffer
# ---------------------------------------------------------------------------

# Fully validate a buffer of `len` bytes against the format invariants — the
# untrusted-input trust gate (M3). tula loads FOREIGN checkpoints, so a lying or
# truncated file must be rejected, never OOB-deref'd. Returns TULA_OK (0) if the
# buffer is a structurally-sound tula file, else a TULA_ERR_* code. All arithmetic
# is overflow-safe given the resource caps. Does NOT verify the signature
# (authenticity is tula_verify(r, pk)); this validates STRUCTURE only.
fn tula_validate(buf, len): i64 {
    if (len < TULA_HEADER_SIZE)          { return TULA_ERR_TRUNCATED; }
    if (load64(buf + 0) != TULA_MAGIC)   { return TULA_ERR_MAGIC; }
    if (load64(buf + 8) != TULA_VERSION) { return TULA_ERR_VERSION; }

    var count = load64(buf + 16);
    if (count < 0)                       { return TULA_ERR_TOO_MANY; }
    if (count > TULA_READ_MAX_TENSORS)   { return TULA_ERR_TOO_MANY; }

    var manifest_off = load64(buf + 24);
    if (manifest_off != TULA_HEADER_SIZE) { return TULA_ERR_HEADER; }

    # count <= 2^20, so count*ENTRY_SIZE (144) < 2^28 — no overflow.
    var manifest_len = count * TULA_ENTRY_SIZE;
    var payload_off = load64(buf + 32);
    if (payload_off != manifest_off + manifest_len) { return TULA_ERR_HEADER; }
    if (payload_off > len)               { return TULA_ERR_TRUNCATED; }

    var payload_len = load64(buf + 40);
    if (payload_len < 0)                 { return TULA_ERR_BOUNDS; }
    if (payload_len > TULA_READ_MAX_BYTES) { return TULA_ERR_TOO_BIG; }
    # payload_off + payload_len <= len, written to avoid overflow (payload_off <= len).
    if (payload_len > len - payload_off) { return TULA_ERR_TRUNCATED; }

    # content_len <= len (payload fits), so it is a safe upper bound for sig_off.
    var content_len = payload_off + payload_len;
    var sig_off = load64(buf + 48);
    var sig_len = load64(buf + 56);
    if (sig_len < 0)                     { return TULA_ERR_BOUNDS; }
    if (sig_len == 0) {
        if (sig_off != 0)                { return TULA_ERR_HEADER; }
    } else {
        # Only Ed25519 (exactly 64 bytes) is defined — pin it so tula_verify's
        # fixed 64-byte read can never escape the buffer.
        if (sig_len != 64)              { return TULA_ERR_HEADER; }
        if (sig_off != content_len)      { return TULA_ERR_HEADER; }
        if (sig_len > len - sig_off)     { return TULA_ERR_TRUNCATED; }
    }

    # Per-entry: entries live in [manifest_off, payload_off) which is <= len, so
    # reading each 144-byte entry's fields is always in-bounds. We validate the
    # PAYLOAD offsets the entry points at.
    var i = 0;
    while (i < count) {
        var e = manifest_off + i * TULA_ENTRY_SIZE;
        var ndim = load64(buf + e + 56);
        if (ndim < 0)                    { return TULA_ERR_NDIM; }
        if (ndim > TULA_MAXDIM)          { return TULA_ERR_NDIM; }
        # name must be NUL-terminated within its 48-byte field: some byte of its
        # six words is zero (1.9.0: a word at a time).
        var nw = buf + e;
        var term = 0;
        var k = 0;
        while (k < TULA_NAME_CAP) {
            if (_tula_has_zero(load64(nw + k)) == 1) { term = 1; k = TULA_NAME_CAP; }
            else { k = k + 8; }
        }
        if (term == 0)                   { return TULA_ERR_NAME_LONG; }
        # data_off + data_len must lie within the payload (overflow-safe).
        var doff = load64(buf + e + 128);
        var dlen = load64(buf + e + 136);
        if (doff < 0)                    { return TULA_ERR_BOUNDS; }
        if (dlen < 0)                    { return TULA_ERR_BOUNDS; }
        if (doff > payload_len)          { return TULA_ERR_BOUNDS; }
        if (dlen > payload_len - doff)   { return TULA_ERR_BOUNDS; }
        i = i + 1;
    }
    return TULA_OK;
}

# Open a buffer as a reader handle: full structural validation (tula_validate),
# then return the buffer or 0 on any breach. The reader accessors assume a
# validated buffer, so untrusted input MUST come through here (or tula_validate).
fn tula_open(buf, len): i64 {
    if (tula_validate(buf, len) != TULA_OK) { return 0; }
    return buf;
}

# Tensor count of an opened buffer.
fn tula_count(r): i64          { return load64(r + 16); }
# On-disk format version of an opened buffer (TULA_VERSION for v1).
fn tula_format_version(r): i64 { return load64(r + 8); }

# Pointer to manifest entry i.
fn tula_entry(r, i): i64 {
    return r + load64(r + 24) + i * TULA_ENTRY_SIZE;
}

# Entry name: a NUL-terminated cstring in place (at most 47 chars).
fn tula_entry_name(e): i64     { return e; }
# Entry dtype (a TULA_DT_* value; unknown values are carried through).
fn tula_entry_dtype(e): i64    { return load64(e + 48); }
# Entry rank, 0..TULA_MAXDIM.
fn tula_entry_ndim(e): i64     { return load64(e + 56); }
# Entry dimension k (0 <= k < ndim). Values are the file's: unvalidated.
fn tula_entry_dim(e, k): i64   { return load64(e + 64 + k * 8); }
# Entry payload length in bytes.
fn tula_entry_data_len(e): i64 { return load64(e + 136); }

# Pointer to the tensor's payload bytes.
fn tula_entry_data(r, e): i64 {
    return r + load64(r + 32) + load64(e + 128);   # payload_off + data_off
}

# Find an entry by name; returns the entry ptr or 0 (the first match).
#
# Same answer as streq over every entry, faster. streq ran strlen on both
# strings for EVERY entry; here the query is measured once and, since a stored
# name is at most TULA_NAME_MAX bytes, a longer query returns 0 up front (it
# could never have matched). The query is copied into a zero-padded 48-byte
# word buffer and each entry's name field is compared a 64-bit word at a time
# over bytes [0, qlen] — the query's bytes plus the entry's terminating NUL.
# Bytes after the entry's NUL are never compared, and no read leaves the
# 48-byte field.
fn tula_find(r, name): i64 {
    var qlen = 0;
    while (qlen <= TULA_NAME_MAX) {
        if (load8(name + qlen) == 0) { break; }
        qlen = qlen + 1;
    }
    if (qlen > TULA_NAME_MAX) { return 0; }

    var q[48];
    var w = 0;
    while (w < 6) { store64(&q + w * 8, 0); w = w + 1; }
    var j = 0;
    while (j < qlen) { store8(&q + j, load8(name + j)); j = j + 1; }

    var cmp = qlen + 1;                 # bytes that must match, incl. the NUL
    var nfull = cmp / 8;                # whole words
    var rem = cmp % 8;                  # bytes in the last, partial word
    var mask = 0;
    var qtail = 0;
    if (rem > 0) {
        mask = (1 << (rem * 8)) - 1;
        qtail = load64(&q + nfull * 8) & mask;   # nfull <= 5 here: inside q
    }

    var c = tula_count(r);
    var e = r + load64(r + 24);
    var i = 0;
    while (i < c) {
        var k = 0;
        while (k < nfull) {
            if (load64(e + k * 8) != load64(&q + k * 8)) { break; }
            k = k + 1;
        }
        if (k == nfull) {
            if (rem == 0) { return e; }
            if ((load64(e + nfull * 8) & mask) == qtail) { return e; }
        }
        e = e + TULA_ENTRY_SIZE;
        i = i + 1;
    }
    return 0;
}

# Signature presence of an opened buffer: 0 = unsigned, else the signature length
# in bytes (64 for Ed25519). This is a PRESENCE check only — cryptographic
# verification is tula_verify(r, pk) in src/sign.cyr.
fn tula_is_signed(r): i64 {
    return load64(r + 56);
}
