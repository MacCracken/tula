# @public — tula file I/O (M1): write a serialized buffer to disk, read it back
# (heap copy) or mmap it (zero-copy). Uses stdlib io + mmap; portable.
#
# tula files are self-describing — the 64-byte header carries the total length
# (payload_off + payload_len + sig_len). Both readers check that length against
# the file's real size (lseek to the end, so no stat()) BEFORE they allocate or
# map anything: a header that claims more than the file holds is rejected, so a
# 64-byte file can no longer reserve gigabytes of address space (heap), and a
# truncated file can no longer be mapped past its end, where the first touch of
# the missing tail raised SIGBUS (mmap).

# Read up to len bytes from fd, looping over short reads. Returns the bytes read
# (fewer than len only at end of file) or a negative errno. Each request is at
# most 1 GiB (1.6.1): macOS refuses a read of more than INT_MAX bytes outright
# (EINVAL), where Linux caps it and returns short.
fn _tula_read_full(fd, buf, len): i64 {
    var got = 0;
    while (got < len) {
        var want = len - got;
        if (want > 1073741824) { want = 1073741824; }
        var n = file_read(fd, buf + got, want);
        if (n < 0) { return n; }
        if (n == 0) { return got; }
        got = got + n;
    }
    return got;
}

# Write all n bytes at p to fd, looping over short writes. 0 or a negative errno;
# a write that makes no progress is -EIO. Each request is at most 1 GiB (1.6.1),
# as in _tula_read_full: macOS refuses a write of more than INT_MAX bytes, so a
# single tensor over 2 GiB would otherwise fail there. Every write tula makes goes
# through here (1.6.2: tula_write_file and tula_write_file_atomic too).
fn _tula_write_full(fd, p, n): i64 {
    var off = 0;
    while (off < n) {
        var want = n - off;
        if (want > 1073741824) { want = 1073741824; }
        var w = file_write(fd, p + off, want);
        if (w < 0) { return w; }
        if (w == 0) { return 0 - 5; }
        off = off + w;
    }
    return 0;
}

# The shared front half of both readers. Reads the header of an open fd and
# returns the total length it declares, or -1 to reject: short header, bad magic,
# a size field negative or over the cap, or a total larger than the file (or a
# file that cannot be sized — a pipe). Leaves the fd offset unspecified.
fn _tula_fd_total(fd): i64 {
    var hdr[64];
    if (_tula_read_full(fd, &hdr, TULA_HEADER_SIZE) != TULA_HEADER_SIZE) { return 0 - 1; }
    if (load64(&hdr + 0) != TULA_MAGIC) { return 0 - 1; }
    var total = tula_hdr_total(&hdr);
    if (total < TULA_HEADER_SIZE) { return 0 - 1; }
    if (total > TULA_READ_MAX_BYTES) { return 0 - 1; }
    var fsz = xlseek(fd, 0, 2);   # SEEK_END: the file's real size
    if (fsz < 0) { return 0 - 1; }
    if (total > fsz) { return 0 - 1; }
    return total;
}

# Write a serialized tula buffer to `path` (create/truncate; a new file is 0644
# before the umask). Returns bytes written (== len on success) or a negative io
# error. Not crash-safe: a failure part-way leaves a truncated file, which both
# readers then reject. For a write that never destroys the previous file, use
# tula_write_file_atomic. 1.6.2: through tula's own write loop, so a buffer over
# INT_MAX bytes works on macOS too (the stdlib's file_write_all asks for it in one
# request, which macOS refuses).
fn tula_write_file(path, buf, len): i64 {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (fd < 0) { return fd; }
    var rc = _tula_write_full(fd, buf, len);
    var cr = file_close(fd);
    if (rc < 0) { return rc; }
    if (cr < 0) { return cr; }
    return len;
}

# Crash-safe write of a serialized buffer (1.4.0, ADR 0006): the bytes go to a
# unique sibling temp file, which is fsync'd and renamed over `path`, and the
# directory is fsync'd. On any failure `path` is untouched and no temp is left.
# Returns len, or a negative errno. A symlink at `path` is replaced, not written
# through; an existing file's permission bits are kept exactly. 1.6.2: tula's own
# temp and write loop (the stdlib's file_write_atomic before), so a buffer over
# INT_MAX bytes works on macOS too.
fn tula_write_file_atomic(path, buf, len): i64 {
    var plen = strlen(path);
    if (plen + 32 > TULA_PATH_MAX) { return 0 - 36; }   # ENAMETOOLONG
    var tmp[4160];
    var fd = _tula_tmp_open(&tmp, path, plen, _tula_target_mode(path));
    if (fd < 0) { return fd; }
    var rc = _tula_write_full(fd, buf, len);
    if (rc >= 0) {
        _tula_keep_mode(fd, path);
        rc = xfsync(fd);
    }
    rc = _tula_tmp_commit(&tmp, fd, rc, path, plen);
    if (rc < 0) { return rc; }
    return len;
}

# Read the file at `fd` (header already checked: `total` bytes) into buf, then
# validate. Returns the reader handle (buf) or 0.
fn _tula_read_fd_into(fd, buf, total): i64 {
    if (xlseek(fd, 0, 0) != 0) { return 0; }   # SEEK_SET
    var got = _tula_read_full(fd, buf, total);
    if (got != total) { return 0; }
    return tula_open(buf, total);   # full structural validation
}

# Read a tula file into a fresh heap buffer. Returns the buffer (reader handle —
# use tula_* accessors) or 0 on error. One open: the header and the body come
# from the same fd. The allocation is sized from the header only after the file
# is known to hold that many bytes; then tula_open runs full validation. The
# stdlib caps one allocation at 2 GiB: for bigger files use tula_open_mmap, or
# tula_read_file_into with a buffer of your own.
fn tula_read_file(path): i64 {
    var fd = file_open(path, 0, 0);   # O_RDONLY
    if (fd < 0) { return 0; }
    var total = _tula_fd_total(fd);
    if (total < 0) { file_close(fd); return 0; }
    var buf = alloc(total);
    if (buf == 0) { file_close(fd); return 0; }
    var r = _tula_read_fd_into(fd, buf, total);
    file_close(fd);
    return r;
}

# The total length a tula file's header declares (1.4.0), once the file is known
# to hold that many bytes: what a buffer for tula_read_file_into needs. -1 if the
# file can't be opened, its header is bad, or it is shorter than it claims.
fn tula_file_len(path): i64 {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var total = _tula_fd_total(fd);
    file_close(fd);
    return total;
}

# Read a tula file into the caller's buffer of `cap` bytes (1.4.0, ADR 0006), then
# validate it. Returns buf as the reader handle, or 0 (any error, or a file
# larger than cap). The buffer can be reused for the next file, and can be bigger
# than the stdlib's 2 GiB allocation cap (an anonymous mapping, say), so heap
# reads work for files of any size. Size it with tula_file_len.
fn tula_read_file_into(path, buf, cap): i64 {
    if (buf == 0) { return 0; }
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var total = _tula_fd_total(fd);
    if (total < 0) { file_close(fd); return 0; }
    if (total > cap) { file_close(fd); return 0; }
    var r = _tula_read_fd_into(fd, buf, total);
    file_close(fd);
    return r;
}

# Zero-copy: mmap a tula file read-only. Returns the mapped buffer (reader
# handle) or 0. Release with tula_close_mmap when done. The mapping is made only
# for a file at least as long as its header says, and is unmapped again if
# validation then fails, so a rejected file leaves nothing mapped.
#
# A mapping reflects the file as it is NOW: another process that truncates or
# rewrites the file after this returns can change validated bytes (or, by
# truncating, make a later read SIGBUS). Map only files nobody else writes; for
# anything else use tula_read_file, which takes a private copy.
fn tula_open_mmap(path): i64 {
    var fd = file_open(path, 0, 0);   # O_RDONLY
    if (fd < 0) { return 0; }
    var total = _tula_fd_total(fd);
    if (total < 0) { file_close(fd); return 0; }
    var addr = mmap_file_ro(fd, total);
    file_close(fd);   # the mapping survives fd close
    if (addr == 0) { return 0; }
    if (tula_open(addr, total) == 0) {
        cyr_munmap(addr, total);
        return 0;
    }
    return addr;
}

# Release a buffer obtained from tula_open_mmap or tula_open_protected. 0 (a
# failed open) is a no-op.
fn tula_close_mmap(r): i64 {
    if (r == 0) { return 0; }
    return cyr_munmap(r, tula_total_len(r));
}

# A protected open (1.10.0, ADR 0013): a reader whose bytes nothing done to the
# file afterwards can change. Returns the reader or 0; release it with
# tula_close_mmap.
#
# An fs-verity file (Linux) is mapped read-only, zero-copy: the kernel refuses
# every write and truncation to it, and none can be open. Any other file is
# read into a private anonymous mapping (any size up to TULA_READ_MAX_BYTES)
# and validated there, so a writer or a truncation afterwards never reaches the
# reader; that costs one read and memory equal to the file. The check is made
# on the descriptor that is then mapped or read. The immutable attribute isn't
# trusted for zero-copy, since some filesystems let an already-open writer keep
# writing. A verity mapping can still SIGBUS if the storage returns data that
# fails verification, as any mapping of a failing disk can.
fn tula_open_protected(path): i64 {
    var fd = file_open(path, 0, 0);   # O_RDONLY
    if (fd < 0) { return 0; }
    var r = _tula_open_fd_protected(fd, _tula_fd_verity(fd));
    file_close(fd);
    return r;
}

# tula_open_protected on an open fd: map when `sealed` is 1 (the caller found
# the file fs-verity), else read into a private anonymous mapping. Either way
# the buffer is validated, and released again if validation fails.
fn _tula_open_fd_protected(fd, sealed): i64 {
    var code[8];
    return _tula_open_fd_coded(fd, sealed, &code);
}

# Open the tula file at `fd`: mapped read-only when `mapped` is 1, else read
# into a private anonymous mapping; then validated. Returns the buffer, or 0
# with the reason at `code` (1.11.0): TULA_ERR_TRUNCATED for a bad header or a
# file shorter than it says, TULA_ERR_OOM when the mapping can't be made, else
# tula_validate's code. Release the buffer with tula_close_mmap.
fn _tula_open_fd_coded(fd, mapped, code): i64 {
    store64(code, TULA_OK);
    var total = _tula_fd_total(fd);
    if (total < 0) {
        store64(code, TULA_ERR_TRUNCATED);
        return 0;
    }
    var buf = 0;
    if (mapped == 1) {
        buf = mmap_file_ro(fd, total);
        if (buf == 0) {
            store64(code, TULA_ERR_OOM);
            return 0;
        }
    } else {
        buf = mmap_anon(total);
        if (buf == 0) {
            store64(code, TULA_ERR_OOM);
            return 0;
        }
        var got = 0 - 1;
        if (xlseek(fd, 0, 0) == 0) { got = _tula_read_full(fd, buf, total); }   # SEEK_SET
        if (got != total) {
            cyr_munmap(buf, total);
            store64(code, TULA_ERR_TRUNCATED);
            return 0;
        }
    }
    var rc = tula_validate(buf, total);
    if (rc != TULA_OK) {
        cyr_munmap(buf, total);
        store64(code, rc);
        return 0;
    }
    return buf;
}

# 1 if fd's file has fs-verity enabled (Linux: FS_VERITY_FL, 0x00100000, from
# FS_IOC_GETFLAGS), else 0: on any error (a filesystem without the ioctl), and
# on every other OS. The kernel writes the flags as one 32-bit word.
fn _tula_fd_verity(fd): i64 {
    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_TARGET_CX
    var fl[8];
    store64(&fl, 0);
    if (sys_ioctl(fd, 0x80086601, &fl) != 0) { return 0; }   # FS_IOC_GETFLAGS
    if ((load32(&fl) & 0x100000) != 0) { return 1; }
    #endif
    #endif
    #endif
    #endif
    return 0;
}

# ---------------------------------------------------------------------------
# streaming + atomic writers (1.4.0, ADR 0006)
# ---------------------------------------------------------------------------
# tula_builder_write_file(_signed) write exactly the bytes tula_builder_finish(_signed)
# would return, without ever holding the file: header, manifest and names table
# go through a 64 KiB staging buffer (a private mapping); each payload is written
# straight from the caller's buffer. The signed writer maps the content it just
# wrote and signs the mapping. Everything lands in a random sibling temp file
# that is fsync'd and renamed over the target, so a failure or a crash never
# leaves a partial file under `path`.

enum TulaStreamCfg {
    TULA_STAGE_SIZE = 65536;
    TULA_PATH_MAX   = 4096;
}

# A staged writer (5 words): +0 fd, +8 staging buffer, +16 bytes staged, +24 the
# first error (sticky; 0 = none), +32 bytes accepted so far.
fn _tula_sw_flush(sw): i64 {
    if (load64(sw + 24) < 0) { return load64(sw + 24); }
    var used = load64(sw + 16);
    if (used > 0) {
        var rc = _tula_write_full(load64(sw), load64(sw + 8), used);
        if (rc < 0) {
            store64(sw + 24, rc);
            return rc;
        }
        store64(sw + 16, 0);
    }
    return 0;
}

# Append n bytes: copied into the staging buffer, or — for a chunk at least as
# big as the buffer, a tensor payload — written straight from p.
fn _tula_sw_put(sw, p, n): i64 {
    if (load64(sw + 24) < 0) { return load64(sw + 24); }
    if (n <= 0) { return 0; }
    if (load64(sw + 16) + n > TULA_STAGE_SIZE) {
        if (_tula_sw_flush(sw) < 0) { return load64(sw + 24); }
    }
    if (n >= TULA_STAGE_SIZE) {
        var rc = _tula_write_full(load64(sw), p, n);
        if (rc < 0) {
            store64(sw + 24, rc);
            return rc;
        }
    } else {
        _tula_copy(load64(sw + 8) + load64(sw + 16), p, n);
        store64(sw + 16, load64(sw + 16) + n);
    }
    store64(sw + 32, load64(sw + 32) + n);
    return 0;
}

# Append n (0..7) zero bytes: the padding after a payload.
fn _tula_sw_pad(sw, n): i64 {
    var z = 0;
    return _tula_sw_put(sw, &z, n);
}

# Stream the builder's content [0, content_len) through sw: the bytes
# tula_serialize lays out (shared layout helpers), signature excluded. Returns
# content_len, or a negative errno.
fn _tula_stream(b, sw, sig_len): i64 {
    var lay[96];
    _tula_layout(b, sig_len, &lay);
    var count = load64(b);
    var tsize = load64(&lay + 48);
    var msize = load64(&lay + 64);
    var h[64];
    _tula_header_write(&h, &lay);
    _tula_sw_put(sw, &h, TULA_HEADER_SIZE);
    var i = 0;
    while (i < count) {
        _tula_sw_put(sw, _tula_bentry(b, i), TULA_ENTRY_SIZE);   # the entry image built at add time
        i = i + 1;
    }
    if (msize > 0) {
        var me[144];
        _tula_meta_entry_write(&me, load64(&lay + 72), msize);
        _tula_sw_put(sw, &me, TULA_ENTRY_SIZE);
    }
    if (tsize > 0) {
        var te[144];
        _tula_names_entry_write(&te, load64(&lay + 80), tsize);
        _tula_sw_put(sw, &te, TULA_ENTRY_SIZE);
    }
    i = 0;
    while (i < count) {
        var m = _tula_bentry(b, i);
        var dlen = load64(m + 136);
        _tula_sw_put(sw, load64(m + 144), dlen);
        _tula_sw_pad(sw, tula_align8(dlen) - dlen);
        i = i + 1;
    }
    if (msize > 0) { _tula_stream_meta(b, sw, msize); }
    if (tsize > 0) {
        var nl = load64(b + 40);
        var hdr[16];
        store64(&hdr, TULA_NAMES_MAGIC);
        store64(&hdr + 8, nl);
        _tula_sw_put(sw, &hdr, TULA_NAMES_HDR);
        var rec[24];
        var noff = TULA_NAMES_HDR + nl * TULA_NAMES_REC;
        i = 0;
        while (i < count) {
            var m2 = _tula_bentry(b, i);
            if (load64(m2 + 152) != 0) {
                var len = load64(m2 + 160);
                store64(&rec, i);
                store64(&rec + 8, noff);
                store64(&rec + 16, len);
                _tula_sw_put(sw, &rec, TULA_NAMES_REC);
                noff = noff + len + 1;
            }
            i = i + 1;
        }
        var nul = 0;
        i = 0;
        while (i < count) {
            var m3 = _tula_bentry(b, i);
            var fp = load64(m3 + 152);
            if (fp != 0) {
                _tula_sw_put(sw, fp, load64(m3 + 160));
                _tula_sw_put(sw, &nul, 1);
            }
            i = i + 1;
        }
        _tula_sw_pad(sw, tula_align8(tsize) - tsize);
    }
    if (_tula_sw_flush(sw) < 0) { return load64(sw + 24); }
    var content = load64(&lay + 24);
    if (load64(sw + 32) != content) { return 0 - 5; }   # the layout and the stream must agree
    return content;
}

# The metadata table's payload (ADR 0008) through sw: the same bytes
# _tula_write_meta lays out in memory.
fn _tula_stream_meta(b, sw, msize): i64 {
    var mt = load64(b + 56);
    var np = load64(mt);
    var arr = load64(mt + 16);
    var hdr[16];
    store64(&hdr, TULA_META_MAGIC);
    store64(&hdr + 8, np);
    _tula_sw_put(sw, &hdr, TULA_META_HDR);
    var rec[32];
    var cur = TULA_META_HDR + np * TULA_META_REC;
    var q = 0;
    while (q < np) {
        var src = arr + q * 32;
        var kl = load64(src + 8);
        var vl = load64(src + 24);
        store64(&rec, cur);
        store64(&rec + 8, kl);
        store64(&rec + 16, cur + kl + 1);
        store64(&rec + 24, vl);
        _tula_sw_put(sw, &rec, TULA_META_REC);
        cur = cur + kl + 1 + vl + 1;
        q = q + 1;
    }
    var nul = 0;
    q = 0;
    while (q < np) {
        var src2 = arr + q * 32;
        _tula_sw_put(sw, load64(src2), load64(src2 + 8));
        _tula_sw_put(sw, &nul, 1);
        _tula_sw_put(sw, load64(src2 + 16), load64(src2 + 24));
        _tula_sw_put(sw, &nul, 1);
        q = q + 1;
    }
    _tula_sw_pad(sw, tula_align8(msize) - msize);
    return 0;
}

# Sign the `content` bytes just written to fd (ADR 0006): map them read-only, run
# ed25519_sign over the mapping (it streams the message through SHA-512, no
# copy), unmap, and append the 64-byte signature at the fd's offset (content).
fn _tula_sign_fd(fd, content, sk): i64 {
    var map = mmap_file_ro(fd, content);
    if (map == 0) { return 0 - 12; }
    var sig[64];
    ed25519_sign(sk, map, content, &sig);
    cyr_munmap(map, content);
    return _tula_write_full(fd, &sig, 64);
}

# The mode a replacement of `path` is created with: the rwx bits `path` has now,
# else 0644 (the umask applies at create), so the temp is never wider.
fn _tula_target_mode(path): i64 {
    var st[144];
    if (xstat(path, &st) == 0) { return load32(&st + STAT_MODE) & 0x1FF; }
    return 0x1A4;
}

# Write into dst the sibling temp name "<path>.tula-<16 hex>.tmp" (plen = strlen(path)),
# 64 random bits from the kernel. 0, or a negative errno if no randomness.
fn _tula_tmp_name(dst, path, plen): i64 {
    _tula_copy(dst, path, plen);
    var tag = ".tula-";
    _tula_copy(dst + plen, tag, 6);
    var rnd = 0;
    var got = random_bytes(&rnd, 8);
    if (got != 8) {
        if (got < 0) { return got; }
        return 0 - 5;
    }
    var d = 0;
    while (d < 16) {
        var nib = (rnd >> (60 - d * 4)) & 0xF;
        if (nib < 10) { store8(dst + plen + 6 + d, 48 + nib); }
        else          { store8(dst + plen + 6 + d, 87 + nib); }
        d = d + 1;
    }
    var ext = ".tmp";
    _tula_copy(dst + plen + 22, ext, 4);
    store8(dst + plen + 26, 0);
    return 0;
}

# Write into dst the directory holding `path` (plen = strlen(path)): everything
# before the last '/', "/" for a path directly under the root, "." for none.
fn _tula_dir_of(dst, path, plen): i64 {
    var k = plen - 1;
    while (k >= 0) {
        if (load8(path + k) == 47) { break; }
        k = k - 1;
    }
    if (k < 0) {
        store8(dst, 46);       # "."
        store8(dst + 1, 0);
        return dst;
    }
    if (k == 0) { k = 1; }     # "/"
    _tula_copy(dst, path, k);
    store8(dst + k, 0);
    return dst;
}

# fsync the directory holding `path` (best effort), so the rename itself is durable.
fn _tula_dir_fsync(path, plen): i64 {
    var dir[4112];
    _tula_dir_of(&dir, path, plen);
    var fd = file_open(&dir, 0, 0);
    if (fd >= 0) {
        xfsync(fd);
        file_close(fd);
    }
    return 0;
}

# Create a fresh sibling temp of `path` (1.6.2, shared by every atomic writer):
# the name goes into tmp (4160 bytes), and the file is opened read-write with
# O_EXCL and `mode`, so an existing name, a file or a planted symlink, is never
# opened or followed; another name is tried. The fd, or a negative errno.
fn _tula_tmp_open(tmp, path, plen, mode): i64 {
    var fd = 0 - 17;
    var tries = 0;
    while (tries < 8) {
        var nr = _tula_tmp_name(tmp, path, plen);
        if (nr < 0) { return nr; }
        fd = file_open(tmp, O_RDWR | O_CREAT | O_EXCL, mode);
        if (fd != 0 - 17) { break; }
        tries = tries + 1;
    }
    return fd;
}

# Give the temp at fd the exact permission bits `path` has now, if it exists:
# the create applied the umask to them (1.6.2; what the stdlib's
# file_write_atomic did for tula_write_file_atomic before). Called once the bytes
# are written and before the fsync, so while they are written the temp is never
# wider than the create allowed (the stdlib widened it first).
fn _tula_keep_mode(fd, path): i64 {
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    var st[144];
    if (xstat(path, &st) == 0) { sys_fchmod(fd, load32(&st + STAT_MODE) & 0x1FF); }
    #endif
    #endif
    return 0;
}

# Finish a temp opened by _tula_tmp_open (1.6.2): close fd, rename the temp over
# `path` and fsync the directory. rc is the result of writing it (negative: it
# failed). On any failure the temp is removed and `path` is untouched. Returns
# rc, or a negative errno.
fn _tula_tmp_commit(tmp, fd, rc, path, plen): i64 {
    var cr = file_close(fd);
    if (rc >= 0) {
        if (cr < 0) { rc = cr; }
    }
    if (rc < 0) {
        xunlink(tmp);
        return rc;
    }
    var rr = file_rename(tmp, path);
    if (rr < 0) {
        xunlink(tmp);
        return rr;
    }
    _tula_dir_fsync(path, plen);
    return rc;
}

# Fill an open, empty, read-write fd with the builder's file: stream it through a
# staging mapping, sign it (signed = 1) by mapping what was written, fsync.
# Returns the file's length, or a negative errno. The caller owns fd.
fn _tula_fill_fd(b, fd, sk, signed): i64 {
    var stage = mmap_anon(TULA_STAGE_SIZE);
    if (stage == 0) { return 0 - 12; }
    var sw[40];
    store64(&sw, fd);
    store64(&sw + 8, stage);
    store64(&sw + 16, 0);
    store64(&sw + 24, 0);
    store64(&sw + 32, 0);
    var sl = 0;
    if (signed == 1) { sl = 64; }
    var rc = _tula_stream(b, &sw, sl);
    cyr_munmap(stage, TULA_STAGE_SIZE);
    var content = rc;
    if (rc >= 0) {
        if (signed == 1) { rc = _tula_sign_fd(fd, content, sk); }
    }
    if (rc >= 0) {
        var fr = xfsync(fd);
        if (fr < 0) { rc = fr; }
    }
    if (rc < 0) { return rc; }
    return content + sl;
}

# Test hooks (internal, 1.6.1): _tula_nameless_off = 1 forces the named-temp
# path; _tula_nameless_used reports whether the last streaming write went
# through a nameless temp (1) or a named one (0).
var _tula_nameless_off = 0;
var _tula_nameless_used = 0;

# The nameless streaming write (1.6.1, Linux): the file is built in an O_TMPFILE
# inode in the target's directory — no name, so no other process can open it
# while it is written and signed — then linked under a random sibling name and
# renamed over `path`. Returns the file's length, a negative errno (nothing left
# behind), or 0 when this path is unavailable here — the kernel or filesystem
# has no O_TMPFILE, or /proc is not mounted (both found before anything is
# written), or, rarely, the finished inode can't be linked — and the caller then
# uses the named temp.
fn _tula_write_nameless(b, path, plen, mode, sk, signed): i64 {
    if (_tula_nameless_off == 1) { return 0; }
    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_TARGET_CX
    var dir[4112];
    _tula_dir_of(&dir, path, plen);
    var o_tmpfile = 0x400000 | O_DIRECTORY;   # __O_TMPFILE | O_DIRECTORY (x86_64 and aarch64)
    var fd = file_open(&dir, o_tmpfile | O_RDWR, mode);
    if (fd < 0) { return 0; }
    # The inode is named later through its /proc/self/fd link. Check that link
    # now: without /proc the file could not be named once written, and falling
    # back then would mean writing (and signing) it twice.
    var proc[64];
    var pre = "/proc/self/fd/";
    var pl = strlen(pre);
    _tula_copy(&proc, pre, pl);
    var digits[24];
    var nd = 0;
    var v = fd;
    if (v == 0) { store8(&digits, 48); nd = 1; }
    while (v > 0) {
        store8(&digits + nd, 48 + v % 10);
        v = v / 10;
        nd = nd + 1;
    }
    var q = 0;
    while (q < nd) {
        store8(&proc + pl + q, load8(&digits + nd - 1 - q));
        q = q + 1;
    }
    store8(&proc + pl + nd, 0);
    var pst[144];
    if (xstat(&proc, &pst) != 0) {
        file_close(fd);
        return 0;
    }
    var total = _tula_fill_fd(b, fd, sk, signed);
    if (total < 0) {
        file_close(fd);        # the inode has no name: it goes with the fd
        return total;
    }
    # Name it: link the fd's inode under a fresh random sibling name.
    var tmp[4160];
    var lr = 0 - 17;
    var tries = 0;
    while (tries < 8) {
        var nr = _tula_tmp_name(&tmp, path, plen);
        if (nr < 0) {
            file_close(fd);
            return nr;
        }
        lr = sys_linkat(AT_FDCWD, &proc, AT_FDCWD, &tmp, AT_SYMLINK_FOLLOW);
        if (lr == 0 - 17) {
            tries = tries + 1;
        } else {
            if (lr < 0) {
                # the /proc link was refused: link the fd itself. AT_EMPTY_PATH works
                # unprivileged for a file this process opened on newer kernels (the
                # 2024 relaxation, Linux 6.10); before, only with CAP_DAC_READ_SEARCH.
                # Failing that, fall back below.
                lr = sys_linkat(fd, "", AT_FDCWD, &tmp, AT_EMPTY_PATH);
            }
            tries = 8;
        }
    }
    var cr = file_close(fd);
    if (lr < 0) { return 0; }   # couldn't be named: fall back (the inode is gone)
    if (cr < 0) {
        xunlink(&tmp);
        return cr;
    }
    var rr = file_rename(&tmp, path);
    if (rr < 0) {
        xunlink(&tmp);
        return rr;
    }
    _tula_dir_fsync(path, plen);
    _tula_nameless_used = 1;
    return total;
    #endif
    #endif
    #endif
    #endif
    return 0;
}

# The shared atomic streaming write. `signed` = 1 appends an Ed25519 signature
# made with sk. Returns the file's total length, or a negative errno with `path`
# untouched and no temp file left behind. On Linux the file is first built
# nameless (O_TMPFILE, 1.6.1); elsewhere, or where that is unavailable, in a
# random O_EXCL sibling temp file.
fn _tula_write_stream(b, path, sk, signed): i64 {
    var plen = strlen(path);
    if (plen + 32 > TULA_PATH_MAX) { return 0 - 36; }   # ENAMETOOLONG
    var mode = _tula_target_mode(path);
    _tula_nameless_used = 0;
    var nrc = _tula_write_nameless(b, path, plen, mode, sk, signed);
    if (nrc != 0) { return nrc; }
    var tmp[4160];
    var fd = _tula_tmp_open(&tmp, path, plen, mode);
    if (fd < 0) { return fd; }
    var rc = _tula_fill_fd(b, fd, sk, signed);
    return _tula_tmp_commit(&tmp, fd, rc, path, plen);
}

# Stream the builder's file to `path`, unsigned (1.4.0, ADR 0006): exactly the
# bytes tula_builder_finish(b) returns, never held in memory — so no 2 GiB cap.
# Each payload is written straight from the caller's buffer. Crash-safe: the file
# is built in a temp — on Linux a nameless O_TMPFILE inode (1.6.1), elsewhere a
# random sibling name — fsync'd, then named and renamed over `path`; on any
# failure `path` is untouched. Returns the file's length, or a negative errno.
fn tula_builder_write_file(b, path): i64 {
    return _tula_write_stream(b, path, 0, 0);
}

# Stream the builder's file to `path`, signed with the 64-byte Ed25519 secret key
# sk (1.4.0, ADR 0006): exactly the bytes tula_builder_finish_signed(b, sk)
# returns. The content is written, mapped back read-only and signed (Ed25519 needs
# the whole message; the page cache holds it, not the heap), then the signature
# is appended. On Linux the file has no name until it is signed, so no other
# process can open it in between (1.6.1). Same crash safety and return values as
# tula_builder_write_file; a target without mmap gets -ENOMEM.
fn tula_builder_write_file_signed(b, path, sk): i64 {
    return _tula_write_stream(b, path, sk, 1);
}
