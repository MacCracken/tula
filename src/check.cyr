# @public — tula consumer checks (1.2.0): the strict validator and the
# quantization-sidecar lookup.
#
# tula_validate proves a buffer is SAFE to read (every offset in bounds). It
# does not prove the buffer is CONSISTENT: tensors may overlap or leave gaps,
# names may repeat, a shape may not match its byte length. Rejecting those in
# tula_validate would break 1.x files the 1.x writer can produce (the plain
# builder allows duplicate names), so the stricter rules live here, opt-in.
#
# Strict = canonical: a buffer passes tula_validate_strict iff it is exactly what
# a correct tula writer produces for its manifest — the layout
# tula_builder_add_checked + tula_builder_finish(_signed) write when every
# data_len is its dtype's packed length. Careful safetensors readers enforce the
# same family of rules (no overlap, no gaps, shape x dtype == byte length).

enum TulaStrictCfg {
    TULA_STRICT_SORT_MIN = 33;   # from this many tensors, duplicates are found by sorting
    TULA_STRICT_STACK_N  = 512;  # up to this many, the sort's index array is on the stack
}

# Pointer to manifest entry i of a validated buffer.
fn _tula_ent(buf, i): i64 {
    return buf + TULA_HEADER_SIZE + i * TULA_ENTRY_SIZE;
}

# One entry's strict rules. `cursor` is where the entry's payload must start.
fn _tula_strict_entry(e, payload, payload_len, cursor): i64 {
    # Name: every byte after the NUL is zero (tula_validate proved the NUL). Bytes
    # are scanned only up to the end of the word holding the NUL; every later
    # word must be all zero, one compare each.
    var k = 0;
    while (_tula_has_zero(load64(e + k)) == 0) { k = k + 8; }   # the word with the NUL
    while (load8(e + k) != 0) { k = k + 1; }
    k = k + 1;
    while ((k & 7) != 0) {
        if (load8(e + k) != 0) { return TULA_ERR_LAYOUT; }
        k = k + 1;
    }
    while (k < TULA_NAME_CAP) {
        if (load64(e + k) != 0) { return TULA_ERR_LAYOUT; }
        k = k + 8;
    }
    var dt = load64(e + 48);
    if (tula_packed_len(dt, 0) < 0) { return TULA_ERR_DTYPE; }
    # Shape: dims past ndim are zero, the count is defined, and data_len is
    # exactly the dtype's packed length for it.
    k = load64(e + 56);
    while (k < TULA_MAXDIM) {
        if (load64(e + 64 + k * 8) != 0) { return TULA_ERR_SHAPE; }
        k = k + 1;
    }
    var n = tula_entry_nelems(e);
    if (n < 0) { return TULA_ERR_SHAPE; }
    var dlen = load64(e + 136);
    if (dlen != tula_packed_len(dt, n)) { return TULA_ERR_SHAPE; }
    # Layout: the payload starts exactly where the previous tensor's 8-aligned
    # end left off. That one rule rejects overlap, gaps, misalignment and
    # out-of-manifest-order payloads.
    var doff = load64(e + 128);
    if (doff != cursor) { return TULA_ERR_LAYOUT; }
    var padded = tula_align8(dlen);
    if (padded > payload_len - doff) { return TULA_ERR_LAYOUT; }
    k = dlen;
    while (k < padded) {
        if (load8(payload + doff + k) != 0) { return TULA_ERR_LAYOUT; }
        k = k + 1;
    }
    # BOOL (1.7.0, ADR 0009): every byte is 0 or 1. The padding is zero by now,
    # so whole words up to the padded end are checked, 8 elements per compare.
    if (dt == TULA_DT_BOOL) {
        k = 0;
        while (k < padded) {
            if ((load64(payload + doff + k) & 0xFEFEFEFEFEFEFEFE) != 0) { return TULA_ERR_VALUE; }
            k = k + 8;
        }
    }
    # INT4 (1.8.0, ADR 0011): an odd count leaves the last byte's high nibble zero.
    if (dt == TULA_DT_INT4 || dt == TULA_DT_UINT4) {   # (UINT4 1.12.0, ADR 0015)
        if ((n & 1) == 1) {
            if ((load8(payload + doff + dlen - 1) >> 4) != 0) { return TULA_ERR_VALUE; }
        }
    }
    return TULA_OK;
}

# Order of two sort records (+0 name hash, +8 entry pointer): by hash, then by
# the 48-byte name fields when the hashes tie. Any total order serves — only
# equality of neighbours is used. -1 / 0 / +1.
fn _tula_rec_cmp(a, b): i64 {
    var ha = load64(a);
    var hb = load64(b);
    if (ha < hb) { return 0 - 1; }
    if (ha > hb) { return 1; }
    var pa = load64(a + 8);
    var pb = load64(b + 8);
    var w = 0;
    while (w < 6) {
        var x = load64(pa + w * 8);
        var y = load64(pb + w * 8);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        w = w + 1;
    }
    return 0;
}

# _tula_rec_cmp, made a total order when `tie` = 1: records whose names are equal
# are ordered by their pointer (for the name index, entry order — the first match
# then comes first). The strict validator sorts with tie = 0, so equal names stay
# equal and show up as neighbours.
fn _tula_rec_order(a, b, tie): i64 {
    var c = _tula_rec_cmp(a, b);
    if (c != 0) { return c; }
    if (tie == 0) { return 0; }
    var pa = load64(a + 8);
    var pb = load64(b + 8);
    if (pa < pb) { return 0 - 1; }
    if (pa > pb) { return 1; }
    return 0;
}

fn _tula_rec_swap(a, b): i64 {
    var h = load64(a);
    var p = load64(a + 8);
    store64(a, load64(b));
    store64(a + 8, load64(b + 8));
    store64(b, h);
    store64(b + 8, p);
    return 0;
}

# 1 if record a orders before record b (_tula_rec_order(a, b, tie) < 0). The
# hashes decide almost every comparison, inline; only equal hashes call the
# full order (1.9.0).
fn _tula_rec_lt(a, b, tie): i64 {
    var ha = load64(a);
    var hb = load64(b);
    if (ha < hb) { return 1; }
    if (ha > hb) { return 0; }
    if (_tula_rec_order(a, b, tie) < 0) { return 1; }
    return 0;
}

# Sift record `root` down the max-heap recs[0..end] (end inclusive). The larger
# child is found with two comparisons, as before; the swap is inline (1.9.0).
fn _tula_sift(recs, root, end, tie): i64 {
    loop {
        var child = root * 2 + 1;
        if (child > end) { return 0; }
        var pr = recs + root * 16;
        var ps = pr;
        var pc = recs + child * 16;
        if (_tula_rec_lt(ps, pc, tie) == 1) { ps = pc; }
        if (child + 1 <= end) {
            if (_tula_rec_lt(ps, pc + 16, tie) == 1) { ps = pc + 16; }
        }
        if (ps == pr) { return 0; }
        var h = load64(pr);
        var p = load64(pr + 8);
        store64(pr, load64(ps));
        store64(pr + 8, load64(ps + 8));
        store64(ps, h);
        store64(ps + 8, p);
        root = (ps - recs) / 16;
    }
    return 0;
}

# Heapsort n records: O(n log n) in the worst case, whatever the names. The
# hash only orders the records; equal hashes fall back to comparing names, so
# a crafted file whose names all collide just costs a 48-byte compare per step
# — never quadratic, as a hash TABLE over untrusted names could be.
fn _tula_heapsort(recs, n, tie): i64 {
    var start = (n - 2) / 2;
    while (start >= 0) {
        _tula_sift(recs, start, n - 1, tie);
        start = start - 1;
    }
    var end = n - 1;
    while (end > 0) {
        _tula_rec_swap(recs, recs + end * 16);
        end = end - 1;
        _tula_sift(recs, 0, end, tie);
    }
    return 0;
}

# Fill `recs` (count x 16 bytes) with (name hash, entry pointer), sort, and
# report TULA_ERR_DUP_NAME if two neighbours compare equal, else TULA_OK.
fn _tula_sorted_unique(buf, recs, count): i64 {
    var q = 0;
    while (q < count) {
        var e = _tula_ent(buf, q);
        store64(recs + q * 16, _tula_name_hash(e));
        store64(recs + q * 16 + 8, e);
        q = q + 1;
    }
    _tula_heapsort(recs, count, 0);
    q = 1;
    while (q < count) {
        if (_tula_rec_cmp(recs + q * 16 - 16, recs + q * 16) == 0) { return TULA_ERR_DUP_NAME; }
        q = q + 1;
    }
    return TULA_OK;
}

# TULA_ERR_DUP_NAME if two entries share a name, else TULA_OK. Runs after the
# per-entry rules, so every name field is canonical (zero after its NUL) and
# 48-byte equality IS name equality. Small manifests compare pairwise; larger
# ones sort (hash, pointer) records — on the stack up to TULA_STRICT_STACK_N
# tensors, beyond that in a private mapping, unmapped before returning.
fn _tula_strict_unique(buf, count): i64 {
    if (count < 2) { return TULA_OK; }
    if (count < TULA_STRICT_SORT_MIN) {
        var i = 0;
        while (i < count) {
            var j = i + 1;
            while (j < count) {
                if (_tula_name_eq(_tula_ent(buf, i), _tula_ent(buf, j)) == 1) { return TULA_ERR_DUP_NAME; }
                j = j + 1;
            }
            i = i + 1;
        }
        return TULA_OK;
    }
    if (count <= TULA_STRICT_STACK_N) {
        var srecs[8192];   # TULA_STRICT_STACK_N * 16
        return _tula_sorted_unique(buf, &srecs, count);
    }
    var bytes = count * 16;
    var idx = mmap_anon(bytes);
    if (idx == 0) { return TULA_ERR_OOM; }
    var rc = _tula_sorted_unique(buf, idx, count);
    cyr_munmap(idx, bytes);
    return rc;
}

# The strict validator (1.2.0). Runs tula_validate first (and returns its code
# on failure), then requires the buffer to be canonical:
#   TULA_ERR_LAYOUT   — len is not exactly the file's total; a tensor's payload
#                       does not start where the previous one's 8-aligned end
#                       left off (overlap, gap, misalignment, reordering); the
#                       payload runs past the last tensor; a padding byte or a
#                       name byte after the NUL is non-zero;
#   TULA_ERR_DTYPE    — a dtype this tula does not know;
#   TULA_ERR_SHAPE    — a negative dim, a non-zero dim past ndim, an element
#                       count over the cap, or data_len != the dtype's packed
#                       length for the shape (a 0-dim entry holds one element);
#   TULA_ERR_NAMES    — (1.3.0) a names table is present but not canonical:
#                       records out of order or pointing at the table itself,
#                       names not packed in record order, a name of 47 bytes or
#                       fewer, a NUL inside a name, or an entry whose field is
#                       not its full name's key (ADR 0004);
#   TULA_ERR_META     — (1.6.0) a metadata table is present but not canonical:
#                       keys out of order or repeated, a bad key character or
#                       length, a value that isn't well-formed UTF-8 or holds a
#                       NUL, not packed in record order, or past the caps
#                       (ADR 0008);
#   TULA_ERR_VALUE    — (1.7.0) a payload value its dtype doesn't allow: a BOOL
#                       byte other than 0 or 1 (ADR 0009); (1.8.0) an odd-length
#                       INT4 tensor whose last high nibble isn't zero (ADR 0011);
#   TULA_ERR_SHARDS   — (1.11.0) the file is a shard-set manifest (its metadata
#                       holds tula.shards) whose shard list isn't canonical, or
#                       which holds an entry besides its metadata table (ADR 0014);
#   TULA_ERR_DUP_NAME — two tensors share a name (for long names: a key);
#   TULA_ERR_OOM      — no memory for the duplicate check (> 512 tensors).
# Structure only, like tula_validate: authenticity is tula_verify_required. To
# read a file strictly: r = tula_read_file(path) (or tula_open_mmap), then
# tula_validate_strict(r, tula_total_len(r)).
fn tula_validate_strict(buf, len): i64 {
    var rc = tula_validate(buf, len);
    if (rc != TULA_OK) { return rc; }
    if (len != tula_total_len(buf)) { return TULA_ERR_LAYOUT; }
    var count = load64(buf + 16);
    var payload = buf + load64(buf + 32);
    var payload_len = load64(buf + 40);
    var cursor = 0;
    var i = 0;
    while (i < count) {
        var e = _tula_ent(buf, i);
        rc = _tula_strict_entry(e, payload, payload_len, cursor);
        if (rc != TULA_OK) { return rc; }
        cursor = cursor + tula_align8(load64(e + 136));
        i = i + 1;
    }
    if (cursor != payload_len) { return TULA_ERR_LAYOUT; }
    rc = _tula_strict_names(buf, count);
    if (rc != TULA_OK) { return rc; }
    rc = _tula_strict_meta(buf);
    if (rc != TULA_OK) { return rc; }
    rc = _tula_strict_shards(buf, count);
    if (rc != TULA_OK) { return rc; }
    return _tula_strict_unique(buf, count);
}

# The metadata table, if present, is exactly what tula_builder_set_meta + finish
# write (ADR 0008): within the caps; records in strictly increasing key order;
# each key valid, each value well-formed UTF-8 without NUL; key NUL value NUL,
# packed in record order straight after the records, ending at the table's end.
# Keys starting "tula." are accepted: a later tula may define them.
fn _tula_strict_meta(buf): i64 {
    var me = _tula_meta_entry(buf);
    if (me == 0) { return TULA_OK; }
    var t = tula_entry_data(buf, me);
    var dlen = tula_entry_data_len(me);
    var np = load64(t + 8);
    if (np > TULA_META_MAX_PAIRS) { return TULA_ERR_META; }
    if (dlen > TULA_META_MAX_BYTES) { return TULA_ERR_META; }
    var cur = TULA_META_HDR + np * TULA_META_REC;   # <= dlen: _tula_meta_entry checked np
    var pk = 0;
    var pkl = 0;
    var q = 0;
    while (q < np) {
        var rec = t + TULA_META_HDR + q * TULA_META_REC;
        var ko = load64(rec);
        var kl = load64(rec + 8);
        var vo = load64(rec + 16);
        var vl = load64(rec + 24);
        if (ko != cur) { return TULA_ERR_META; }
        if (kl < 1) { return TULA_ERR_META; }
        if (kl > TULA_META_KEY_MAX) { return TULA_ERR_META; }
        if (kl >= dlen - ko) { return TULA_ERR_META; }
        if (_tula_meta_key_ok(t + ko, kl) == 0) { return TULA_ERR_META; }
        if (load8(t + ko + kl) != 0) { return TULA_ERR_META; }
        if (q > 0) {
            if (_tula_bytes_cmp(pk, pkl, t + ko, kl) >= 0) { return TULA_ERR_META; }
        }
        cur = ko + kl + 1;
        if (vo != cur) { return TULA_ERR_META; }
        if (vl < 0) { return TULA_ERR_META; }
        if (vl > TULA_META_VALUE_MAX) { return TULA_ERR_META; }
        if (vl >= dlen - vo) { return TULA_ERR_META; }
        if (_tula_utf8_ok(t + vo, vl) == 0) { return TULA_ERR_META; }
        if (load8(t + vo + vl) != 0) { return TULA_ERR_META; }
        cur = vo + vl + 1;
        pk = t + ko;
        pkl = kl;
        q = q + 1;
    }
    if (cur != dlen) { return TULA_ERR_META; }
    return TULA_OK;
}

# The names table, if present, is exactly what tula_builder_add_long + finish
# write (ADR 0004): records in strictly increasing entry order, none at or past
# the table itself; names packed in record order straight after the records,
# each over 47 bytes, NUL-free, NUL-terminated, ending at the table's end; and
# each referenced entry's field equal to the key of its name.
fn _tula_strict_names(buf, count): i64 {
    var te = _tula_names_entry(buf);
    if (te == 0) { return TULA_OK; }
    var t = tula_entry_data(buf, te);
    var dlen = tula_entry_data_len(te);
    var nl = load64(t + 8);
    var noff = TULA_NAMES_HDR + nl * TULA_NAMES_REC;   # <= dlen: _tula_names_entry checked nl
    var prev = 0 - 1;
    var q = 0;
    while (q < nl) {
        var rec = t + TULA_NAMES_HDR + q * TULA_NAMES_REC;
        var ei = load64(rec);
        var off = load64(rec + 8);
        var len = load64(rec + 16);
        if (ei <= prev) { return TULA_ERR_NAMES; }
        if (ei >= count - 1) { return TULA_ERR_NAMES; }
        if (off != noff) { return TULA_ERR_NAMES; }
        if (off > dlen) { return TULA_ERR_NAMES; }
        if (len <= TULA_NAME_MAX) { return TULA_ERR_NAMES; }
        if (len >= dlen - off) { return TULA_ERR_NAMES; }
        var k = 0;
        while (k < len) {
            if (load8(t + off + k) == 0) { return TULA_ERR_NAMES; }
            k = k + 1;
        }
        if (load8(t + off + len) != 0) { return TULA_ERR_NAMES; }
        var key[48];
        _tula_key2(&key, t + off, len, "", 0);
        if (_tula_name_eq(_tula_ent(buf, ei), &key) == 0) { return TULA_ERR_NAMES; }
        noff = off + len + 1;
        prev = ei;
        q = q + 1;
    }
    if (noff != dlen) { return TULA_ERR_NAMES; }
    return TULA_OK;
}

# The "<name>.scale" sidecar of entry `e` (ADR 0002), checked for an unpack that
# will read `need` scales: it must exist, be f64, pass tula_entry_payload_ok, and
# hold at least `need` elements in at least need * 8 bytes. Returns the sidecar's
# entry, or 0. `need` is what the caller's unpack reads: 1 for a per-tensor
# scale, the row count for per-row, tula_nf4_blocks(n, block) for NF4.
# "<name>" is the entry's FULL name (1.3.0): a sidecar name over 47 chars is
# looked up through the names table (ADR 0004). A file without long names has
# no such sidecar, so there — as in 1.2.0 — a name over 41 chars returns 0.
fn tula_find_scale(r, e, need): i64 {
    return tula_find_sidecar(r, e, ".scale", need);
}

# Entry e's sidecar "<full name><suffix>" (1.12.0, ADR 0015): `suffix` is
# ".scale", ".min" or any other, and the sidecar must be an f64 tensor that
# passes tula_entry_payload_ok with at least `need` elements, as for
# tula_find_scale. Returns it, or 0 (also for need < 1).
fn tula_find_sidecar(r, e, suffix, need): i64 {
    if (need < 1) { return 0; }
    var name = tula_entry_full_name(r, e);
    return _tula_scale_ok(_tula_find_name2(r, name, strlen(name), suffix, strlen(suffix)), need);
}

# Sidecar `s` (or 0) if it is fit for an unpack reading `need` scales: f64,
# passes payload_ok, holds at least `need` elements in at least need * 8 bytes.
fn _tula_scale_ok(s, need): i64 {
    if (s == 0) { return 0; }
    if (tula_entry_dtype(s) != TULA_DT_F64) { return 0; }
    if (tula_entry_payload_ok(s) != 1) { return 0; }
    var n = tula_entry_nelems(s);
    if (n < need) { return 0; }
    if (tula_entry_data_len(s) < need * 8) { return 0; }   # need <= n <= 2^40: no overflow
    return s;
}
