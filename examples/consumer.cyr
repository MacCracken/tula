# examples/consumer.cyr — a complete downstream consumer of the tula codec, the
# v1.0 "≥1 consumer green" gate. It plays the role of a quantizing checkpoint
# writer + a hardened loader, exercising the whole public surface end-to-end:
#
#   quantize (ternary) -> checked builder + sidecar scale -> sign -> write ->
#   read (untrusted) -> strict validate -> signature required -> scale lookup +
#   payload-ok guard -> unpack -> dequant.
#
# 1.3.0: a LoRA adapter tensor whose name is over 47 chars, stored as bf16 —
# written with tula_builder_add_long, found with tula_find_name (ADR 0004/0005).
# 1.2.0: written with tula_builder_add_checked (no silent name truncation, no
# duplicates), loaded with tula_validate_strict + tula_verify_required +
# tula_find_scale, so each consistency question is one call.
#
# In-repo it includes src/lib.cyr; a real external consumer pulls dist/tula.cyr
# via [deps.tula] and supplies its own sigil (the bundle leaves ed25519_*
# unresolved — the standard consumer-bundle pattern).
#
#   cyrius build examples/consumer.cyr build/tula_consumer && ./build/tula_consumer

include "src/lib.cyr"

fn sput(s): i64 {
    syscall(1, 1, s, strlen(s));
    return 0;
}

fn fclose(a, b, tol): i64 {
    return f64_lt(f64_abs(f64_sub(a, b)), tol);
}

# gamma = mean(|w_i|) — the b1.58 per-tensor ternary scale (mirrors tentib).
fn absmean(w, n): i64 {
    var s = f64_from(0);
    var i = 0;
    while (i < n) {
        s = f64_add(s, f64_abs(load64(w + i * 8)));
        i = i + 1;
    }
    return f64_div(s, f64_from(n));
}

fn main(): i64 {
    alloc_init();
    var fails = 0;

    # ---- original f64 weights the consumer wants to store as ternary ----
    var n = 8;
    var w = alloc(n * 8);
    store64(w + 0 * 8, f64_from(2));
    store64(w + 1 * 8, f64_from(0 - 1));
    store64(w + 2 * 8, f64_from(0));
    store64(w + 3 * 8, f64_from(3));
    store64(w + 4 * 8, f64_from(0 - 2));
    store64(w + 5 * 8, f64_from(1));
    store64(w + 6 * 8, f64_from(0 - 3));
    store64(w + 7 * 8, f64_from(1));

    # ---- quantize to ternary {-1,0,+1} with a per-tensor gamma ----
    var gamma = absmean(w, n);
    var trits = alloc(n * 8);
    var i = 0;
    while (i < n) {
        var q = f64_to(f64_round(f64_div(load64(w + i * 8), gamma)));
        if (q > 1) { q = 1; }
        if (q < (0 - 1)) { q = 0 - 1; }
        store64(trits + i * 8, q);
        i = i + 1;
    }
    var packed = alloc(tula_ternary_bytes(n));
    var plen = tula_ternary_pack(trits, n, packed);

    # ---- a plain f64 bias tensor, for variety ----
    var bn = 4;
    var bias = alloc(bn * 8);
    store64(bias + 0 * 8, f64_from(10));
    store64(bias + 1 * 8, f64_from(20));
    store64(bias + 2 * 8, f64_from(30));
    store64(bias + 3 * 8, f64_from(40));

    # ---- keypair (deterministic seed) ----
    var sk = alloc(64);
    var pk = alloc(32);
    var seed = alloc(32);
    var k = 0;
    while (k < 32) { store8(seed + k, (k + 7) & 0xFF); k = k + 1; }
    ed25519_keypair(seed, sk, pk);

    # ---- build: ternary weight + its scale sidecar + f64 bias ----
    var shapeW = alloc(8);
    store64(shapeW, n);
    var shapeS = alloc(8);
    store64(shapeS, 1);
    var gbuf = alloc(8);
    store64(gbuf, gamma);
    var shapeB = alloc(8);
    store64(shapeB, bn);

    var b = tula_builder_new();
    if (tula_builder_add_checked(b, "layer.w", TULA_DT_TERNARY, shapeW, 1, packed, plen) != 0) { return 1; }
    if (tula_builder_add_checked(b, "layer.w.scale", TULA_DT_F64, shapeS, 1, gbuf, 8) != 0) { return 1; }
    if (tula_builder_add_checked(b, "layer.b", TULA_DT_F64, shapeB, 1, bias, bn * 8) != 0) { return 1; }
    # a LoRA A matrix row in bf16, under its real (62-char) adapter name
    var lora = "base_model.model.model.layers.0.self_attn.q_proj.lora_A.weight";
    var lb = alloc(bn * 2);
    tula_bf16_pack(bias, bn, lb);
    if (tula_builder_add_long(b, lora, TULA_DT_BF16, shapeB, 1, lb, bn * 2) != 0) { return 1; }
    var buf = tula_builder_finish_signed(b, sk);
    var total = tula_total_len(buf);

    var path = "build/tula_consumer_model.tula";
    if (buf == 0) { sput("FAIL: serialize\n"); return 1; }
    if (tula_write_file(path, buf, total) != total) { sput("FAIL: write\n"); return 1; }
    sput("wrote signed model: build/tula_consumer_model.tula\n");

    # ================================================================
    # LOAD as if untrusted (a fresh process reading a foreign file).
    # Every check below REJECTS — returns — on failure: nothing after a failed
    # check may touch the file, because what it guarded is then unproven.
    # ================================================================
    var r = tula_read_file(path);
    if (r == 0) { sput("FAIL: model did not open\n"); return 1; }

    # 1. consistency — canonical layout, unique names, every shape matching its
    #    bytes. After this, data_len == the dtype's packed length for every entry.
    var src = tula_validate_strict(r, tula_total_len(r));
    if (src != TULA_OK) { sput("FAIL: strict: "); sput(tula_err_name(src)); sput("\n"); return 1; }
    if (tula_count(r) != 5) { sput("FAIL: tensor count (4 + the names table)\n"); return 1; }

    # 2. authenticity — a stripped (UNSIGNED) file is rejected as firmly as BAD
    if (tula_verify_required(r, pk) != TULA_OK) { sput("FAIL: signature\n"); return 1; }
    sput("signature: OK\n");

    # 3. locate the ternary weight and its per-tensor scale sidecar, then unpack +
    #    dequant. Rank, dims and dtype are still checked against what THIS
    #    consumer expects before they size anything — strict proves the file is
    #    self-consistent, not that it is the model you wanted.
    var ew = tula_find(r, "layer.w");
    if (ew == 0) { sput("FAIL: layer.w missing\n"); return 1; }
    if (tula_entry_dtype(ew) != TULA_DT_TERNARY) { sput("FAIL: layer.w dtype\n"); return 1; }
    if (tula_entry_ndim(ew) != 1) { sput("FAIL: layer.w rank\n"); return 1; }
    if (tula_entry_payload_ok(ew) != 1) { sput("FAIL: payload guard (weight)\n"); return 1; }
    var es = tula_find_scale(r, ew, 1);   # one per-tensor scale
    if (es == 0) { sput("FAIL: layer.w.scale missing or short\n"); return 1; }

    var gamma2 = load64(tula_entry_data(r, es));
    var wn = tula_entry_dim(ew, 0);
    if (wn != n) { sput("FAIL: layer.w length\n"); return 1; }
    var got = alloc(wn * 8);
    tula_ternary_unpack(tula_entry_data(r, ew), wn, got);

    # dequantized weight = trit * gamma; must track the original within ternary error
    var tol = f64_mul(gamma2, f64_from(2));
    var okw = 1;
    i = 0;
    while (i < wn) {
        if (load64(got + i * 8) != load64(trits + i * 8)) { okw = 0; }
        var recon = f64_mul(f64_from(load64(got + i * 8)), gamma2);
        if (fclose(recon, load64(w + i * 8), tol) != 1) { okw = 0; }
        i = i + 1;
    }
    if (okw != 1) { sput("FAIL: ternary reconstruction\n"); fails = fails + 1; }
    else { sput("ternary weight: unpacked + dequantized OK\n"); }

    # 3. plain f64 bias round-trips bit-exact
    var eb = tula_find(r, "layer.b");
    if (eb == 0) { sput("FAIL: layer.b missing\n"); return 1; }
    if (tula_entry_dtype(eb) != TULA_DT_F64) { sput("FAIL: layer.b dtype\n"); return 1; }
    if (tula_entry_ndim(eb) != 1) { sput("FAIL: layer.b rank\n"); return 1; }
    if (tula_entry_dim(eb, 0) != bn) { sput("FAIL: layer.b length\n"); return 1; }
    if (tula_entry_payload_ok(eb) != 1) { sput("FAIL: payload guard (bias)\n"); return 1; }
    var bp = tula_entry_data(r, eb);
    var okb = 1;
    i = 0;
    while (i < bn) {
        if (load64(bp + i * 8) != load64(bias + i * 8)) { okb = 0; }
        i = i + 1;
    }
    if (okb != 1) { sput("FAIL: bias round-trip\n"); fails = fails + 1; }
    else { sput("f64 bias: bit-exact\n"); }

    # 4. the long-named bf16 LoRA tensor: found by its full name, its values exact
    #    (10/20/30/40 are representable in bf16, so the round trip is exact)
    var el = tula_find_name(r, lora);
    if (el == 0) { sput("FAIL: LoRA tensor missing\n"); return 1; }
    if (tula_entry_dtype(el) != TULA_DT_BF16) { sput("FAIL: LoRA dtype\n"); return 1; }
    if (tula_entry_dim(el, 0) != bn) { sput("FAIL: LoRA length\n"); return 1; }
    if (tula_entry_payload_ok(el) != 1) { sput("FAIL: payload guard (LoRA)\n"); return 1; }
    var lout = alloc(bn * 8);
    tula_bf16_unpack(tula_entry_data(r, el), bn, lout);
    var okl = 1;
    i = 0;
    while (i < bn) {
        if (load64(lout + i * 8) != load64(bias + i * 8)) { okl = 0; }
        i = i + 1;
    }
    if (okl != 1) { sput("FAIL: LoRA bf16 round-trip\n"); fails = fails + 1; }
    else { sput("long-named bf16 LoRA tensor: found by full name, exact\n"); }

    if (fails == 0) {
        sput("RESULT: PASS — consumer loaded a signed, quantized model end-to-end\n");
        return 0;
    }
    sput("RESULT: FAIL\n");
    return 1;
}

var exit_code = main();
syscall(60, exit_code);
