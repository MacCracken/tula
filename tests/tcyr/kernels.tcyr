# tests/tcyr/kernels.tcyr — the 1.9.0 kernels and the parallel unpack (ADR 0012).
#
# The 1.9.0 array helpers take table and inline paths; each must give the bits
# of the definition it replaces, which is still in the code: the scalar FP8
# conversions, f64_mul(f64_from(code), scale) for int8 and INT4,
# f64_mul(level, scale) for NF4, and tula_ternary_get. Lengths cross the table
# thresholds and leave tails; NF4 and INT4 run at even, odd, small and large
# blocks. tula_unpack_par must give the serial helper's output, bit for bit, at
# every thread count, write exactly n outputs, and refuse what it can't do.
# 1.9.1: the F16 / BF16 table path for large tensors against the scalar
# conversions, and NF4's thresholds against the codebook scan. 1.13.0:
# tula_uint4_unpack_par against tula_uint4_unpack.
include "src/lib.cyr"
include "lib/assert.cyr"

fn lcg(s): i64 {
    var x = load64(s) * 6364136223846793005 + 1442695040888963407;
    store64(s, x);
    var z = (x ^ ((x >> 30) & 0x3FFFFFFFF)) * 0xBF58476D1CE4E5B9;
    z = (z ^ ((z >> 27) & 0x1FFFFFFFFF)) * 0x94D049BB133111EB;
    return z ^ ((z >> 31) & 0x1FFFFFFFF);
}

fn fill_bytes(p, n, s): i64 {
    var i = 0;
    while (i < n) {
        store8(p + i, lcg(s) & 0xFF);
        i = i + 1;
    }
    return 0;
}

# A random f64: half of them in a weight-like range (|x| in [2^-14, 2^6)), the
# rest any bit pattern (subnormals, zeros, inf, NaN included).
fn rand_f64(s): i64 {
    var r = lcg(s);
    if ((r & 1) == 0) {
        var ex = 1009 + ((r >> 1) & 0x1F) % 20;
        return (r & 0x800FFFFFFFFFFFFF) | (ex << 52);
    }
    return lcg(s);
}

fn to8(fmt, x): i64 {
    if (fmt == 0) { return tula_f64_to_e4m3(x); }
    return tula_f64_to_e5m2(x);
}

fn from8(fmt, h): i64 {
    if (fmt == 0) { return tula_e4m3_to_f64(h); }
    return tula_e5m2_to_f64(h);
}

# FP8 arrays past the 1,024-element table threshold, with a tail: unpack is the
# scalar widen on every code (each code many times, at every position mod 8);
# pack is the scalar narrow on every code's value, the midpoints to its
# neighbour and +-1 ulp, and random values.
fn test_fp8_arrays() {
    var fmt = 0;
    while (fmt < 2) {
        var n = 256 * 17 + 5;
        var codes = alloc(n);
        var i = 0;
        while (i < n) { store8(codes + i, (i * 7) & 0xFF); i = i + 1; }
        var wide = alloc(n * 8);
        var r = 0;
        if (fmt == 0) { r = tula_e4m3_unpack(codes, n, wide); }
        else          { r = tula_e5m2_unpack(codes, n, wide); }
        assert_eq(r, n, "fp8 unpack (table path) returns n");
        var bad = 0;
        i = 0;
        while (i < n) {
            if (load64(wide + i * 8) != from8(fmt, load8(codes + i))) { bad = bad + 1; }
            i = i + 1;
        }
        assert_eq(bad, 0, "fp8 unpack table path == scalar widen, every code, tail too");
        # pack inputs
        var m = 256 * 4 + 50000;
        var src = alloc(m * 8);
        var s = alloc(8);
        store64(s, 0xF8 + fmt);
        var k = 0;
        var c = 0;
        while (c < 256) {
            var a = from8(fmt, c);
            var b = from8(fmt, (c + 1) & 0xFF);
            var mid = f64_div(f64_add(a, b), f64_from(2));
            store64(src + k * 8, a); k = k + 1;
            store64(src + k * 8, mid); k = k + 1;
            store64(src + k * 8, mid - 1); k = k + 1;
            store64(src + k * 8, mid + 1); k = k + 1;
            c = c + 1;
        }
        while (k < m) { store64(src + k * 8, rand_f64(s)); k = k + 1; }
        var packed = alloc(m);
        if (fmt == 0) { r = tula_e4m3_pack(src, m, packed); }
        else          { r = tula_e5m2_pack(src, m, packed); }
        assert_eq(r, m, "fp8 pack returns n");
        bad = 0;
        k = 0;
        while (k < m) {
            if (load8(packed + k) != (to8(fmt, load64(src + k * 8)) & 0xFF)) { bad = bad + 1; }
            k = k + 1;
        }
        assert_eq(bad, 0, "fp8 pack inline path == scalar narrow: codes, midpoints +-1 ulp, 50k random");
        fmt = fmt + 1;
    }
    return 0;
}

# int8 dequant's table path (n >= 1024, eight codes per load) against the
# definition, at several scales, with tails of every length mod 8.
fn test_int8_table() {
    var s = alloc(8);
    store64(s, 0x18);
    var n = 4096 + 7;
    var codes = alloc(n);
    fill_bytes(codes, n, s);
    var out = alloc(n * 8);
    var bad = 0;
    var t = 0;
    while (t < 4) {
        var scale = rand_f64(s);
        if (t == 0) { scale = f64_div(f64_from(3), f64_from(127)); }
        var len = n - t * 3;
        tula_int8_dequant(codes, len, scale, out);
        var i = 0;
        while (i < len) {
            var b = load8(codes + i);
            if (b >= 128) { b = b - 256; }
            if (load64(out + i * 8) != f64_mul(f64_from(b), scale)) { bad = bad + 1; }
            i = i + 1;
        }
        t = t + 1;
    }
    assert_eq(bad, 0, "int8 dequant table path == f64_mul(code, scale) on every element");
    return 0;
}

# Ternary's table path (n >= 1024) against tula_ternary_get, every byte value
# (code 3 included), with tails.
fn test_ternary_table() {
    var s = alloc(8);
    store64(s, 0x3);
    var nb = 4096;
    var packed = alloc(nb);
    fill_bytes(packed, nb, s);
    var out = alloc(nb * 4 * 8);
    var bad = 0;
    var len = nb * 4;
    while (len > nb * 4 - 4) {
        assert_eq(tula_ternary_unpack(packed, len, out), len, "ternary unpack returns n");
        var i = 0;
        while (i < len) {
            if (load64(out + i * 8) != tula_ternary_get(packed, i)) { bad = bad + 1; }
            i = i + 1;
        }
        len = len - 1;
    }
    assert_eq(bad, 0, "ternary table path == tula_ternary_get, all byte values, tails 0..3");
    return 0;
}

# NF4 and INT4 unpack against their definitions, at blocks below, at and above
# the 16-element table threshold, odd and even, over an odd count. The scales
# include zero, negatives, a subnormal, inf and NaN.
fn nibble_bad(which, n, block, codes, scales, out): i64 {
    var r = 0;
    if (which == 0) { r = tula_nf4_unpack(codes, scales, n, block, out); }
    else            { r = tula_int4_unpack(codes, scales, n, block, out); }
    if (r != n) { return 1000000; }
    var bad = 0;
    var i = 0;
    while (i < n) {
        var d = load64(scales + (i / block) * 8);
        var want = 0;
        if (which == 0) { want = f64_mul(tula_nf4_level(tula_nf4_get(codes, i)), d); }
        else            { want = f64_mul(f64_from(tula_int4_get(codes, i)), d); }
        if (load64(out + i * 8) != want) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

fn test_nibble_tables() {
    var s = alloc(8);
    store64(s, 0x44);
    var n = 2001;
    var codes = alloc((n + 1) / 2);
    fill_bytes(codes, (n + 1) / 2, s);
    var scales = alloc(n * 8);
    var i = 0;
    while (i < n) { store64(scales + i * 8, rand_f64(s)); i = i + 1; }
    store64(scales, 0);                          # +0
    store64(scales + 8, 0x8000000000000000);     # -0
    store64(scales + 16, 1);                     # the smallest subnormal
    store64(scales + 24, 0x7FF0000000000000);    # inf
    store64(scales + 32, 0xFFF8000000000000);    # NaN
    var out = alloc(n * 8);
    var bl[64];
    store64(&bl, 1); store64(&bl + 8, 3); store64(&bl + 16, 15); store64(&bl + 24, 16);
    store64(&bl + 32, 17); store64(&bl + 40, 32); store64(&bl + 48, 33); store64(&bl + 56, 64);
    var which = 0;
    while (which < 2) {
        var bad = 0;
        var j = 0;
        while (j < 8) {
            bad = bad + nibble_bad(which, n, load64(&bl + j * 8), codes, scales, out);
            bad = bad + nibble_bad(which, n - 1, load64(&bl + j * 8), codes, scales, out);
            j = j + 1;
        }
        if (which == 0) { assert_eq(bad, 0, "nf4 unpack == f64_mul(level, scale): blocks 1..64, odd/even n"); }
        else            { assert_eq(bad, 0, "int4 unpack == f64_mul(code, scale): blocks 1..64, odd/even n"); }
        which = which + 1;
    }
    return 0;
}

# The 16-bit unpacks from 262,144 elements (1.9.1) read a per-call table: every
# code, many times and at every position mod 4, against the scalar widen, on
# both sides of the threshold.
fn test_lut16() {
    var s = alloc(8);
    store64(s, 0x16);
    var n = 65536 * 4 + 777;
    var codes = alloc(n * 2);
    var i = 0;
    while (i < n) {
        var h = (i * 40503) & 0xFFFF;                  # every code, permuted
        if (i >= 65536 * 4) { h = lcg(s) & 0xFFFF; }
        store16(codes + i * 2, h);
        i = i + 1;
    }
    var out = alloc((n + 1) * 8);
    var which = 0;
    while (which < 2) {
        var bad = 0;
        var t = 0;
        while (t < 3) {
            var len = n;
            if (t == 1) { len = 262144; }
            if (t == 2) { len = 262143; }               # the loop, just below
            store64(out + len * 8, 0x5A5A5A5A5A5A5A5A);
            var r = 0;
            if (which == 0) { r = tula_f16_unpack(codes, len, out); }
            else            { r = tula_bf16_unpack(codes, len, out); }
            if (r != len) { bad = bad + 1; }
            if (load64(out + len * 8) != 0x5A5A5A5A5A5A5A5A) { bad = bad + 1; }
            i = 0;
            while (i < len) {
                var hc = load16(codes + i * 2);
                var want = 0;
                if (which == 0) { want = tula_f16_to_f64(hc); }
                else            { want = tula_bf16_to_f64(hc); }
                if (load64(out + i * 8) != want) { bad = bad + 1; }
                i = i + 1;
            }
            t = t + 1;
        }
        if (which == 0) { assert_eq(bad, 0, "f16 unpack table path == scalar widen, every code, around 2^18"); }
        else            { assert_eq(bad, 0, "bf16 unpack table path == scalar widen, every code, around 2^18"); }
        which = which + 1;
    }
    return 0;
}

# An f64's key in the f64 order, and back (the tests' own copies).
fn key(x): i64 {
    if ((x >> 63) != 0) { return 0 - (x & 0x7FFFFFFFFFFFFFFF); }
    return x;
}

fn unkey(k): i64 {
    if (k < 0) { return (0 - k) | (1 << 63); }
    return k;
}

# NF4's thresholds (1.9.1). The scan is monotone on [-1, 1], so checking it
# gives k just below t_k and k + 1 at t_k proves the threshold code equal to it
# everywhere there; dense neighbourhoods, random values and the specials check
# _tula_nf4_code against tula_nf4_nearest directly.
fn test_nf4_thresholds() {
    var lv[128];
    _tula_nf4_table(&lv);
    var tk[120];
    _tula_nf4_tkeys(&tk);
    var edges = 0;
    var k = 0;
    while (k < 15) {
        var t = _tula_nf4_threshold(k);
        if (tula_nf4_nearest(unkey(key(t) - 1)) != k) { edges = edges + 1; }
        if (tula_nf4_nearest(t) != k + 1) { edges = edges + 1; }
        if (key(t) <= key(tula_nf4_level(k))) { edges = edges + 1; }
        if (key(t) > key(tula_nf4_level(k + 1))) { edges = edges + 1; }
        k = k + 1;
    }
    assert_eq(edges, 0, "each threshold: the scan gives k just below it and k+1 at it, between levels k and k+1");
    var bad = 0;
    k = 0;
    while (k < 16) {
        var j = 0 - 3000;
        while (j <= 3000) {
            if (k < 15) {
                var xa = unkey(key(_tula_nf4_threshold(k)) + j);
                if (_tula_nf4_code(xa, &tk, &lv) != tula_nf4_nearest(xa)) { bad = bad + 1; }
            }
            var xb = unkey(key(tula_nf4_level(k)) + j);
            if (_tula_nf4_code(xb, &tk, &lv) != tula_nf4_nearest(xb)) { bad = bad + 1; }
            j = j + 1;
        }
        k = k + 1;
    }
    assert_eq(bad, 0, "_tula_nf4_code == the scan, 3,000 keys either side of every threshold and level");
    var s = alloc(8);
    store64(s, 0x4F4);
    var lo = key(0xBFF0000000000000);
    var span = 0x3FF0000000000000 - lo + 1;
    bad = 0;
    var i = 0;
    while (i < 1000000) {
        var r = lcg(s) & 0x7FFFFFFFFFFFFFFF;
        var xr = unkey(lo + r % span);
        if (_tula_nf4_code(xr, &tk, &lv) != tula_nf4_nearest(xr)) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, "_tula_nf4_code == the scan on 1,000,000 random keys in [-1, 1]");
    var sp[128];
    store64(&sp, 0); store64(&sp + 8, 0x8000000000000000);
    store64(&sp + 16, 0x3FF0000000000000); store64(&sp + 24, 0xBFF0000000000000);
    store64(&sp + 32, 0x7FF8000000000000); store64(&sp + 40, 0xFFF8000000000001);
    store64(&sp + 48, 0x7FF0000000000000); store64(&sp + 56, 0xFFF0000000000000);
    store64(&sp + 64, 0x3FF0000000000001); store64(&sp + 72, 0xC000000000000000);
    store64(&sp + 80, 0x7FE0000000000000); store64(&sp + 88, 1);
    store64(&sp + 96, 0x8000000000000001); store64(&sp + 104, 0x4330000000000000);
    store64(&sp + 112, 0x7FF0000000000001); store64(&sp + 120, 0xC330000000000000);
    bad = 0;
    i = 0;
    while (i < 16) {
        var xs = load64(&sp + i * 8);
        if (_tula_nf4_code(xs, &tk, &lv) != tula_nf4_nearest(xs)) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, "_tula_nf4_code == the scan on zeros, +-1, NaNs, infs, past +-1, subnormals, 2^52");
    return 0;
}

# tula_nf4_pack against its definition: per block, amax and the scan of
# x / amax, with zero blocks, NaN, inf and signed zeros among the values.
fn ref_nf4_pack(src, n, block, scales, nibbles): i64 {
    var z = 0;
    while (z < (n + 1) / 2) { store8(nibbles + z, 0); z = z + 1; }
    var nb = (n + block - 1) / block;
    var bi = 0;
    while (bi < nb) {
        var st = bi * block;
        var en = st + block;
        if (en > n) { en = n; }
        var amax = 0;
        var i = st;
        while (i < en) {
            var a = f64_abs(load64(src + i * 8));
            if (f64_gt(a, amax) == 1) { amax = a; }
            i = i + 1;
        }
        store64(scales + bi * 8, amax);
        i = st;
        while (i < en) {
            var c = 7;
            if (f64_gt(amax, 0) == 1) { c = tula_nf4_nearest(f64_div(load64(src + i * 8), amax)); }
            if ((i & 1) == 0) { store8(nibbles + i / 2, load8(nibbles + i / 2) | c); }
            else { store8(nibbles + i / 2, load8(nibbles + i / 2) | (c << 4)); }
            i = i + 1;
        }
        bi = bi + 1;
    }
    return nb;
}

fn test_nf4_pack_reference() {
    var s = alloc(8);
    store64(s, 0x4F40);
    var n = 20001;
    var src = alloc(n * 8);
    var i = 0;
    while (i < n) {
        var v = rand_f64(s);
        if ((i % 1000) < 64) { v = 0; }                              # a zero block, mostly
        if ((i % 777) == 5) { v = 0x7FF8000000000000; }              # NaN
        if ((i % 1999) == 11) { v = 0xFFF0000000000000; }            # -inf
        if ((i % 333) == 7) { v = 0x8000000000000000; }              # -0
        store64(src + i * 8, v);
        i = i + 1;
    }
    var sa = alloc(n * 8);
    var sb = alloc(n * 8);
    var na = alloc(n);
    var nbuf = alloc(n);
    var bl[40];
    store64(&bl, 64); store64(&bl + 8, 1); store64(&bl + 16, 7); store64(&bl + 24, 33); store64(&bl + 32, 4096);
    var bad = 0;
    var j = 0;
    while (j < 5) {
        var blk = load64(&bl + j * 8);
        var len = n - j;
        var ra = ref_nf4_pack(src, len, blk, sa, na);
        var rb = tula_nf4_pack(src, len, blk, sb, nbuf);
        if (ra != rb) { bad = bad + 1; }
        if (memeq(na, nbuf, (len + 1) / 2) != 1) { bad = bad + 1; }
        if (memeq(sa, sb, ra * 8) != 1) { bad = bad + 1; }
        j = j + 1;
    }
    assert_eq(bad, 0, "nf4 pack == its definition (amax, then the scan): 5 block sizes, NaN/inf/zeros");
    # Values exactly on the thresholds: a block whose largest value is 1.0, so
    # x / amax is x itself, holding every threshold and level with 4 keys either side.
    var m = 1 + 31 * 9;
    var ex = alloc(m * 8);
    store64(ex, 0x3FF0000000000000);
    var q = 1;
    var k = 0;
    while (k < 31) {
        var c = 0;
        if (k < 15) { c = _tula_nf4_threshold(k); } else { c = tula_nf4_level(k - 15); }
        var d = 0 - 4;
        while (d <= 4) { store64(ex + q * 8, unkey(key(c) + d)); q = q + 1; d = d + 1; }
        k = k + 1;
    }
    ref_nf4_pack(ex, m, m, sa, na);
    tula_nf4_pack(ex, m, m, sb, nbuf);
    var same = memeq(na, nbuf, (m + 1) / 2);
    assert_eq(same, 1, "nf4 pack == its definition on values at and around every threshold");
    return 0;
}

# ---------------------------------------------------------------------------
# tula_unpack_par
# ---------------------------------------------------------------------------

# Packed bytes of n elements of dt (the payload a slice reads).
fn pbytes(dt, n): i64 {
    return tula_packed_len(dt, n);
}

fn serial(dt, src, n, scales, block, dst): i64 {
    if (dt == TULA_DT_F32)     { return tula_f32_unpack(src, n, dst); }
    if (dt == TULA_DT_F16)     { return tula_f16_unpack(src, n, dst); }
    if (dt == TULA_DT_BF16)    { return tula_bf16_unpack(src, n, dst); }
    if (dt == TULA_DT_F8_E4M3) { return tula_e4m3_unpack(src, n, dst); }
    if (dt == TULA_DT_F8_E5M2) { return tula_e5m2_unpack(src, n, dst); }
    if (dt == TULA_DT_INT8)    { tula_int8_dequant(src, n, load64(scales), dst); return n; }
    if (dt == TULA_DT_NF4)     { return tula_nf4_unpack(src, scales, n, block, dst); }
    if (dt == TULA_DT_INT4)    { return tula_int4_unpack(src, scales, n, block, dst); }
    return tula_ternary_unpack(src, n, dst);
}

# Unpack n elements of dt at each thread count and compare with the serial
# helper; the word after dst[n] is a guard that must stay put. Returns the
# number of mismatching runs.
fn par_runs(dt, n, block, src, scales, ref, out): i64 {
    serial(dt, src, n, scales, block, ref);
    var counts[80];
    store64(&counts, 1); store64(&counts + 8, 2); store64(&counts + 16, 3);
    store64(&counts + 24, 4); store64(&counts + 32, 7); store64(&counts + 40, 64);
    store64(&counts + 48, 1000); store64(&counts + 56, 0); store64(&counts + 64, 0 - 5);
    var bad = 0;
    var j = 0;
    while (j < 9) {
        var k = 0;
        while (k <= n) { store64(out + k * 8, 0x5A5A5A5A5A5A5A5A); k = k + 1; }
        var r = tula_unpack_par(dt, src, n, scales, block, out, load64(&counts + j * 8));
        if (r != n) { bad = bad + 1; }
        if (memeq(out, ref, n * 8) != 1) { bad = bad + 1; }
        if (load64(out + n * 8) != 0x5A5A5A5A5A5A5A5A) { bad = bad + 1; }
        j = j + 1;
    }
    return bad;
}

fn test_par_matches_serial() {
    var s = alloc(8);
    store64(s, 0x9A9);
    # Large enough for several slices of TULA_PAR_MIN_CHUNK, odd so slices end ragged.
    var n = 4 * TULA_PAR_MIN_CHUNK + 4321;
    var src = alloc(n * 4);
    fill_bytes(src, n * 4, s);
    var scales = alloc(n * 8);
    var i = 0;
    while (i < n) { store64(scales + i * 8, rand_f64(s)); i = i + 1; }
    var ref = alloc((n + 1) * 8);
    var out = alloc((n + 1) * 8);
    var dts[72];
    store64(&dts, TULA_DT_F32); store64(&dts + 8, TULA_DT_F16); store64(&dts + 16, TULA_DT_BF16);
    store64(&dts + 24, TULA_DT_F8_E4M3); store64(&dts + 32, TULA_DT_F8_E5M2);
    store64(&dts + 40, TULA_DT_INT8); store64(&dts + 48, TULA_DT_TERNARY);
    var bad = 0;
    var d = 0;
    while (d < 7) {
        bad = bad + par_runs(load64(&dts + d * 8), n, 0, src, scales, ref, out);
        d = d + 1;
    }
    assert_eq(bad, 0, "par == serial for F32/F16/BF16/E4M3/E5M2/INT8/TERNARY at 1..1000, 0, -5 threads");
    var blocks[40];
    store64(&blocks, 64); store64(&blocks + 8, 32); store64(&blocks + 16, 33);
    store64(&blocks + 24, 7); store64(&blocks + 32, 1);
    bad = 0;
    var b = 0;
    while (b < 5) {
        var blk = load64(&blocks + b * 8);
        bad = bad + par_runs(TULA_DT_NF4, n, blk, src, scales, ref, out);
        bad = bad + par_runs(TULA_DT_INT4, n, blk, src, scales, ref, out);
        b = b + 1;
    }
    assert_eq(bad, 0, "par == serial for NF4/INT4 at blocks 64/32/33/7/1, every thread count");
    # Blocks near and past half the count run as one slice; still the serial output.
    bad = par_runs(TULA_DT_NF4, n, n / 2, src, scales, ref, out);
    bad = bad + par_runs(TULA_DT_INT4, n, n + 9, src, scales, ref, out);
    assert_eq(bad, 0, "par == serial when a block is half the tensor or more");
    # Small tensors (below one chunk per thread) take the caller's thread alone.
    bad = par_runs(TULA_DT_F16, 1000, 0, src, scales, ref, out);
    bad = bad + par_runs(TULA_DT_INT4, 3, 32, src, scales, ref, out);
    assert_eq(bad, 0, "par == serial on tensors smaller than a chunk");
    return 0;
}

# tula_uint4_unpack_par (1.13.0, ADR 0016) against tula_uint4_unpack at every
# thread count, at even, odd and large blocks; the word after dst[n] stays put.
fn uint4_par_runs(n, block, codes, scales, mins, ref, out): i64 {
    tula_uint4_unpack(codes, scales, mins, n, block, ref);
    var counts[80];
    store64(&counts, 1); store64(&counts + 8, 2); store64(&counts + 16, 3);
    store64(&counts + 24, 4); store64(&counts + 32, 7); store64(&counts + 40, 64);
    store64(&counts + 48, 1000); store64(&counts + 56, 0); store64(&counts + 64, 0 - 5);
    var bad = 0;
    var j = 0;
    while (j < 9) {
        var k = 0;
        while (k <= n) { store64(out + k * 8, 0x5A5A5A5A5A5A5A5A); k = k + 1; }
        var r = tula_uint4_unpack_par(codes, scales, mins, n, block, out, load64(&counts + j * 8));
        if (r != n) { bad = bad + 1; }
        if (memeq(out, ref, n * 8) != 1) { bad = bad + 1; }
        if (load64(out + n * 8) != 0x5A5A5A5A5A5A5A5A) { bad = bad + 1; }
        j = j + 1;
    }
    return bad;
}

fn test_uint4_par() {
    var s = alloc(8);
    store64(s, 0x5114);
    var n = 4 * TULA_PAR_MIN_CHUNK + 4321;
    var codes = alloc(n);
    fill_bytes(codes, (n + 1) / 2, s);
    var scales = alloc(n * 8);
    var mins = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(scales + i * 8, rand_f64(s));
        store64(mins + i * 8, rand_f64(s));
        i = i + 1;
    }
    var ref = alloc((n + 1) * 8);
    var out = alloc((n + 1) * 8);
    var blocks[48];
    store64(&blocks, 32); store64(&blocks + 8, 64); store64(&blocks + 16, 33);
    store64(&blocks + 24, 7); store64(&blocks + 32, 1); store64(&blocks + 40, n / 2);
    var bad = 0;
    var b = 0;
    while (b < 6) {
        bad = bad + uint4_par_runs(n, load64(&blocks + b * 8), codes, scales, mins, ref, out);
        b = b + 1;
    }
    bad = bad + uint4_par_runs(1000, 32, codes, scales, mins, ref, out);
    assert_eq(bad, 0, "uint4 par == serial: blocks 32/64/33/7/1/n-half, small n, threads 1..1000, 0, -5");
    store64(out, 77);
    assert_eq(tula_uint4_unpack_par(codes, scales, mins, 4, 0, out, 4), 0 - 1, "uint4 par, block 0: -1");
    assert_eq(tula_uint4_unpack_par(codes, scales, mins, 0 - 1, 32, out, 4), 0 - 1, "uint4 par, n < 0: -1");
    assert_eq(tula_uint4_unpack_par(codes, scales, mins, 0, 32, out, 4), 0, "uint4 par, n = 0: 0");
    assert_eq(load64(out), 77, "... and none of them writes");
    var ru = tula_unpack_par(TULA_DT_UINT4, codes, 4, scales, 32, out, 4);
    assert_eq(ru, 0 - 1, "tula_unpack_par still refuses UINT4 (-1): it takes one sidecar");
    return 0;
}

fn test_par_refusals() {
    var src = alloc(64);
    var sc = alloc(64);
    store64(sc, f64_from(1));
    var out = alloc(64);
    store64(out, 77);
    assert_eq(tula_unpack_par(TULA_DT_F64, src, 4, sc, 0, out, 4), 0 - 1, "F64 has no unpack helper: -1");
    assert_eq(tula_unpack_par(TULA_DT_I32, src, 4, sc, 0, out, 4), 0 - 1, "I32 (raw): -1");
    assert_eq(tula_unpack_par(TULA_DT_BOOL, src, 4, sc, 0, out, 4), 0 - 1, "BOOL (raw): -1");
    assert_eq(tula_unpack_par(99, src, 4, sc, 0, out, 4), 0 - 1, "an unknown dtype: -1");
    assert_eq(tula_unpack_par(TULA_DT_F16, src, 0 - 1, sc, 0, out, 4), 0 - 1, "n < 0: -1");
    assert_eq(tula_unpack_par(TULA_DT_NF4, src, 4, sc, 0, out, 4), 0 - 1, "NF4 block 0: -1");
    assert_eq(tula_unpack_par(TULA_DT_INT4, src, 4, sc, 0 - 32, out, 4), 0 - 1, "INT4 block < 0: -1");
    assert_eq(load64(out), 77, "... and nothing written");
    assert_eq(tula_unpack_par(TULA_DT_INT8, src, 0, 0, 0, out, 4), 0, "n = 0: returns 0, reads no scale");
    assert_eq(load64(out), 77, "... and writes nothing");
    return 0;
}

# A file's tensors unpacked through the parallel path, sidecar and all.
fn test_par_from_file() {
    var s = alloc(8);
    store64(s, 0xF11E);
    var n = 3 * TULA_PAR_MIN_CHUNK + 17;
    var vals = alloc(n * 8);
    var i = 0;
    while (i < n) {
        var r = lcg(s);
        var ex = 1013 + ((r >> 1) & 7);
        store64(vals + i * 8, (r & 0x800FFFFFFFFFFFFF) | (ex << 52));
        i = i + 1;
    }
    var half = alloc(n * 2);
    tula_bf16_pack(vals, n, half);
    var nb = tula_int4_blocks(n, TULA_INT4_BLOCK);
    var sc = alloc(nb * 8);
    var q = alloc(tula_int4_bytes(n));
    tula_int4_pack(vals, n, TULA_INT4_BLOCK, sc, q);
    var b = tula_builder_new();
    var dims[8];
    store64(&dims, n);
    tula_builder_add_checked(b, "w", TULA_DT_BF16, &dims, 1, half, n * 2);
    tula_builder_add_checked(b, "q", TULA_DT_INT4, &dims, 1, q, tula_int4_bytes(n));
    var sdims[8];
    store64(&sdims, nb);
    tula_builder_add_checked(b, "q.scale", TULA_DT_F64, &sdims, 1, sc, nb * 8);
    var buf = tula_builder_finish(b);
    assert_eq(tula_validate_strict(buf, tula_total_len(buf)), TULA_OK, "the file is strict-valid");
    var ew = tula_find(buf, "w");
    var eq = tula_find(buf, "q");
    var es = tula_find_scale(buf, eq, nb);
    assert(es != 0, "the int4 tensor's .scale sidecar is found");
    var a = alloc(n * 8);
    var c = alloc(n * 8);
    var pw = tula_entry_data(buf, ew);
    var rw = tula_unpack_par(tula_entry_dtype(ew), pw, n, 0, 0, a, 4);
    assert_eq(rw, n, "bf16 from the file, 4 threads");
    tula_bf16_unpack(half, n, c);
    assert_eq(memeq(a, c, n * 8), 1, "... the serial helper's values");
    var pq = tula_entry_data(buf, eq);
    var ps = tula_entry_data(buf, es);
    var rq = tula_unpack_par(tula_entry_dtype(eq), pq, n, ps, TULA_INT4_BLOCK, a, 4);
    assert_eq(rq, n, "int4 + its sidecar from the file, 4 threads");
    tula_int4_unpack(q, sc, n, TULA_INT4_BLOCK, c);
    assert_eq(memeq(a, c, n * 8), 1, "... the serial helper's values");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_fp8_arrays();
    test_int8_table();
    test_ternary_table();
    test_nibble_tables();
    test_lut16();
    test_nf4_thresholds();
    test_nf4_pack_reference();
    test_par_matches_serial();
    test_par_refusals();
    test_par_from_file();
    test_uint4_par();
    return assert_summary();
}

var rc = main();
syscall(60, rc);
