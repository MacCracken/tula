# tests/tcyr/dtype.tcyr — tula dtype payload helpers (M2): ternary / int8 / nf4
# pack↔unpack round-trips + the sidecar-scale storage convention (ADR 0002).
include "src/lib.cyr"
include "lib/assert.cyr"

# |a - b| < tol  (strict; f64 bit-pattern operands)
fn fclose(a, b, tol): i64 {
    return f64_lt(f64_abs(f64_sub(a, b)), tol);
}

# ================================================================
# ternary: {-1,0,+1} -> 2-bit packed -> back, exact.
# ================================================================
fn test_ternary_roundtrip() {
    var n = 10;
    var src = alloc(n * 8);
    # a varied trit pattern spanning all three symbols + byte boundaries
    var pat = alloc(n * 8);
    store64(pat + 0 * 8, 0 - 1);
    store64(pat + 1 * 8, 0);
    store64(pat + 2 * 8, 1);
    store64(pat + 3 * 8, 1);
    store64(pat + 4 * 8, 0 - 1);
    store64(pat + 5 * 8, 0);
    store64(pat + 6 * 8, 0);
    store64(pat + 7 * 8, 1);
    store64(pat + 8 * 8, 0 - 1);
    store64(pat + 9 * 8, 1);
    var i = 0;
    while (i < n) { store64(src + i * 8, load64(pat + i * 8)); i = i + 1; }

    var packed = alloc(tula_ternary_bytes(n));
    assert_eq(tula_ternary_pack(src, n, packed), 3, "ternary packed bytes = ceil(10/4)=3");

    var out = alloc(n * 8);
    tula_ternary_unpack(packed, n, out);
    var ok = 1;
    i = 0;
    while (i < n) {
        if (load64(out + i * 8) != load64(pat + i * 8)) { ok = 0; }
        # random-access accessor must agree with the bulk unpack
        if (tula_ternary_get(packed, i) != load64(pat + i * 8)) { ok = 0; }
        i = i + 1;
    }
    assert(ok, "ternary pack->unpack exact + get() agrees");
    return 0;
}

# ================================================================
# int8: absmax quant -> dequant, within one quantum; signed values survive.
# ================================================================
fn test_int8_roundtrip() {
    var n = 5;
    var src = alloc(n * 8);
    store64(src + 0 * 8, f64_from(10));
    store64(src + 1 * 8, f64_from(0 - 3));
    store64(src + 2 * 8, f64_from(7));
    store64(src + 3 * 8, f64_from(0 - 10));
    store64(src + 4 * 8, f64_from(5));

    var q = alloc(n);
    var scale = tula_int8_quant(src, n, q);
    assert(f64_gt(scale, f64_from(0)) == 1, "int8 scale positive");
    # the absmax element (-10) must map to the -127 rail (two's-complement 0x81)
    assert_eq(load8(q + 3) & 0xFF, 129, "int8 absmax element -> -127 (0x81)");

    var out = alloc(n * 8);
    tula_int8_dequant(q, n, scale, out);
    # dequant error is bounded by one quantum (= scale)
    var tol = f64_mul(scale, f64_from(2));
    var ok = 1;
    var i = 0;
    while (i < n) {
        if (fclose(load64(out + i * 8), load64(src + i * 8), tol) != 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok, "int8 dequant within one quantum (signs preserved)");
    return 0;
}

# ================================================================
# nf4: blockwise absmax + NF4 codebook, quant error bounded by the max half-gap
# (~0.152 * per-block absmax). Two blocks with distinct scales.
# ================================================================
fn test_nf4_roundtrip() {
    var n = 8;
    var block = 4;
    var src = alloc(n * 8);
    store64(src + 0 * 8, f64_from(3));
    store64(src + 1 * 8, f64_from(0 - 1));
    store64(src + 2 * 8, f64_from(0));
    store64(src + 3 * 8, f64_from(2));
    store64(src + 4 * 8, f64_from(0 - 8));
    store64(src + 5 * 8, f64_from(4));
    store64(src + 6 * 8, f64_from(0 - 2));
    store64(src + 7 * 8, f64_from(1));

    var nblocks = tula_nf4_blocks(n, block);
    assert_eq(nblocks, 2, "nf4 blocks = ceil(8/4)=2");
    var scales = alloc(nblocks * 8);
    var nib = alloc(tula_nf4_bytes(n));
    assert_eq(tula_nf4_pack(src, n, block, scales, nib), 2, "nf4 pack returns block count");
    # per-block absmax recorded in scales
    assert_eq(scales + 0, scales + 0, "scales written");
    assert(f64_eq(load64(scales + 0 * 8), f64_from(3)) == 1, "block0 absmax = 3");
    assert(f64_eq(load64(scales + 1 * 8), f64_from(8)) == 1, "block1 absmax = 8");

    var out = alloc(n * 8);
    tula_nf4_unpack(nib, scales, n, block, out);
    # the absmax elements map to a codebook endpoint exactly (error 0)
    var ok = 1;
    var i = 0;
    while (i < n) {
        var amax = load64(scales + (i / block) * 8);
        # tolerance = 0.2 * absmax  (> max half-gap 0.152)
        var tol = f64_mul(f64_div(f64_from(2), f64_from(10)), amax);
        if (fclose(load64(out + i * 8), load64(src + i * 8), tol) != 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok, "nf4 dequant within max half-gap * absmax");
    return 0;
}

fn test_nf4_zero_block() {
    var n = 4;
    var block = 4;
    var src = alloc(n * 8);
    var i = 0;
    while (i < n) { store64(src + i * 8, f64_from(0)); i = i + 1; }
    var scales = alloc(8);
    var nib = alloc(tula_nf4_bytes(n));
    tula_nf4_pack(src, n, block, scales, nib);
    assert(f64_eq(load64(scales), f64_from(0)) == 1, "zero block -> scale 0");
    var out = alloc(n * 8);
    tula_nf4_unpack(nib, scales, n, block, out);
    var ok = 1;
    i = 0;
    while (i < n) {
        if (load64(out + i * 8) != 0) { ok = 0; }   # 0.0 bit pattern
        i = i + 1;
    }
    assert(ok, "zero block -> all zeros, no div-by-zero");
    return 0;
}

# ================================================================
# Acceptance: full build->write->read of a ternary tensor + its scale sidecar.
# `w` (dtype TERNARY, logical shape [6], data = packed trits) is paired with
# `w.scale` (dtype F64, shape [1], gamma) — the ADR 0002 convention.
# ================================================================
fn test_ternary_file_with_scale() {
    var n = 6;
    var trits = alloc(n * 8);
    store64(trits + 0 * 8, 1);
    store64(trits + 1 * 8, 0 - 1);
    store64(trits + 2 * 8, 0);
    store64(trits + 3 * 8, 1);
    store64(trits + 4 * 8, 0);
    store64(trits + 5 * 8, 0 - 1);

    var packed = alloc(tula_ternary_bytes(n));
    var plen = tula_ternary_pack(trits, n, packed);

    # gamma = 3/4 = 0.75 (a representative per-tensor scale)
    var gamma = f64_div(f64_from(3), f64_from(4));
    var gbuf = alloc(8);
    store64(gbuf, gamma);

    var shapeW = alloc(8);
    store64(shapeW, n);
    var shapeS = alloc(8);
    store64(shapeS, 1);

    var b = tula_builder_new();
    tula_builder_add(b, "w", TULA_DT_TERNARY, shapeW, 1, packed, plen);
    tula_builder_add(b, "w.scale", TULA_DT_F64, shapeS, 1, gbuf, 8);
    var buf = tula_builder_finish(b);
    var total = tula_total_len(buf);

    var path = "build/test_dtype_ternary.tula";
    assert_eq(tula_write_file(path, buf, total), total, "wrote ternary + scale");
    var r = tula_read_file(path);
    assert(r != 0, "reopen ternary file");

    var ew = tula_find(r, "w");
    var es = tula_find(r, "w.scale");
    assert(ew != 0, "found w");
    assert(es != 0, "found w.scale");
    assert_eq(tula_entry_dtype(ew), TULA_DT_TERNARY, "w is ternary");
    assert_eq(tula_entry_dim(ew, 0), n, "w logical shape = 6");

    # unpack trits from the file payload; recover gamma from the sidecar
    var got = alloc(n * 8);
    tula_ternary_unpack(tula_entry_data(r, ew), n, got);
    var g2 = load64(tula_entry_data(r, es));
    assert(f64_eq(g2, gamma) == 1, "gamma survives sidecar round-trip");

    var ok = 1;
    var i = 0;
    while (i < n) {
        if (load64(got + i * 8) != load64(trits + i * 8)) { ok = 0; }
        # dequantized weight = trit * gamma
        var w = f64_mul(f64_from(load64(got + i * 8)), g2);
        var expect = f64_mul(f64_from(load64(trits + i * 8)), gamma);
        if (f64_eq(w, expect) != 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok, "ternary trits + dequant reconstruct from file");
    return 0;
}

# ================================================================
# payload-length contract (M5): tula_packed_len + tula_entry_payload_ok guard a
# foreign consumer against a shape that lies about how many bytes are stored.
# ================================================================
fn test_payload_ok() {
    assert_eq(tula_packed_len(TULA_DT_F64, 3), 24, "packed_len f64[3] = 24");
    assert_eq(tula_packed_len(TULA_DT_INT8, 5), 5, "packed_len int8[5] = 5");
    assert_eq(tula_packed_len(TULA_DT_TERNARY, 6), 2, "packed_len ternary[6] = 2");
    assert_eq(tula_packed_len(TULA_DT_NF4, 10), 5, "packed_len nf4[10] = 5");
    assert_eq(tula_packed_len(999, 4), 0 - 1, "packed_len unknown dtype = -1");

    # a ternary tensor whose data_len (2) matches shape [6]
    var n = 6;
    var trits = alloc(n * 8);
    var i = 0;
    while (i < n) { store64(trits + i * 8, 0); i = i + 1; }
    var packed = alloc(tula_ternary_bytes(n));
    var plen = tula_ternary_pack(trits, n, packed);
    var shape = alloc(8);
    store64(shape, n);
    var b = tula_builder_new();
    tula_builder_add(b, "w", TULA_DT_TERNARY, shape, 1, packed, plen);
    var buf = tula_builder_finish(b);
    var r = tula_open(buf, tula_total_len(buf));
    var e = tula_find(r, "w");
    assert_eq(tula_entry_payload_ok(e), 1, "consistent shape/data_len -> ok");

    # lie: claim shape [100] but only 2 bytes stored -> needs 25 bytes -> not ok
    store64(e + 64, 100);
    assert_eq(tula_entry_payload_ok(e), 0, "shape too big for data_len -> not ok");

    # lie: overflowing dim -> not ok, no wrap
    store64(e + 64, 0x7FFFFFFFFFFFFFFF);
    assert_eq(tula_entry_payload_ok(e), 0, "overflowing dim -> not ok");
    return 0;
}

# ---- 1.1.2: the optimized helpers answer bit-for-bit as 1.1.1's did ------------

# 1.1.1's tula_nf4_nearest: the full 16-entry scan.
fn ref_nearest(xn): i64 {
    var best = 0;
    var bestd = f64_abs(f64_sub(xn, tula_nf4_level(0)));
    var j = 1;
    while (j < 16) {
        var d = f64_abs(f64_sub(xn, tula_nf4_level(j)));
        if (f64_lt(d, bestd) == 1) {
            bestd = d;
            best = j;
        }
        j = j + 1;
    }
    return best;
}

# 1.1.1's tula_nf4_unpack: per element, scale at i / block.
fn ref_nf4_unpack(nibbles, scales, n, block, dst): i64 {
    var i = 0;
    while (i < n) {
        var amax = load64(scales + (i / block) * 8);
        store64(dst + i * 8, f64_mul(tula_nf4_level(tula_nf4_get(nibbles, i)), amax));
        i = i + 1;
    }
    return n;
}

fn lcg(s): i64 {
    var x = load64(s) * 6364136223846793005 + 1442695040888963407;
    store64(s, x);
    return (x >> 33) & 0x7FFFFFFF;
}

fn test_nearest_matches_reference() {
    var bad = 0;
    var tried = 0;
    # a dense sweep of [-1.25, 1.25]
    var k = 0;
    while (k <= 25000) {
        var x = f64_sub(f64_div(f64_from(k), f64_from(10000)), f64_div(f64_from(5), f64_from(4)));
        if (tula_nf4_nearest(x) != ref_nearest(x)) { bad = bad + 1; }
        tried = tried + 1;
        k = k + 1;
    }
    # every level, every midpoint between neighbours, and one ulp either side
    var j = 0;
    while (j < 16) {
        var l = tula_nf4_level(j);
        if (tula_nf4_nearest(l) != ref_nearest(l)) { bad = bad + 1; }
        tried = tried + 1;
        if (j < 15) {
            var mid = f64_div(f64_add(l, tula_nf4_level(j + 1)), f64_from(2));
            if (tula_nf4_nearest(mid) != ref_nearest(mid)) { bad = bad + 1; }
            if (tula_nf4_nearest(mid + 1) != ref_nearest(mid + 1)) { bad = bad + 1; }
            if (tula_nf4_nearest(mid - 1) != ref_nearest(mid - 1)) { bad = bad + 1; }
            tried = tried + 3;
        }
        j = j + 1;
    }
    # signed zeros, infinities, NaN, values far outside [-1, 1]
    var specials = alloc(8 * 8);
    store64(specials + 0, 0);                     # +0.0
    store64(specials + 8, 0x8000000000000000);    # -0.0
    store64(specials + 16, 0x7FF0000000000000);   # +inf
    store64(specials + 24, 0xFFF0000000000000);   # -inf
    store64(specials + 32, 0x7FF8000000000000);   # NaN
    store64(specials + 40, 0x4059000000000000);   # 100.0
    store64(specials + 48, 0xC059000000000000);   # -100.0
    store64(specials + 56, 0x0000000000000001);   # smallest subnormal
    var q = 0;
    while (q < 8) {
        var v = load64(specials + q * 8);
        if (tula_nf4_nearest(v) != ref_nearest(v)) { bad = bad + 1; }
        tried = tried + 1;
        q = q + 1;
    }
    assert(tried > 25000, "nearest: sweep + midpoints + specials covered");
    assert_eq(bad, 0, "early-exit nearest == the full scan on every input");
    assert_eq(tula_nf4_nearest(0x7FF8000000000000), 0, "NaN -> code 0, as before");
    return 0;
}

fn test_nf4_unpack_matches_reference() {
    var s = alloc(8);
    store64(s, 0x9E3779B97F4A7C15);
    var n = 1001;                       # odd, and not a multiple of either block
    var nib = alloc(tula_nf4_bytes(n));
    var i = 0;
    while (i < tula_nf4_bytes(n)) { store8(nib + i, lcg(s) & 0xFF); i = i + 1; }
    var scl = alloc(tula_nf4_blocks(n, 7) * 8);
    i = 0;
    while (i < tula_nf4_blocks(n, 7)) {
        store64(scl + i * 8, f64_div(f64_from(lcg(s) % 1000 + 1), f64_from(97)));
        i = i + 1;
    }
    var a = alloc(n * 8);
    var b = alloc(n * 8);
    var bad = 0;
    var blk = 0;
    while (blk < 2) {
        var block = 64;
        if (blk == 1) { block = 7; }
        assert_eq(tula_nf4_unpack(nib, scl, n, block, a), n, "nf4 unpack returns n");
        ref_nf4_unpack(nib, scl, n, block, b);
        i = 0;
        while (i < n) {
            if (load64(a + i * 8) != load64(b + i * 8)) { bad = bad + 1; }
            i = i + 1;
        }
        blk = blk + 1;
    }
    assert_eq(bad, 0, "table/blocked nf4 unpack == 1.1.1's, bit for bit (blocks 64 and 7)");
    return 0;
}

fn test_nf4_pack_matches_reference() {
    # pack with the early-exit nearest; repack the codes with the full scan and
    # compare every nibble
    var n = 2000;
    var block = 64;
    var src = alloc(n * 8);
    var i = 0;
    while (i < n) {
        var x = f64_div(f64_from((i * 7919) % 2003 - 1001), f64_from(613));
        store64(src + i * 8, x);
        i = i + 1;
    }
    var nb = tula_nf4_blocks(n, block);
    var scl = alloc(nb * 8);
    var nib = alloc(tula_nf4_bytes(n));
    assert_eq(tula_nf4_pack(src, n, block, scl, nib), nb, "nf4 pack returns the block count");
    var bad = 0;
    i = 0;
    while (i < n) {
        var amax = load64(scl + (i / block) * 8);
        var want = 7;
        if (f64_gt(amax, f64_from(0)) == 1) { want = ref_nearest(f64_div(load64(src + i * 8), amax)); }
        if (tula_nf4_get(nib, i) != want) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, "nf4 pack codes == the full-scan codes");
    return 0;
}

fn test_ternary_unpack_matches_get() {
    # every byte value (codes 0..3 in every slot, including the unused code 3),
    # and an n that is not a multiple of 4
    var n = 1023;
    var pk = alloc(256);
    var i = 0;
    while (i < 256) { store8(pk + i, i); i = i + 1; }
    var out = alloc(n * 8);
    assert_eq(tula_ternary_unpack(pk, n, out), n, "ternary unpack returns n");
    var bad = 0;
    i = 0;
    while (i < n) {
        if (load64(out + i * 8) != tula_ternary_get(pk, i)) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, "byte-wise ternary unpack == tula_ternary_get for every code");
    return 0;
}

fn test_nf4_block_nonpositive() {
    var nib = alloc(16);
    var scl = alloc(16);
    var dst = alloc(64);
    var src = alloc(64);
    var i = 0;
    while (i < 16) { store8(nib + i, 0xEE); i = i + 1; }
    i = 0;
    while (i < 8) { store64(dst + i * 8, 0x1111); store64(src + i * 8, f64_from(1)); i = i + 1; }
    assert_eq(tula_nf4_blocks(10, 0), 0, "nf4_blocks(n, 0) -> 0 (no divide by zero)");
    assert_eq(tula_nf4_blocks(10, 0 - 4), 0, "nf4_blocks(n, -4) -> 0");
    assert_eq(tula_nf4_pack(src, 8, 0, scl, nib), 0, "nf4_pack(block 0) -> 0");
    assert_eq(load8(nib), 0xEE, "... writing nothing");
    assert_eq(tula_nf4_unpack(nib, scl, 8, 0, dst), 0, "nf4_unpack(block 0) -> 0 (it used to SIGFPE)");
    assert_eq(load64(dst), 0x1111, "... writing nothing");
    return 0;
}

fn test_payload_ok_dims() {
    var e = alloc(TULA_ENTRY_SIZE);
    var z = 0;
    while (z < 18) { store64(e + z * 8, 0); z = z + 1; }
    store64(e + 48, TULA_DT_F64);
    store64(e + 56, 2);
    store64(e + 64, 0);
    store64(e + 72, 0 - 5);
    assert_eq(tula_entry_payload_ok(e), 0, "shape [0, -5] -> not ok (a negative dim, after a zero)");
    store64(e + 64, 0 - 5);
    store64(e + 72, 0);
    assert_eq(tula_entry_payload_ok(e), 0, "shape [-5, 0] -> not ok");
    store64(e + 56, 3);
    store64(e + 64, 0x40000000);
    store64(e + 72, 0x40000000);
    store64(e + 80, 0);
    assert_eq(tula_entry_payload_ok(e), 1, "shape [2^30, 2^30, 0] -> ok (empty; no overflow verdict)");
    store64(e + 80, 2);
    assert_eq(tula_entry_payload_ok(e), 0, "shape [2^30, 2^30, 2] -> not ok (over the cap)");
    return 0;
}

fn test_int8_dequant_table_matches_scalar() {
    # n >= 1024 takes the 256-entry table; compare every element against the
    # scalar formula, over every byte value, for two scales (one negative).
    var n = 2048;
    var q = alloc(n);
    var i = 0;
    while (i < n) { store8(q + i, (i * 37) & 0xFF); i = i + 1; }
    var out = alloc(n * 8);
    var bad = 0;
    var t = 0;
    while (t < 2) {
        var scale = f64_div(f64_from(3), f64_from(254));
        if (t == 1) { scale = f64_div(f64_from(0 - 7), f64_from(1000)); }
        tula_int8_dequant(q, n, scale, out);
        i = 0;
        while (i < n) {
            var b = load8(q + i);
            if (b >= 128) { b = b - 256; }
            if (load64(out + i * 8) != f64_mul(f64_from(b), scale)) { bad = bad + 1; }
            i = i + 1;
        }
        t = t + 1;
    }
    assert_eq(bad, 0, "table int8 dequant == the scalar formula on every code");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_ternary_roundtrip();
    test_int8_roundtrip();
    test_nf4_roundtrip();
    test_nf4_zero_block();
    test_ternary_file_with_scale();
    test_payload_ok();
    test_nearest_matches_reference();
    test_nf4_unpack_matches_reference();
    test_nf4_pack_matches_reference();
    test_ternary_unpack_matches_get();
    test_nf4_block_nonpositive();
    test_payload_ok_dims();
    test_int8_dequant_table_matches_scalar();
    return assert_summary();
}

var rc = main();
syscall(60, rc);
