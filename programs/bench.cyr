# programs/bench.cyr — tula throughput bench (M4, widened in 1.1.2): file I/O on a
# large synthetic file (write / read heap / mmap), plus the in-memory paths a
# consumer pays on every load — serialize, validate, find, and the dtype
# pack/unpack helpers. Each op reports its min latency over BN_ROUNDS rounds
# (least-noise estimate), in µs, plus a throughput. Numbers are transcribed into
# docs/benchmarks.md.
#
#   cyrius build programs/bench.cyr build/tula_bench && ./build/tula_bench

include "src/lib.cyr"

enum BenchCfg {
    BN_TENSORS  = 200;       # tensor count for the big file (<= TULA_BUILDER_MAX)
    BN_TSIZE    = 524288;    # 512 KiB per tensor -> ~100 MB payload
    BN_ROUNDS   = 5;         # rounds per op; report the min
    BN_PAGE     = 4096;
    BN_FIND_N   = 256;       # tensors in the find bench (TULA_BUILDER_MAX)
    BN_FIND_REP = 20;        # full sweeps of every name per round
    BN_VAL_REP  = 2000;      # tula_validate calls per round
    BN_DT_N     = 1048576;   # elements per dtype op (2^20)
}

fn sput(s): i64 {
    syscall(1, 1, s, strlen(s));
    return 0;
}

# "<label> <us> us  <mbps> MB/s\n" — bytes moved in ns.
fn report_mb(label, bytes, ns): i64 {
    sput(label);
    fmt_int(ns / 1000);
    sput(" us  ");
    var mbps = 0;
    if (ns > 0) { mbps = bytes * 1000 / ns; }
    fmt_int(mbps);
    sput(" MB/s\n");
    return 0;
}

# "<label> <ns_per_op> ns/op\n" — `ops` operations in ns.
fn report_op(label, ops, ns): i64 {
    sput(label);
    fmt_int(ns / ops);
    sput(" ns/op\n");
    return 0;
}

# "<label> <us> us  <melem> Melem/s\n" — `n` elements in ns.
fn report_el(label, n, ns): i64 {
    sput(label);
    fmt_int(ns / 1000);
    sput(" us  ");
    var me = 0;
    if (ns > 0) { me = n * 1000 / ns; }
    fmt_int(me);
    sput(" Melem/s\n");
    return 0;
}

# Copy cstring s to p (with its NUL); returns its length.
fn cat_into(p, s): i64 {
    var k = 0;
    while (load8(s + k) != 0) { store8(p + k, load8(s + k)); k = k + 1; }
    store8(p + k, 0);
    return k;
}

fn min_of(cur, round, dt): i64 {
    if (round == 0) { return dt; }
    if (dt < cur) { return dt; }
    return cur;
}

# Write decimal `v` at `p`; returns the digit count (no NUL).
fn put_dec(p, v): i64 {
    if (v == 0) { store8(p, 48); return 1; }
    var digs = alloc(24);
    var nd = 0;
    while (v > 0) { store8(digs + nd, 48 + (v % 10)); v = v / 10; nd = nd + 1; }
    var j = 0;
    while (j < nd) { store8(p + j, load8(digs + nd - 1 - j)); j = j + 1; }
    return nd;
}

# A builder of BN_TENSORS f64 tensors of BN_TSIZE bytes each, each seeded with a
# non-zero per-page pattern (so the file isn't sparse). Names "t0".."t199".
fn build_big_builder(): i64 {
    var b = tula_builder_new();
    var i = 0;
    while (i < BN_TENSORS) {
        var data = alloc(BN_TSIZE);
        var p = 0;
        while (p < BN_TSIZE) {
            store64(data + p, 0x1000000000000000 + i);
            p = p + BN_PAGE;
        }
        var shape = alloc(8);
        store64(shape + 0, BN_TSIZE / 8);
        var nm = alloc(16);
        store8(nm + 0, 116);            # 't'
        var nd = put_dec(nm + 1, i);
        store8(nm + 1 + nd, 0);
        tula_builder_add(b, nm, TULA_DT_F64, shape, 1, data, BN_TSIZE);
        i = i + 1;
    }
    return b;
}

# Realistic checkpoint names (long, sharing a 13-byte prefix):
# "model.layers.<i>.mlp.down_proj.weight". Returns a vec-like array of name ptrs
# at +0.. and the finished buffer through `out_buf`.
fn build_find_file(names, out_buf): i64 {
    var b = tula_builder_new();
    var shape = alloc(8);
    store64(shape, 1);
    var data = alloc(8);
    store64(data, 1);
    var pre = "model.layers.";
    var suf = ".mlp.down_proj.weight";
    var i = 0;
    while (i < BN_FIND_N) {
        var nm = alloc(48);
        var k = 0;
        while (load8(pre + k) != 0) { store8(nm + k, load8(pre + k)); k = k + 1; }
        k = k + put_dec(nm + k, i);
        var s = 0;
        while (load8(suf + s) != 0) { store8(nm + k, load8(suf + s)); k = k + 1; s = s + 1; }
        store8(nm + k, 0);
        store64(names + i * 8, nm);
        tula_builder_add(b, nm, TULA_DT_F64, shape, 1, data, 8);
        i = i + 1;
    }
    store64(out_buf, tula_builder_finish(b));
    return 0;
}

# Touch one byte per page across the whole buffer; returns the checksum (keeps the
# reads from being optimized away and forces mmap fault-in).
fn scan(r, total): i64 {
    var sum = 0;
    var off = 0;
    while (off < total) {
        sum = sum + load8(r + off);
        off = off + BN_PAGE;
    }
    return sum;
}

# f64[n] test signal in [-2, 2): a deterministic ramp, every value distinct.
fn fill_signal(dst, n): i64 {
    var i = 0;
    var span = f64_from(n);
    while (i < n) {
        var x = f64_div(f64_from((i * 7919) % n), span);         # [0, 1)
        store64(dst + i * 8, f64_sub(f64_mul(x, f64_from(4)), f64_from(2)));
        i = i + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    var chk = 0;
    sput("building ~100 MB synthetic tula builder...\n");
    var bb = build_big_builder();

    # ---- serialize (builder -> one contiguous buffer, payload memcpy) ----
    var zmin = 0;
    var buf = 0;
    var round = 0;
    while (round < BN_ROUNDS) {
        var tz = now_ns();
        buf = tula_builder_finish(bb);
        zmin = min_of(zmin, round, now_ns() - tz);
        round = round + 1;
    }
    var total = tula_total_len(buf);
    sput("  tensors : ");
    fmt_int(tula_count(buf));
    sput("\n  bytes   : ");
    fmt_int(total);
    sput("\n");
    report_mb("serialize    : ", total, zmin);

    var path = "build/tula_bench.tula";

    # ---- write ----
    var wmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t0 = now_ns();
        tula_write_file(path, buf, total);
        wmin = min_of(wmin, round, now_ns() - t0);
        round = round + 1;
    }
    report_mb("write        : ", total, wmin);

    # ---- streaming write (1.4.0): builder -> disk, atomic (temp + fsync + rename) ----
    var smin2 = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var ts = now_ns();
        if (tula_builder_write_file(bb, "build/tula_bench_stream.tula") != total) { sput("stream FAILED\n"); return 1; }
        smin2 = min_of(smin2, round, now_ns() - ts);
        round = round + 1;
    }
    report_mb("stream write : ", total, smin2);

    # ---- read (heap copy) ----
    var rmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t1 = now_ns();
        var rr = tula_read_file(path);
        var dt2 = now_ns() - t1;
        if (rr == 0) { sput("read FAILED\n"); return 1; }
        rmin = min_of(rmin, round, dt2);
        round = round + 1;
    }
    report_mb("read (heap)  : ", total, rmin);

    # ---- mmap open (lazy) ----
    var omin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t2 = now_ns();
        var rm = tula_open_mmap(path);
        var dt3 = now_ns() - t2;
        if (rm == 0) { sput("mmap FAILED\n"); return 1; }
        tula_close_mmap(rm);
        omin = min_of(omin, round, dt3);
        round = round + 1;
    }
    sput("mmap open    : ");
    fmt_int(omin / 1000);
    sput(" us\n");

    # ---- mmap scan (fault-in throughput) ----
    var smin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var rm2 = tula_open_mmap(path);
        var t3 = now_ns();
        chk = chk + scan(rm2, total);
        smin = min_of(smin, round, now_ns() - t3);
        tula_close_mmap(rm2);
        round = round + 1;
    }
    report_mb("mmap scan    : ", total, smin);

    # ---- validate (the untrusted-input gate; 200 entries) ----
    var vmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t4 = now_ns();
        var v = 0;
        while (v < BN_VAL_REP) { chk = chk + tula_validate(buf, total); v = v + 1; }
        vmin = min_of(vmin, round, now_ns() - t4);
        round = round + 1;
    }
    report_op("validate     : ", BN_VAL_REP, vmin);

    # ---- validate strict (1.2.0; 200 entries: per-entry rules + heapsort of names) ----
    var vsmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t4s = now_ns();
        var vs = 0;
        while (vs < BN_VAL_REP) { chk = chk + tula_validate_strict(buf, total); vs = vs + 1; }
        vsmin = min_of(vsmin, round, now_ns() - t4s);
        round = round + 1;
    }
    report_op("strict (200) : ", BN_VAL_REP, vsmin);

    # ---- find (256 long, shared-prefix names; every name, BN_FIND_REP sweeps) ----
    var names = alloc(BN_FIND_N * 8);
    var fbox = alloc(8);
    build_find_file(names, fbox);
    var fr = load64(fbox);
    var fmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t5 = now_ns();
        var rep = 0;
        while (rep < BN_FIND_REP) {
            var q = 0;
            while (q < BN_FIND_N) {
                if (tula_find(fr, load64(names + q * 8)) == 0) { sput("find MISSED\n"); return 1; }
                q = q + 1;
            }
            rep = rep + 1;
        }
        fmin = min_of(fmin, round, now_ns() - t5);
        round = round + 1;
    }
    report_op("find (n=256) : ", BN_FIND_N * BN_FIND_REP, fmin);

    # ---- strict on the 256 long, shared-prefix names (the sort's worst-ish case) ----
    var flen = tula_total_len(fr);
    var fsmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t5s = now_ns();
        var fs = 0;
        while (fs < BN_VAL_REP) { chk = chk + tula_validate_strict(fr, flen); fs = fs + 1; }
        fsmin = min_of(fsmin, round, now_ns() - t5s);
        round = round + 1;
    }
    report_op("strict (256) : ", BN_VAL_REP, fsmin);

    # ---- strict over a 16 MiB mask (1.7.0): BOOL's 0/1 rule vs U8, which has none ----
    var mn = 16777216;
    var md = alloc(mn + 8);
    var mz = 0;
    while (mz < mn / 8) {
        store64(md + mz * 8, 0x0100010001000101);
        mz = mz + 1;
    }
    var mshape = alloc(8);
    store64(mshape, mn);
    var mbb = tula_builder_new();
    tula_builder_add_checked(mbb, "mask", TULA_DT_BOOL, mshape, 1, md, mn);
    var bbuf = tula_builder_finish(mbb);
    var mbu = tula_builder_new();
    tula_builder_add_checked(mbu, "bytes", TULA_DT_U8, mshape, 1, md, mn);
    var ubuf = tula_builder_finish(mbu);
    var mbmin = 0;
    var mumin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var mtb = now_ns();
        chk = chk + tula_validate_strict(bbuf, tula_total_len(bbuf));
        mbmin = min_of(mbmin, round, now_ns() - mtb);
        var mtu = now_ns();
        chk = chk + tula_validate_strict(ubuf, tula_total_len(ubuf));
        mumin = min_of(mumin, round, now_ns() - mtu);
        round = round + 1;
    }
    report_mb("strict BOOL 16M : ", mn, mbmin);
    report_mb("strict U8 16M   : ", mn, mumin);

    # ---- builder add: plain vs checked (1.2.0; name index lookup), 256 adds ----
    var shape1 = alloc(8);
    store64(shape1, 1);
    var d1 = alloc(8);
    var amin = 0;
    var cmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var ba = tula_builder_new();
        var t5a = now_ns();
        var qa = 0;
        while (qa < BN_FIND_N) {
            tula_builder_add(ba, load64(names + qa * 8), TULA_DT_F64, shape1, 1, d1, 8);
            qa = qa + 1;
        }
        amin = min_of(amin, round, now_ns() - t5a);
        var bc = tula_builder_new();
        var t5c = now_ns();
        var qc = 0;
        while (qc < BN_FIND_N) {
            if (tula_builder_add_checked(bc, load64(names + qc * 8), TULA_DT_F64, shape1, 1, d1, 8) != 0) {
                sput("checked add FAILED\n");
                return 1;
            }
            qc = qc + 1;
        }
        cmin = min_of(cmin, round, now_ns() - t5c);
        round = round + 1;
    }
    report_op("add (plain)  : ", BN_FIND_N, amin);
    report_op("add (checked): ", BN_FIND_N, cmin);

    # ---- dtype helpers on 2^20 elements ----
    var n = BN_DT_N;
    var sig = alloc(n * 8);
    fill_signal(sig, n);
    var out = alloc(n * 8);

    # NF4 pack (codebook nearest per element) + unpack (dequant)
    var nib = alloc(tula_nf4_bytes(n));
    var scl = alloc(tula_nf4_blocks(n, TULA_NF4_BLOCK) * 8);
    var pmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t6 = now_ns();
        tula_nf4_pack(sig, n, TULA_NF4_BLOCK, scl, nib);
        pmin = min_of(pmin, round, now_ns() - t6);
        round = round + 1;
    }
    report_el("nf4 pack     : ", n, pmin);
    var umin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t7 = now_ns();
        tula_nf4_unpack(nib, scl, n, TULA_NF4_BLOCK, out);
        umin = min_of(umin, round, now_ns() - t7);
        round = round + 1;
    }
    report_el("nf4 unpack   : ", n, umin);
    chk = chk + load64(out + 8 * 12345);

    # ternary unpack (2-bit codes -> i64 trits)
    var trits = alloc(n * 8);
    var ti = 0;
    while (ti < n) { store64(trits + ti * 8, (ti % 3) - 1); ti = ti + 1; }
    var tpk = alloc(tula_ternary_bytes(n));
    tula_ternary_pack(trits, n, tpk);
    var tmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t8 = now_ns();
        tula_ternary_unpack(tpk, n, out);
        tmin = min_of(tmin, round, now_ns() - t8);
        round = round + 1;
    }
    report_el("ternary unpk : ", n, tmin);
    chk = chk + load64(out + 8 * 777);

    # int8 dequant
    var q8 = alloc(n);
    var s8 = tula_int8_quant(sig, n, q8);
    var imin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t9 = now_ns();
        tula_int8_dequant(q8, n, s8, out);
        imin = min_of(imin, round, now_ns() - t9);
        round = round + 1;
    }
    report_el("int8 dequant : ", n, imin);
    chk = chk + load64(out + 8 * 4242);

    # ---- F32 / F16 / BF16 (1.3.0): integer-arithmetic IEEE conversions ----
    var nb32 = alloc(n * 4);
    var nb16 = alloc(n * 2);
    var fmt = 0;
    while (fmt < 3) {
        var pk = 0;
        var up = 0;
        round = 0;
        while (round < BN_ROUNDS) {
            var tp = now_ns();
            if (fmt == 0) { tula_f32_pack(sig, n, nb32); }
            if (fmt == 1) { tula_f16_pack(sig, n, nb16); }
            if (fmt == 2) { tula_bf16_pack(sig, n, nb16); }
            pk = min_of(pk, round, now_ns() - tp);
            var tu = now_ns();
            if (fmt == 0) { tula_f32_unpack(nb32, n, out); }
            if (fmt == 1) { tula_f16_unpack(nb16, n, out); }
            if (fmt == 2) { tula_bf16_unpack(nb16, n, out); }
            up = min_of(up, round, now_ns() - tu);
            round = round + 1;
        }
        chk = chk + load64(out + 8 * 999);
        if (fmt == 0) { report_el("f32 pack     : ", n, pk); report_el("f32 unpack   : ", n, up); }
        if (fmt == 1) { report_el("f16 pack     : ", n, pk); report_el("f16 unpack   : ", n, up); }
        if (fmt == 2) { report_el("bf16 pack    : ", n, pk); report_el("bf16 unpack  : ", n, up); }
        fmt = fmt + 1;
    }

    # ---- FP8 E4M3 / E5M2 and INT4 (1.8.0): per-element conversions ----
    var nb8 = alloc(n);
    var f8 = 0;
    while (f8 < 2) {
        var pk8 = 0;
        var up8 = 0;
        round = 0;
        while (round < BN_ROUNDS) {
            var tp8 = now_ns();
            if (f8 == 0) { tula_e4m3_pack(sig, n, nb8); }
            if (f8 == 1) { tula_e5m2_pack(sig, n, nb8); }
            pk8 = min_of(pk8, round, now_ns() - tp8);
            var tu8 = now_ns();
            if (f8 == 0) { tula_e4m3_unpack(nb8, n, out); }
            if (f8 == 1) { tula_e5m2_unpack(nb8, n, out); }
            up8 = min_of(up8, round, now_ns() - tu8);
            round = round + 1;
        }
        chk = chk + load64(out + 8 * 999);
        if (f8 == 0) { report_el("e4m3 pack    : ", n, pk8); report_el("e4m3 unpack  : ", n, up8); }
        if (f8 == 1) { report_el("e5m2 pack    : ", n, pk8); report_el("e5m2 unpack  : ", n, up8); }
        f8 = f8 + 1;
    }
    var q4 = alloc(tula_int4_bytes(n));
    var q4s = alloc(tula_int4_blocks(n, TULA_INT4_BLOCK) * 8);
    var q4p = 0;
    var q4u = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var tq = now_ns();
        tula_int4_pack(sig, n, TULA_INT4_BLOCK, q4s, q4);
        q4p = min_of(q4p, round, now_ns() - tq);
        var tq2 = now_ns();
        tula_int4_unpack(q4, q4s, n, TULA_INT4_BLOCK, out);
        q4u = min_of(q4u, round, now_ns() - tq2);
        round = round + 1;
    }
    chk = chk + load64(out + 8 * 31337);
    report_el("int4 pack    : ", n, q4p);
    report_el("int4 unpack  : ", n, q4u);

    # ---- long names (1.3.0): 256 LoRA-style names over 47 chars ----
    var lnames = alloc(BN_FIND_N * 8);
    var lb = tula_builder_new();
    var lpre = "base_model.model.model.layers.";
    var lsuf = ".self_attn.q_proj.lora_A.weight";
    var li = 0;
    var lamin = 0;
    var t6l = now_ns();
    while (li < BN_FIND_N) {
        var lnm = alloc(96);
        var lk = 0;
        while (load8(lpre + lk) != 0) { store8(lnm + lk, load8(lpre + lk)); lk = lk + 1; }
        lk = lk + put_dec(lnm + lk, li);
        var ls = 0;
        while (load8(lsuf + ls) != 0) { store8(lnm + lk, load8(lsuf + ls)); lk = lk + 1; ls = ls + 1; }
        store8(lnm + lk, 0);
        store64(lnames + li * 8, lnm);
        tula_builder_add_long(lb, lnm, TULA_DT_F64, shape1, 1, d1, 8);
        li = li + 1;
    }
    lamin = now_ns() - t6l;
    report_op("add (long)   : ", BN_FIND_N, lamin);
    var lr = tula_builder_finish(lb);
    var lfmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t7l = now_ns();
        var lq = 0;
        while (lq < BN_FIND_N) {
            if (tula_find_name(lr, load64(lnames + lq * 8)) == 0) { sput("find_name MISSED\n"); return 1; }
            lq = lq + 1;
        }
        lfmin = min_of(lfmin, round, now_ns() - t7l);
        round = round + 1;
    }
    report_op("find_name(L) : ", BN_FIND_N, lfmin);

    # ---- the name index (1.5.0): build once, then O(log n) lookups ----
    var ibmin = 0;
    var ix = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        if (ix != 0) { tula_index_free(ix); }
        var tib = now_ns();
        ix = tula_index_new(lr);
        ibmin = min_of(ibmin, round, now_ns() - tib);
        round = round + 1;
    }
    report_op("index new(L) : ", 1, ibmin);
    var ilmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var til = now_ns();
        var iq = 0;
        while (iq < BN_FIND_N) {
            if (tula_index_find(ix, load64(lnames + iq * 8)) == 0) { sput("index MISSED\n"); return 1; }
            iq = iq + 1;
        }
        ilmin = min_of(ilmin, round, now_ns() - til);
        round = round + 1;
    }
    report_op("index find(L): ", BN_FIND_N, ilmin);
    tula_index_free(ix);
    var ixs = tula_index_new(fr);
    var ismin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var tis = now_ns();
        var sq = 0;
        while (sq < BN_FIND_N) {
            if (tula_index_find(ixs, load64(names + sq * 8)) == 0) { sput("index MISSED\n"); return 1; }
            sq = sq + 1;
        }
        ismin = min_of(ismin, round, now_ns() - tis);
        round = round + 1;
    }
    report_op("index find(S): ", BN_FIND_N, ismin);
    tula_index_free(ixs);

    # ---- metadata (1.6.0): 64 pairs set, then each read back by key ----
    var mkeys = alloc(64 * 8);
    var mb = tula_builder_new();
    var mi = 0;
    var t9a = now_ns();
    while (mi < 64) {
        var mk = alloc(32);
        var mkl = cat_into(mk, "bench.key.");
        mkl = mkl + put_dec(mk + mkl, (mi * 37) % 64);
        store8(mk + mkl, 0);
        store64(mkeys + mi * 8, mk);
        var mv = "{\"value\": \"some config text\"}";
        if (tula_builder_set_meta(mb, mk, mv) != 0) { sput("set_meta FAILED\n"); return 1; }
        mi = mi + 1;
    }
    var t9b = now_ns();
    report_op("meta set (64): ", 64, t9b - t9a);
    var mr = tula_builder_finish(mb);
    var mgmin = 0;
    round = 0;
    while (round < BN_ROUNDS) {
        var t9c = now_ns();
        var mq = 0;
        while (mq < 64) {
            if (tula_meta_get(mr, load64(mkeys + mq * 8)) == 0) { sput("meta_get MISSED\n"); return 1; }
            mq = mq + 1;
        }
        mgmin = min_of(mgmin, round, now_ns() - t9c);
        round = round + 1;
    }
    report_op("meta get (64): ", 64, mgmin);

    # ---- scaling: 4,096 tensors, every name looked up once ----
    var bigb = tula_builder_new_cap(4096);
    var bnames = alloc(4096 * 8);
    var bi = 0;
    while (bi < 4096) {
        var bnm = alloc(48);
        var bk = cat_into(bnm, "model.layers.");
        bk = bk + put_dec(bnm + bk, bi);
        store8(bnm + bk, 0);
        cat_into(bnm + bk, ".mlp.up_proj.weight");
        store64(bnames + bi * 8, bnm);
        tula_builder_add(bigb, bnm, TULA_DT_F64, shape1, 1, d1, 8);
        bi = bi + 1;
    }
    var bigr = tula_builder_finish(bigb);
    var t8a = now_ns();
    bi = 0;
    while (bi < 4096) { chk = chk + tula_find_name(bigr, load64(bnames + bi * 8)); bi = bi + 1; }
    var t8b = now_ns();
    var bix = tula_index_new(bigr);
    bi = 0;
    while (bi < 4096) { chk = chk + tula_index_find(bix, load64(bnames + bi * 8)); bi = bi + 1; }
    var t8c = now_ns();
    tula_index_free(bix);
    sput("all 4096 by find_name: ");
    fmt_int((t8b - t8a) / 1000);
    sput(" us   by index (build incl.): ");
    fmt_int((t8c - t8b) / 1000);
    sput(" us\n");

    sput("checksum: ");
    fmt_int(chk);
    sput(" (ignore; anti-DCE)\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
