# programs/fuzz.cyr — tula reader fuzz harness (M4). Feeds mutated + random bytes
# through tula_open, every accessor, and tula_verify, asserting the M3 hardening
# invariants hold under a flood of hostile input:
#
#   1. no crash (the process running to completion is the proof), and
#   2. whenever tula_open succeeds, the buffer is genuinely valid — re-validation
#      agrees, and every entry's payload range stays inside [buf, buf+len).
#   3. (1.1.2) the consumer discipline holds: for every accepted entry that
#      tula_entry_payload_ok passes, the dtype's unpack helper reads only bytes
#      inside the buffer.
#   4. (1.2.0) tula_validate_strict never accepts what it shouldn't: on every
#      buffer tula_open accepts it runs too, and when it says TULA_OK a brute-force
#      check must agree — exact length, every entry's data_len equal to its
#      dtype's packed length, no two names equal. Phase E feeds it a 40-tensor
#      canonical file (past the 32-tensor pairwise threshold, so the heapsort
#      duplicate check runs) with duplicate names injected.
#   5. (1.3.0) long names never read out of bounds and never resolve wrongly:
#      tula_entry_full_name runs on every entry of every accepted buffer (its
#      result is scanned to the NUL under the guard page), and on a strict
#      accept, tula_find_name(tula_entry_full_name(e)) must be e for every
#      entry. Phase F mutates a canonical file holding a names table.
#   6. (1.5.0) the name index agrees with the scan: on every accepted buffer an
#      index is built and tula_index_find must equal tula_find_name for each
#      entry's full name and stored name, and for a long probe.
#   7. (1.6.0) metadata never reads out of bounds: every accepted buffer's pairs
#      are walked (keys and values scanned to their NUL under the guard page,
#      tula_meta_get per key). On a strict accept, brute force must agree: keys
#      strictly increasing, get(key_i) == value_i, no NUL and no never-valid
#      UTF-8 byte (C0, C1, F5..FF) in a value. Phase G mutates a canonical file
#      holding metadata AND a names table, aiming at the metadata.
#   8. (1.6.1) the streaming writers write exactly what finish returns. Phase H
#      builds random builders (all three adds, every dtype and an unknown one,
#      0..8 dims, short, colliding and long names, refused adds, metadata, a
#      tensor past the 64 KiB staging buffer now and then) and writes each with
#      tula_builder_write_file or _signed, through the nameless O_TMPFILE path or
#      the named temp at random. The file must equal tula_builder_finish(_signed)
#      byte for byte, and a builder fed only canonical adds must give a file
#      tula_validate_strict accepts. No temp file may be left behind.
#   9. (1.7.0) the integer and boolean dtypes (ADR 0009): the consumer discipline
#      reads every element of each I16/I32/I64/U8/BOOL entry payload_ok passes,
#      and on a strict accept brute force must find every BOOL byte 0 or 1.
#      Phase I mutates a canonical file holding all five, aiming at the BOOL
#      payloads, the dtype fields and the shapes. Phase H's builders use them
#      too: a BOOL payload comes from a pool of 0/1 bytes, or now and then from
#      random bytes (then the builder doesn't count as canonical).
#  10. (1.8.0) FP8 (E4M3, E5M2) and INT4 (ADRs 0010, 0011): the consumer
#      discipline unpacks each with its helper (INT4 with TULA_INT4_BLOCK
#      scales); on a strict accept, brute force must find an odd-length INT4's
#      last high nibble zero. Phase I's file holds them too, and phase H's
#      builders draw them (an odd INT4 with a set last high nibble isn't
#      counted canonical). (1.12.0) UINT4 (ADR 0015) likewise: unpacked with
#      TULA_INT4_BLOCK scales and minimums, its odd count's last high nibble
#      checked on a strict accept, in phase I's file and phase H's builders.
#  11. (1.9.0) the parallel unpack (ADR 0012) is the serial helper, bit for
#      bit, and reads nothing past its inputs. Phase J draws a dtype with an
#      unpack helper, a count up to five chunks, a block, odd ones included,
#      and 1..9 threads. The payload and the scales each end exactly at a guard
#      page, so a slice that starts or ends a byte or a block wrong faults. The
#      output must equal the serial helper's, with the word after it untouched.
#  12. (1.11.0) shard sets (ADR 0014). Phase K mutates a canonical manifest,
#      mostly inside its tula.shards list (digits, hex letters, spaces,
#      newlines, '/', '.', uppercase hex), and the strict validator's verdict on
#      the list must match the fuzzer's own reading of it. On disk, a real
#      signed set has one byte of one shard changed, or a shard cut short, and
#      tula_set_open must refuse every one (mapped or protected, 1-4 threads).
#
# Every buffer under test is placed so it ENDS at a PROT_NONE guard page, so a
# read past `len` — by the validator, an accessor, tula_verify or an unpack —
# is a SIGSEGV, not a silent over-read. Invariant 1 therefore proves no read
# past the end, not only that the bounds arithmetic agreed.
#
# Deterministic LCG PRNG (fixed seed) -> fully reproducible. Cheap paths run well
# past 10^6 iterations; the expensive signature-verify path runs at lower count.
#
#   cyrius build programs/fuzz.cyr build/tula_fuzz && ./build/tula_fuzz

include "src/lib.cyr"

enum FuzzCfg {
    FZ_MUT_ITERS    = 1000000;   # structured mutation of a valid buffer
    FZ_RAND_ITERS   = 1000000;   # pure random bytes
    FZ_SIGNED_ITERS = 3000;      # mutate a signed buffer + tula_verify (expensive)
    FZ_STRICT_ITERS = 300000;    # phase E: a 40-tensor canonical file, names duplicated
    FZ_STRICT_N     = 40;
    FZ_LONG_ITERS   = 300000;    # phase F: a long-name file, mutations aimed at its table
    FZ_META_ITERS   = 300000;    # phase G: a metadata + names file, mutations aimed at the metadata
    FZ_WRITE_ITERS  = 1500;      # phase H: random builders through the streaming writers
    FZ_INT_ITERS    = 300000;    # phase I: the 1.7.0 dtypes, mutations aimed at BOOL bytes, dtypes, shapes
    FZ_PAR_ITERS    = 400;       # phase J: parallel unpacks against the serial helpers (1.9.0)
    FZ_PAR_MAXN     = 327680;    # phase J: the most elements per unpack (5 x TULA_PAR_MIN_CHUNK)
    FZ_SHARD_ITERS  = 200000;    # phase K: mutations of a manifest's shard list (1.11.0)
    FZ_SET_ITERS    = 300;       # phase K: corrupted shards on disk, each set refused
    FZ_POOL         = 135168;    # phase H: random payload bytes (> the 64 KiB stage + 60000)
    FZ_MAXBUF       = 8192;
    FZ_GUARD_SPAN   = 16384;     # readable bytes before the guard (>= FZ_MAXBUF + 64)
    FZ_OUT_ELEMS    = 33024;     # 4 * (FZ_MAXBUF + 64): the most trits a buffer can hold
    FZ_SCALES       = 1040;      # f64 block scales, >= FZ_OUT_ELEMS / 32 (INT4 / UINT4; was 1024)
}

# ---- output helpers -------------------------------------------------------
fn sput(s): i64 {
    syscall(1, 1, s, strlen(s));
    return 0;
}
fn kv(label, n): i64 {
    sput(label);
    fmt_int(n);
    sput("\n");
    return 0;
}

# ---- PRNG: an LCG state (Knuth/PCG constants; i64 multiply wraps mod 2^64)
# whose outputs pass through the splitmix64 finalizer. Until 1.2.0 the raw state
# was returned, and a power-of-two LCG's low bits have tiny periods (bit k
# repeats every 2^(k+1) draws), so every `rng_below(s, small)` choice — mutation
# kind, offset, value class — followed a short fixed pattern. Mixing spreads
# the high bits' quality into every bit.
fn srl(x, k): i64 {
    return (x >> k) & ((1 << (64 - k)) - 1);   # logical shift right (>> is arithmetic)
}
fn rng_next(s): i64 {
    var x = load64(s);
    x = x * 6364136223846793005 + 1442695040888963407;
    store64(s, x);
    var z = (x ^ srl(x, 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ srl(z, 27)) * 0x94D049BB133111EB;
    return z ^ srl(z, 31);
}
fn rng_below(s, n): i64 {
    if (n <= 0) { return 0; }
    var v = rng_next(s) & 0x7FFFFFFFFFFFFFFF;
    return v % n;
}

# ---- a valid unsigned buffer (2 tensors), copied into scratch each iter ----
fn build_valid(): i64 {
    var shapeA = alloc(16);
    store64(shapeA + 0, 2);
    store64(shapeA + 8, 3);
    var dataA = alloc(48);
    var i = 0;
    while (i < 6) { store64(dataA + i * 8, 1000 + i); i = i + 1; }
    var shapeB = alloc(8);
    store64(shapeB + 0, 4);
    var dataB = alloc(4);
    store8(dataB + 0, 10);
    store8(dataB + 1, 20);
    store8(dataB + 2, 30);
    store8(dataB + 3, 40);
    var b = tula_builder_new();
    tula_builder_add(b, "w.q", TULA_DT_F64, shapeA, 2, dataA, 48);
    tula_builder_add(b, "b0", TULA_DT_INT8, shapeB, 1, dataB, 4);
    return tula_builder_finish(b);
}

fn build_signed(sk): i64 {
    var shape = alloc(8);
    store64(shape + 0, 3);
    var data = alloc(24);
    var j = 0;
    while (j < 3) { store64(data + j * 8, 7 + j); j = j + 1; }
    var b = tula_builder_new();
    tula_builder_add(b, "w", TULA_DT_F64, shape, 1, data, 24);
    return tula_builder_finish_signed(b, sk);
}

fn memcpy_n(dst, src, n): i64 {
    var i = 0;
    while (i < n) { store8(dst + i, load8(src + i)); i = i + 1; }
    return 0;
}

# The address of a PROT_NONE page with FZ_GUARD_SPAN readable bytes before it,
# or 0 if the mapping or mprotect fails.
fn guard_region(): i64 {
    var base = mmap_anon(FZ_GUARD_SPAN + 4096);
    if (base == 0) { return 0; }
    if (cyr_mprotect(base + FZ_GUARD_SPAN, 4096, PROT_NONE) != 0) { return 0; }
    return base + FZ_GUARD_SPAN;
}

# Copy `len` bytes of `src` so they end exactly at `guard`; returns the start.
fn place(guard, src, len): i64 {
    var p = guard - len;
    memcpy_n(p, src, len);
    return p;
}

# The bytes n elements of dtype dt take, from the fuzzer's own table (1.7.0), so
# a wrong width in tula_packed_len can't hide behind itself: payload_ok and the
# brute-force strict check are both held to it. -1 for an unknown dtype.
fn oracle_len(dt, n): i64 {
    if (dt == 0) { return n * 8; }          # f64
    if (dt == 1) { return n; }              # int8
    if (dt == 2) { return (n + 3) / 4; }    # ternary, 4 per byte
    if (dt == 3) { return (n + 1) / 2; }    # nf4, 2 per byte
    if (dt == 4) { return n * 4; }          # f32
    if (dt == 5) { return n * 2; }          # f16
    if (dt == 6) { return n * 2; }          # bf16
    if (dt == 7) { return n * 2; }          # i16
    if (dt == 8) { return n * 4; }          # i32
    if (dt == 9) { return n * 8; }          # i64
    if (dt == 10) { return n; }             # u8
    if (dt == 11) { return n; }             # bool
    if (dt == 12) { return n; }             # f8 e4m3
    if (dt == 13) { return n; }             # f8 e5m2
    if (dt == 14) { return (n + 1) / 2; }   # int4, 2 per byte
    if (dt == 15) { return (n + 1) / 2; }   # uint4, 2 per byte (1.12.0)
    return 0 - 1;
}

# The consumer discipline on an opened buffer: every entry tula_entry_payload_ok
# passes is unpacked with its dtype's helper (f64 is read word by word). Returns
# the number of entries unpacked; an element count the guard said was safe but
# that exceeds what the buffer can hold, or (1.7.0) a data_len shorter than the
# oracle's size for the shape, is an invariant breach (st + 16).
fn consume(r, st, out, scl): i64 {
    var done = 0;
    var c = tula_count(r);
    var i = 0;
    while (i < c) {
        var e = tula_entry(r, i);
        var dt = tula_entry_dtype(e);
        var nd = tula_entry_ndim(e);
        var known = 0;
        if (dt >= TULA_DT_F64) { if (dt <= TULA_DT_UINT4) { known = 1; } }
        if (known == 1) {
            if (nd > 0) {
                if (tula_entry_payload_ok(e) == 1) {
                    var n = 1;
                    var k = 0;
                    while (k < nd) { n = n * tula_entry_dim(e, k); k = k + 1; }
                    if (tula_entry_data_len(e) < oracle_len(dt, n)) { store64(st + 16, load64(st + 16) + 1); }
                    if (n > FZ_OUT_ELEMS) {
                        store64(st + 16, load64(st + 16) + 1);
                    } else {
                        var p = tula_entry_data(r, e);
                        if (dt == TULA_DT_F64) {
                            var sum = 0;
                            var w = 0;
                            while (w < n) { sum = sum + load64(p + w * 8); w = w + 1; }
                            store64(out, sum);
                        }
                        if (dt == TULA_DT_INT8)    { tula_int8_dequant(p, n, f64_from(1), out); }
                        if (dt == TULA_DT_TERNARY) { tula_ternary_unpack(p, n, out); }
                        if (dt == TULA_DT_NF4)     { tula_nf4_unpack(p, scl, n, TULA_NF4_BLOCK, out); }
                        if (dt == TULA_DT_F32)     { tula_f32_unpack(p, n, out); }
                        if (dt == TULA_DT_F16)     { tula_f16_unpack(p, n, out); }
                        if (dt == TULA_DT_BF16)    { tula_bf16_unpack(p, n, out); }
                        if (dt == TULA_DT_F8_E4M3) { tula_e4m3_unpack(p, n, out); }   # 1.8.0
                        if (dt == TULA_DT_F8_E5M2) { tula_e5m2_unpack(p, n, out); }
                        if (dt == TULA_DT_INT4)    { tula_int4_unpack(p, scl, n, TULA_INT4_BLOCK, out); }
                        if (dt == TULA_DT_UINT4)   { tula_uint4_unpack(p, scl, scl, n, TULA_INT4_BLOCK, out); }
                        if (dt >= TULA_DT_I16) {
                            if (dt <= TULA_DT_BOOL) {
                                # 1.7.0: raw integers and bools; every element is read
                                var wd = tula_packed_len(dt, 1);
                                var acc = 0;
                                var x = 0;
                                while (x < n) {
                                    if (wd == 1) { acc = acc + load8(p + x); }
                                    if (wd == 2) { acc = acc + load16(p + x * 2); }
                                    if (wd == 4) { acc = acc + load32(p + x * 4); }
                                    if (wd == 8) { acc = acc + load64(p + x * 8); }
                                    x = x + 1;
                                }
                                store64(out, acc);
                            }
                        }
                        done = done + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return done;
}

# Apply 1..6 random mutations to `scratch` over its first `len0` bytes.
fn mutate(s, scratch, len0): i64 {
    var nmut = 1 + rng_below(s, 6);
    var k = 0;
    while (k < nmut) {
        var kind = rng_below(s, 3);
        if (kind == 0) {
            store8(scratch + rng_below(s, len0), rng_below(s, 256));
        }
        if (kind == 1) {
            store64(scratch + rng_below(s, len0 / 8) * 8, rng_next(s));
        }
        if (kind == 2) {
            var w = rng_below(s, len0 / 8) * 8;
            var pick = rng_below(s, 5);
            var val = 0;
            if (pick == 1) { val = 0 - 1; }
            if (pick == 2) { val = 0x7FFFFFFFFFFFFFFF; }
            if (pick == 3) { val = len0; }
            if (pick == 4) { val = 0x1000000000000; }
            store64(scratch + w, val);
        }
        k = k + 1;
    }
    return 0;
}

# A canonical file with a names table: 6 long names (LoRA / MoE style) and 2 short.
fn build_long_base(): i64 {
    var b = tula_builder_new();
    var shape = alloc(8);
    store64(shape, 2);
    var data = alloc(8);
    store8(data, 1);
    store8(data + 1, 2);
    var nm = alloc(96);
    var pre = "base_model.model.model.layers.";
    var i = 0;
    while (i < 6) {
        var k = 0;
        while (load8(pre + k) != 0) { store8(nm + k, load8(pre + k)); k = k + 1; }
        store8(nm + k, 48 + i);
        var suf = ".self_attn.q_proj.lora_A.weight";
        if ((i & 1) == 1) { suf = ".mlp.block_sparse_moe.experts.3.w2.weight"; }
        var j = 0;
        while (load8(suf + j) != 0) { store8(nm + k + 1 + j, load8(suf + j)); j = j + 1; }
        store8(nm + k + 1 + j, 0);
        tula_builder_add_long(b, nm, TULA_DT_INT8, shape, 1, data, 2);
        i = i + 1;
    }
    tula_builder_add_long(b, "bias", TULA_DT_F16, shape, 1, data, 4);
    tula_builder_add_long(b, "norm", TULA_DT_BF16, shape, 1, data, 4);
    return tula_builder_finish(b);
}

# A canonical file with metadata (6 pairs, some multi-byte UTF-8) and a names table.
fn build_meta_base(): i64 {
    var b = tula_builder_new();
    var shape = alloc(8);
    store64(shape, 2);
    var data = alloc(8);
    var lname = "base_model.model.model.layers.0.self_attn.q_proj.lora_A.weight";
    tula_builder_add_long(b, lname, TULA_DT_INT8, shape, 1, data, 2);
    tula_builder_add_long(b, "bias", TULA_DT_INT8, shape, 1, data, 2);
    var cjk = alloc(8);
    store8(cjk, 0xE6); store8(cjk + 1, 0x97); store8(cjk + 2, 0xA5); store8(cjk + 3, 0);
    tula_builder_set_meta(b, "hf.architecture", "LlamaForCausalLM");
    tula_builder_set_meta(b, "hf.config", "{\"hidden_size\": 4096, \"num_layers\": 32}");
    tula_builder_set_meta(b, "anukulana.source", "model.safetensors");
    tula_builder_set_meta(b, "license", "llama2");
    tula_builder_set_meta(b, "note.cjk", cjk);
    tula_builder_set_meta(b, "peft.r", "16");
    return tula_builder_finish(b);
}

# A canonical file with the 1.7.0 dtypes (ADR 0009): i64 [6], i32 [2,4], i16 [5],
# u8 [7], bool [3,5], a 0-dim bool, an f16 [3] beside them, and (1.8.0) e4m3 [5],
# e5m2 [3], int4 [7] (odd: its last high nibble zero) and int4 [4].
fn build_int_base(): i64 {
    var b = tula_builder_new();
    var sh = alloc(16);
    var d = alloc(128);
    var k = 0;
    while (k < 128) {
        store8(d + k, (k * 37 + 11) & 0xFF);
        k = k + 1;
    }
    var bl = alloc(16);
    k = 0;
    while (k < 16) {
        store8(bl + k, k & 1);
        k = k + 1;
    }
    store64(sh, 6);
    tula_builder_add_checked(b, "ids", TULA_DT_I64, sh, 1, d, 48);
    store64(sh, 2);
    store64(sh + 8, 4);
    tula_builder_add_checked(b, "qweight", TULA_DT_I32, sh, 2, d, 32);
    store64(sh, 5);
    tula_builder_add_checked(b, "codes", TULA_DT_I16, sh, 1, d, 10);
    store64(sh, 7);
    tula_builder_add_checked(b, "bytes", TULA_DT_U8, sh, 1, d, 7);
    store64(sh, 3);
    store64(sh + 8, 5);
    tula_builder_add_checked(b, "mask", TULA_DT_BOOL, sh, 2, bl, 15);
    tula_builder_add_checked(b, "flag", TULA_DT_BOOL, sh, 0, bl + 1, 1);
    store64(sh, 3);
    tula_builder_add_checked(b, "w", TULA_DT_F16, sh, 1, d, 6);
    store64(sh, 5);
    tula_builder_add_checked(b, "fp8", TULA_DT_F8_E4M3, sh, 1, d, 5);
    store64(sh, 3);
    tula_builder_add_checked(b, "fp8b", TULA_DT_F8_E5M2, sh, 1, d, 3);
    var q4 = alloc(8);
    store64(q4, 0x0000000003A9F17B);   # 7 codes: the 4th byte's high nibble zero
    store64(sh, 7);
    tula_builder_add_checked(b, "q4", TULA_DT_INT4, sh, 1, q4, 4);
    store64(sh, 4);
    tula_builder_add_checked(b, "q4e", TULA_DT_INT4, sh, 1, d, 2);
    store64(sh, 7);
    tula_builder_add_checked(b, "u4", TULA_DT_UINT4, sh, 1, q4, 4);   # 1.12.0
    store64(sh, 4);
    tula_builder_add_checked(b, "u4e", TULA_DT_UINT4, sh, 1, d, 2);
    return tula_builder_finish(b);
}

# FZ_STRICT_N int8 [1] tensors "t00".."t39", through the checked add: canonical.
fn build_strict_base(): i64 {
    var b = tula_builder_new();
    var shape = alloc(8);
    store64(shape, 1);
    var data = alloc(8);
    store8(data, 7);
    var nm = alloc(8);
    var i = 0;
    while (i < FZ_STRICT_N) {
        store8(nm, 116);
        store8(nm + 1, 48 + i / 10);
        store8(nm + 2, 48 + i % 10);
        store8(nm + 3, 0);
        tula_builder_add_checked(b, nm, TULA_DT_INT8, shape, 1, data, 1);
        i = i + 1;
    }
    return tula_builder_finish(b);
}

# Invariant 4: run the strict validator on an opened buffer; when it accepts,
# check by brute force that it was right. st+56 counts strict accepts, st+64
# strict DUP_NAME verdicts, st+96 strict VALUE verdicts (1.7.0), st+16 breaches.
fn strict_check(r, len, st): i64 {
    var rc = tula_validate_strict(r, len);
    if (rc == TULA_ERR_DUP_NAME) { store64(st + 64, load64(st + 64) + 1); }
    if (rc == TULA_ERR_VALUE) { store64(st + 96, load64(st + 96) + 1); }
    if (rc != TULA_OK) { return 0; }
    store64(st + 56, load64(st + 56) + 1);
    var ok = 1;
    if (len != tula_total_len(r)) { ok = 0; }
    var c = tula_count(r);
    var i = 0;
    while (i < c) {
        var e = tula_entry(r, i);
        if (tula_find_name(r, tula_entry_full_name(r, e)) != e) { ok = 0; }
        var n = tula_entry_nelems(e);
        if (n < 0) { ok = 0; }
        if (tula_entry_data_len(e) != tula_packed_len(tula_entry_dtype(e), n)) { ok = 0; }
        if (tula_entry_data_len(e) != oracle_len(tula_entry_dtype(e), n)) { ok = 0; }
        if (tula_entry_dtype(e) == TULA_DT_INT4 || tula_entry_dtype(e) == TULA_DT_UINT4) {
            if ((n & 1) == 1) {
                if ((load8(tula_entry_data(r, e) + tula_entry_data_len(e) - 1) >> 4) != 0) { ok = 0; }
            }
        }
        if (tula_entry_dtype(e) == TULA_DT_BOOL) {
            var bp = tula_entry_data(r, e);
            var bl = tula_entry_data_len(e);
            var bz = 0;
            while (bz < bl) {
                if (load8(bp + bz) > 1) { ok = 0; }
                bz = bz + 1;
            }
        }
        var j = i + 1;
        while (j < c) {
            if (streq(tula_entry_name(e), tula_entry_name(tula_entry(r, j)))) { ok = 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    # metadata, brute force
    var np = tula_meta_count(r);
    var q = 0;
    while (q < np) {
        var mk = tula_meta_key(r, q);
        var mv = tula_meta_value(r, q);
        if (mk == 0) { ok = 0; }
        if (mv == 0) { ok = 0; }
        if (mk != 0) {
            if (mv != 0) {
                if (tula_meta_get(r, mk) != mv) { ok = 0; }
                var vl = strlen(mv);
                var z = 0;
                while (z < vl) {
                    var vb = load8(mv + z);
                    if (vb == 0xC0) { ok = 0; }
                    if (vb == 0xC1) { ok = 0; }
                    if (vb >= 0xF5) { ok = 0; }
                    z = z + 1;
                }
                if (q > 0) {
                    var pkey = tula_meta_key(r, q - 1);
                    if (pkey != 0) {
                        if (_tula_bytes_cmp(pkey, strlen(pkey), mk, strlen(mk)) >= 0) { ok = 0; }
                    }
                }
            }
        }
        q = q + 1;
    }
    if (ok == 0) { store64(st + 16, load64(st + 16) + 1); }
    return 0;
}

# When tula_open succeeds the buffer MUST be genuinely valid: re-validation
# agrees, and every accessor stays inside [r, r+len). Returns 1 if sound, else 0.
fn check_opened(r, len): i64 {
    var ok = 1;
    if (tula_validate(r, len) != TULA_OK) { ok = 0; }
    var c = tula_count(r);
    var i = 0;
    while (i < c) {
        var e = tula_entry(r, i);
        if (e + TULA_ENTRY_SIZE > r + len) { ok = 0; }
        var dlen = tula_entry_data_len(e);
        var dptr = tula_entry_data(r, e);
        if (dptr < r) { ok = 0; }
        if (dptr + dlen > r + len) { ok = 0; }
        # touch metadata + payload edges — must be in-bounds, no crash
        var dt = tula_entry_dtype(e);
        var nd = tula_entry_ndim(e);
        if (nd > 0) { var d0 = tula_entry_dim(e, 0); }
        if (dlen > 0) {
            var b0 = load8(dptr);
            var b1 = load8(dptr + dlen - 1);
        }
        # the full name, scanned to its NUL: under the guard page an over-read faults
        var fname = tula_entry_full_name(r, e);
        var fl = strlen(fname);
        if (fname != e) {
            if (fname < r) { ok = 0; }
            if (fname + fl >= r + len) { ok = 0; }
        }
        i = i + 1;
    }
    # metadata: walk every pair under the guard page
    var mc = tula_meta_count(r);
    var mq = 0;
    while (mq < mc) {
        var kq = tula_meta_key(r, mq);
        var vq = tula_meta_value(r, mq);
        if (kq != 0) {
            var kl = strlen(kq);
            if (kq < r) { ok = 0; }
            if (kq + kl >= r + len) { ok = 0; }
            var gq = tula_meta_get(r, kq);
        }
        if (vq != 0) {
            var vlq = strlen(vq);
            if (vq + vlq >= r + len) { ok = 0; }
        }
        mq = mq + 1;
    }
    var mmiss = tula_meta_get(r, "hf.architecture");
    var probe = "base_model.model.model.layers.3.mlp.block_sparse_moe.experts.3.w2.weight";
    var lhit = tula_find_name(r, probe);
    var has = tula_has_long_names(r);
    var ix = tula_index_new(r);
    if (ix == 0) { ok = 0; }
    if (ix != 0) {
        if (tula_index_find(ix, probe) != lhit) { ok = 0; }
        var j = 0;
        while (j < c) {
            var ej = tula_entry(r, j);
            var fj = tula_entry_full_name(r, ej);
            if (tula_index_find(ix, fj) != tula_find_name(r, fj)) { ok = 0; }
            if (tula_index_find(ix, ej) != tula_find_name(r, ej)) { ok = 0; }
            j = j + 1;
        }
        tula_index_free(ix);
    }
    # exercise find() with a name that may or may not exist
    var hit = tula_find(r, "w.q");
    var sig = tula_is_signed(r);
    return ok;
}

# ---- phase H helpers: random builders ------------------------------------

# A random NUL-terminated name in nm: usually 1..6 chars of a 6-letter alphabet
# (so names collide), sometimes a long one sharing a 33-byte prefix (so long
# names share their key's first 30 bytes and differ only in the hash).
fn rand_name(s, nm): i64 {
    var alpha = "ab._x0";
    var n = 0;
    if (rng_below(s, 4) == 0) {
        var pre = "base_model.model.model.layers.0.";
        while (load8(pre + n) != 0) { store8(nm + n, load8(pre + n)); n = n + 1; }
        var tail = 1 + rng_below(s, 80);
        var t = 0;
        while (t < tail) { store8(nm + n, load8(alpha + rng_below(s, 6))); n = n + 1; t = t + 1; }
    } else {
        var len = 1 + rng_below(s, 6);
        while (n < len) { store8(nm + n, load8(alpha + rng_below(s, 6))); n = n + 1; }
    }
    store8(nm + n, 0);
    return n;
}

# A random shape in `shape`: 0..3 dims of 0..5 (a zero now and then), or 8 dims
# of 1..2. Returns ndim; the element count goes to *ne.
fn rand_shape(s, shape, ne): i64 {
    var nd = rng_below(s, 4);
    if (rng_below(s, 32) == 0) { nd = 8; }
    var n = 1;
    var k = 0;
    while (k < nd) {
        var d = 1 + rng_below(s, 5);
        if (rng_below(s, 16) == 0) { d = 0; }
        if (nd == 8) { d = 1 + rng_below(s, 2); }
        store64(shape + k * 8, d);
        n = n * d;
        k = k + 1;
    }
    store64(ne, n);
    return nd;
}

# A random metadata value in vb: 0..40 bytes of ASCII, two- and three-byte UTF-8,
# and (one value in 20) a byte that is never valid UTF-8, which set_meta refuses.
fn rand_value(s, vb): i64 {
    var n = rng_below(s, 40);
    var i = 0;
    while (i < n) {
        var pick = rng_below(s, 10);
        if (pick == 0) {
            store8(vb + i, 0xC3);
            store8(vb + i + 1, 0xA9);
            i = i + 2;
        }
        if (pick == 1) {
            store8(vb + i, 0xE6);
            store8(vb + i + 1, 0x97);
            store8(vb + i + 2, 0xA5);
            i = i + 3;
        }
        if (pick >= 2) {
            store8(vb + i, 32 + rng_below(s, 95));
            i = i + 1;
        }
    }
    if (rng_below(s, 20) == 0) {
        store8(vb, 0xFF);
        if (i == 0) { i = 1; }
    }
    store8(vb + i, 0);
    return i;
}

# A random builder: up to 10 steps, each an add (plain, checked or long, in
# random proportion) or a metadata set, then, one builder in 24, an int8 tensor
# of 65536..125535 bytes. *canon = 1 when every add that succeeded was a checked
# or long add of a known dtype with its packed length (and, for BOOL, a payload
# from bpool's 0/1 bytes), so the file is canonical.
fn rand_builder(s, pool, bpool, nm, vb, shape, ne, canon): i64 {
    var b = tula_builder_new();
    if (rng_below(s, 10) == 0) { b = tula_builder_new_cap(1 + rng_below(s, 4)); }
    store64(canon, 1);
    var keys = alloc(64);
    store64(keys + 0, "hf.config");
    store64(keys + 8, "hf.architecture");
    store64(keys + 16, "license");
    store64(keys + 24, "a");
    store64(keys + 32, "z.9-_");
    store64(keys + 40, "tula.reserved");   # refused: reserved prefix
    store64(keys + 48, "9bad");            # refused: starts with a digit
    store64(keys + 56, "anukulana.source.sha256");
    var steps = rng_below(s, 11);
    var i = 0;
    while (i < steps) {
        if (rng_below(s, 5) == 0) {
            rand_value(s, vb);
            tula_builder_set_meta(b, load64(keys + rng_below(s, 8) * 8), vb);
        } else {
            rand_name(s, nm);
            var nd = rand_shape(s, shape, ne);
            var dt = rng_below(s, 17);                    # 16: no such dtype (1.12.0 took 15)
            var dl = tula_packed_len(dt, load64(ne));
            var exact = 1;
            if (dl < 0) { dl = rng_below(s, 64); exact = 0; }
            var kind = rng_below(s, 3);
            if (kind == 0) {
                if (rng_below(s, 2) == 0) { dl = rng_below(s, 300); exact = 0; }
            }
            var data = pool + rng_below(s, FZ_POOL - dl);
            if (dt == TULA_DT_BOOL) {
                if (rng_below(s, 8) == 0) { exact = 0; }   # random bytes: not canonical
                else { data = bpool + rng_below(s, FZ_POOL - dl); }
            }
            if (dt == TULA_DT_INT4 || dt == TULA_DT_UINT4) {
                # an odd count: canonical only if the last high nibble is zero
                if ((load64(ne) & 1) == 1) {
                    if (dl > 0) {
                        if ((load8(data + dl - 1) >> 4) != 0) { exact = 0; }
                    }
                }
            }
            var rc = 0;
            if (kind == 0) { rc = tula_builder_add(b, nm, dt, shape, nd, data, dl); }
            if (kind == 1) { rc = tula_builder_add_checked(b, nm, dt, shape, nd, data, dl); }
            if (kind == 2) { rc = tula_builder_add_long(b, nm, dt, shape, nd, data, dl); }
            if (rc == 0) {
                if (kind == 0) { store64(canon, 0); }
                if (exact == 0) { store64(canon, 0); }
            }
        }
        i = i + 1;
    }
    if (rng_below(s, 24) == 0) {
        var big = 65536 + rng_below(s, 60000);
        store64(shape, big);
        tula_builder_add_checked(b, "big", TULA_DT_INT8, shape, 1, pool + rng_below(s, FZ_POOL - big), big);
    }
    return b;
}

fn same_bytes(a, b, n): i64 {
    var i = 0;
    while (i + 8 <= n) {
        if (load64(a + i) != load64(b + i)) { return 0; }
        i = i + 8;
    }
    while (i < n) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ---- phase J helpers: the parallel unpack (1.9.0) ---------------------------

# The address of a PROT_NONE page with at least `span` readable bytes before it,
# or 0. mprotect needs a page-aligned address, and pages are 16 KiB on arm64
# macOS, so the span is rounded up to 64 KiB (a multiple of every page size in
# CI). The mapping's length is rounded up to a page by the kernel, so the
# protected page is inside it.
fn guard_span(span): i64 {
    var sp = ((span + 65535) / 65536) * 65536;
    var base = mmap_anon(sp + 4096);
    if (base == 0) { return 0; }
    if (cyr_mprotect(base + sp, 4096, PROT_NONE) != 0) { return 0; }
    return base + sp;
}

# The serial helper for dt, as tula_unpack_par documents it.
fn par_serial(dt, src, n, scales, block, dst): i64 {
    if (dt == TULA_DT_F32)     { return tula_f32_unpack(src, n, dst); }
    if (dt == TULA_DT_F16)     { return tula_f16_unpack(src, n, dst); }
    if (dt == TULA_DT_BF16)    { return tula_bf16_unpack(src, n, dst); }
    if (dt == TULA_DT_F8_E4M3) { return tula_e4m3_unpack(src, n, dst); }
    if (dt == TULA_DT_F8_E5M2) { return tula_e5m2_unpack(src, n, dst); }
    if (dt == TULA_DT_INT8)    { tula_int8_dequant(src, n, load64(scales), dst); return n; }
    if (dt == TULA_DT_NF4)     { return tula_nf4_unpack(src, scales, n, block, dst); }
    if (dt == TULA_DT_INT4)    { return tula_int4_unpack(src, scales, n, block, dst); }
    return tula_ternary_unpack(src, n, dst);
}

# Phase J: FZ_PAR_ITERS parallel unpacks, each against the serial helper, with
# the payload and the scales ending at guard pages. Returns the failures.
fn par_phase(s, st): i64 {
    var fails = 0;
    var pg = guard_span(FZ_PAR_MAXN * 4 + 4096);       # payloads: F32 is the widest
    var sg = guard_span(FZ_PAR_MAXN * 8 + 4096);       # scales: one per element at block 1
    if (pg == 0 || sg == 0) {
        sput("phase J: could not map its guard pages\n");
        return 1;
    }
    var pool = alloc(FZ_PAR_MAXN * 4);
    var k = 0;
    while (k < FZ_PAR_MAXN * 4) { store64(pool + k, rng_next(s)); k = k + 8; }
    var spool = alloc(FZ_PAR_MAXN * 8);
    k = 0;
    while (k < FZ_PAR_MAXN) {
        var r = rng_next(s);
        if ((r & 3) != 0) { r = (r & 0x800FFFFFFFFFFFFF) | ((1013 + ((r >> 2) & 15)) << 52); }
        store64(spool + k * 8, r);                     # mostly normal scales; any bits now and then
        k = k + 1;
    }
    var ref = alloc((FZ_PAR_MAXN + 1) * 8);
    var out = alloc((FZ_PAR_MAXN + 1) * 8);
    var dts[72];
    store64(&dts, TULA_DT_F32); store64(&dts + 8, TULA_DT_F16); store64(&dts + 16, TULA_DT_BF16);
    store64(&dts + 24, TULA_DT_F8_E4M3); store64(&dts + 32, TULA_DT_F8_E5M2);
    store64(&dts + 40, TULA_DT_INT8); store64(&dts + 48, TULA_DT_NF4);
    store64(&dts + 56, TULA_DT_INT4); store64(&dts + 64, TULA_DT_TERNARY);
    var it = 0;
    while (it < FZ_PAR_ITERS) {
        var dt = load64(&dts + rng_below(s, 9) * 8);
        var n = 1 + rng_below(s, FZ_PAR_MAXN);
        if (rng_below(s, 4) == 0) { n = 1 + rng_below(s, 3 * TULA_PAR_MIN_CHUNK); }
        var block = 0;
        var nsc = 0;
        if (dt == TULA_DT_NF4 || dt == TULA_DT_INT4) {
            block = 1 + rng_below(s, 300);
            if (rng_below(s, 3) == 0) { block = 32 + 32 * rng_below(s, 2); }
            if (rng_below(s, 20) == 0) { block = n / 2 + rng_below(s, n + 1); }   # one or two blocks
            if (block < 1) { block = 1; }
            nsc = (n + block - 1) / block;
        }
        if (dt == TULA_DT_INT8) { nsc = 1; }
        var plen = tula_packed_len(dt, n);
        var src = pg - plen;
        memcpy_n(src, pool, plen);
        var scales = sg - nsc * 8;
        memcpy_n(scales, spool, nsc * 8);
        var threads = 1 + rng_below(s, 9);
        par_serial(dt, src, n, scales, block, ref);
        store64(out + n * 8, 0x5A5A5A5A5A5A5A5A);
        var rc = tula_unpack_par(dt, src, n, scales, block, out, threads);
        var ok = 1;
        if (rc != n) { ok = 0; }
        if (load64(out + n * 8) != 0x5A5A5A5A5A5A5A5A) { ok = 0; }
        k = 0;
        while (k < n) {
            if (load64(out + k * 8) != load64(ref + k * 8)) { ok = 0; k = n; }
            k = k + 1;
        }
        if (ok == 0) { fails = fails + 1; }
        store64(st + 104, load64(st + 104) + 1);
        it = it + 1;
    }
    return fails;
}

# ---- phase K helpers: shard sets (1.11.0) ---------------------------------

# The fuzzer's own reading of a tula.shards value (ADR 0014), written apart from
# src/shard.cyr: the value is cut into lines first, then each line is read
# field by field. Returns the line count, or 0 when the value isn't canonical.
fn fz_shards_ok(v): i64 {
    var n = strlen(v);
    if (n == 0) { return 0; }
    if (load8(v + n - 1) != 10) { return 0; }
    var lines = 0;
    var start = 0;
    var prev = 0;
    var plen = 0;
    var i = 0;
    while (i < n) {
        if (load8(v + i) == 10) {
            var k = 0;
            while (k < 64) {
                if (start + k >= i) { return 0; }
                var h = load8(v + start + k);
                var okh = 0;
                if (h >= 48) { if (h <= 57) { okh = 1; } }
                if (h >= 97) { if (h <= 102) { okh = 1; } }
                if (okh == 0) { return 0; }
                k = k + 1;
            }
            var j = start + 64;
            if (j >= i) { return 0; }
            if (load8(v + j) != 32) { return 0; }
            j = j + 1;
            var ds = j;
            var size = 0;
            while (j < i) {
                var c = load8(v + j);
                if (c == 32) { break; }
                if (c < 48) { return 0; }
                if (c > 57) { return 0; }
                if (j - ds >= 13) { return 0; }
                size = size * 10 + c - 48;
                j = j + 1;
            }
            if (j == ds) { return 0; }
            if (j >= i) { return 0; }
            if (load8(v + ds) == 48) { return 0; }
            if (size < 64) { return 0; }
            if (size > TULA_READ_MAX_BYTES) { return 0; }
            j = j + 1;                              # past the space
            var nm = v + j;
            var nl = i - j;
            if (nl < 1) { return 0; }
            if (nl > 255) { return 0; }
            var q = 0;
            while (q < nl) {
                var b = load8(nm + q);
                if (b <= 32) { return 0; }
                if (b == 127) { return 0; }
                if (b == 47) { return 0; }
                if (b == 92) { return 0; }
                q = q + 1;
            }
            if (nl == 1) { if (load8(nm) == 46) { return 0; } }
            if (nl == 2) { if (load8(nm) == 46) { if (load8(nm + 1) == 46) { return 0; } } }
            if (lines > 0) {
                # strictly after the previous name, byte by byte, a prefix first
                var m = 0;
                var cmp = 0;
                while (m < plen) {
                    if (m >= nl) { cmp = 1; break; }
                    var x = load8(prev + m);
                    var y = load8(nm + m);
                    if (x < y) { cmp = 0 - 1; break; }
                    if (x > y) { cmp = 1; break; }
                    m = m + 1;
                }
                if (cmp == 0) {
                    if (plen >= nl) { return 0; }       # equal: a repeat
                } else {
                    if (cmp > 0) { return 0; }
                }
            }
            prev = nm;
            plen = nl;
            lines = lines + 1;
            if (lines > 4096) { return 0; }
            start = i + 1;
        }
        i = i + 1;
    }
    return lines;
}

# A canonical manifest held in memory: five shard lines (made-up digests and
# sizes) and one other key.
fn build_manifest_base(): i64 {
    var b = tula_builder_new();
    tula_builder_set_meta(b, "hf.architecture", "LlamaForCausalLM");
    var v = alloc(1024);
    var w = 0;
    var i = 0;
    while (i < 5) {
        var k = 0;
        while (k < 64) {
            var d = (i * 7 + k * 3) % 16;
            var c = 48 + d;
            if (d >= 10) { c = 87 + d; }
            store8(v + w, c);
            w = w + 1;
            k = k + 1;
        }
        store8(v + w, 32);
        w = w + 1;
        w = w + put_dec_fz(v + w, 4096 + i * 1000);
        store8(v + w, 32);
        w = w + 1;
        var nm = "model-00000-of-00005.tula";
        var nl = strlen(nm);
        memcpy_n(v + w, nm, nl);
        store8(v + w + 10, 49 + i);
        w = w + nl;
        store8(v + w, 10);
        w = w + 1;
        i = i + 1;
    }
    _tula_builder_put_meta(b, "tula.shards", 11, v, w);
    return tula_builder_finish(b);
}

fn put_dec_fz(p, v): i64 {
    var tmp = alloc(24);
    var n = 0;
    while (v > 0) { store8(tmp + n, 48 + v % 10); v = v / 10; n = n + 1; }
    var j = 0;
    while (j < n) { store8(p + j, load8(tmp + n - 1 - j)); j = j + 1; }
    return n;
}

# A small signed set on disk under build/fuzz_shards: three shards of two f64
# tensors each and a manifest. `paths` gets the three shard paths, `keep` their
# bytes; returns the manifest's path, or 0.
fn build_set_on_disk(sk, paths, keep): i64 {
    sys_mkdir("build/fuzz_shards", 0x1ED);
    var shape = alloc(8);
    store64(shape, 8);
    var i = 0;
    while (i < 3) {
        var b = tula_builder_new();
        var k = 0;
        while (k < 2) {
            var nm = alloc(16);
            store8(nm, 107);                 # "k" + shard digit + "." + letter
            store8(nm + 1, 48 + i);
            store8(nm + 2, 46);
            store8(nm + 3, 97 + k);
            store8(nm + 4, 0);
            var data = alloc(64);
            var q = 0;
            while (q < 8) { store64(data + q * 8, f64_from(i * 100 + k * 10 + q)); q = q + 1; }
            tula_builder_add_checked(b, nm, TULA_DT_F64, shape, 1, data, 64);
            k = k + 1;
        }
        var p = alloc(40);
        memcpy_n(p, "build/fuzz_shards/s0.tula", 26);
        store8(p + 19, 48 + i);
        store64(paths + i * 8, p);
        if (tula_builder_write_file(b, p) <= 0) { return 0; }
        store64(keep + i * 8, tula_read_file(p));
        i = i + 1;
    }
    var mb = tula_builder_new();
    if (tula_builder_set_shards(mb, paths, 3, 2) != 0) { return 0; }
    var mp = "build/fuzz_shards/m.tula";
    if (tula_builder_write_file_signed(mb, mp, sk) <= 0) { return 0; }
    return mp;
}

# Phase K: shard lists in memory against fz_shards_ok, then corrupted sets on
# disk. Returns the failures.
fn shard_phase(s, st, guard, scratch): i64 {
    var fails = 0;
    var base = build_manifest_base();
    var len = tula_total_len(base);
    if (fz_shards_ok(tula_meta_get(base, "tula.shards")) != 5) { return 1; }
    var v0 = tula_meta_get(base, "tula.shards");
    var voff = v0 - base;
    var vlen = strlen(v0);
    var it = 0;
    while (it < FZ_SHARD_ITERS) {
        memcpy_n(scratch, base, len);
        if (rng_below(s, 4) == 0) {
            mutate(s, scratch, len);
        } else {
            var nb = 1 + rng_below(s, 3);
            var q = 0;
            while (q < nb) {
                var pick = rng_below(s, 8);
                var val = rng_below(s, 256);
                if (pick == 0) { val = 48 + rng_below(s, 10); }
                if (pick == 1) { val = 97 + rng_below(s, 6); }
                if (pick == 2) { val = 32; }
                if (pick == 3) { val = 10; }
                if (pick == 4) { val = 47; }
                if (pick == 5) { val = 46; }
                if (pick == 6) { val = 65 + rng_below(s, 6); }
                store8(scratch + voff + rng_below(s, vlen), val);
                q = q + 1;
            }
        }
        var r = tula_open(place(guard, scratch, len), len);
        if (r != 0) {
            var sv = tula_validate_strict(r, len);
            if (sv == TULA_OK) {
                var v = tula_meta_get(r, "tula.shards");
                if (v != 0) {
                    if (fz_shards_ok(v) == 0) { fails = fails + 1; }
                    if (tula_count(r) != 1) { fails = fails + 1; }
                    store64(st + 112, load64(st + 112) + 1);
                }
            }
            if (sv == TULA_ERR_SHARDS) {
                var v2 = tula_meta_get(r, "tula.shards");
                if (v2 == 0) { fails = fails + 1; }
                else {
                    if (fz_shards_ok(v2) != 0) {
                        if (tula_count(r) == 1) { fails = fails + 1; }   # strict refused a good list
                    }
                }
                store64(st + 120, load64(st + 120) + 1);
            }
        }
        it = it + 1;
    }
    # on disk
    var seed = alloc(32);
    var z = 0;
    while (z < 32) { store8(seed + z, z * 5 + 1); z = z + 1; }
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_keypair(seed, sk, pk);
    var paths = alloc(24);
    var keep = alloc(24);
    var mp = build_set_on_disk(sk, paths, keep);
    if (mp == 0) { return fails + 1; }
    var rc = alloc(16);
    var ok = tula_set_open(mp, pk, 0, 2, rc);
    if (ok == 0) { return fails + 1; }
    tula_set_close(ok);
    var bad = alloc(4096);
    it = 0;
    while (it < FZ_SET_ITERS) {
        var k2 = rng_below(s, 3);
        var orig = load64(keep + k2 * 8);
        var tl = tula_total_len(orig);
        memcpy_n(bad, orig, tl);
        var wl = tl;
        if (rng_below(s, 4) == 0) {
            wl = rng_below(s, tl);                  # cut short
        } else {
            var at = rng_below(s, tl);
            store8(bad + at, (load8(bad + at) + 1 + rng_below(s, 255)) & 0xFF);   # a different byte
        }
        tula_write_file(load64(paths + k2 * 8), bad, wl);
        var fl = 0;
        if (rng_below(s, 2) == 1) { fl = TULA_SET_PROTECTED; }
        var set = tula_set_open(mp, pk, fl, 1 + rng_below(s, 4), rc);
        if (set != 0) {
            fails = fails + 1;
            tula_set_close(set);
        } else {
            store64(st + 128, load64(st + 128) + 1);
        }
        tula_write_file(load64(paths + k2 * 8), orig, tl);
        it = it + 1;
    }
    ok = tula_set_open(mp, pk, 0, 2, rc);
    if (ok == 0) { fails = fails + 1; }
    else { tula_set_close(ok); }
    return fails;
}

fn main(): i64 {
    alloc_init();
    var s = alloc(8);
    store64(s, 0x243F6A8885A308D3);   # fixed seed (digits of pi) -> reproducible

    var st = alloc(160);
    var z = 0;
    while (z < 20) { store64(st + z * 8, 0); z = z + 1; }
    # st+0 iters  +8 opened  +16 fails  +24 v_uns  +32 v_ok  +40 v_bad  +48 unpacked
    # +56 strict accepted  +64 strict DUP_NAME  +72 stream writes  +80 nameless
    # +88 canonical builders  +96 strict VALUE (1.7.0)  +104 parallel unpacks (1.9.0)
    # +112 manifests strict-accepted  +120 strict SHARDS  +128 corrupt sets refused (1.11.0)

    var guard = guard_region();
    if (guard == 0) { sput("RESULT: FAIL (could not map the guard page)\n"); return 1; }
    var out = alloc(FZ_OUT_ELEMS * 8);
    var scl = alloc(FZ_SCALES * 8);
    z = 0;
    while (z < FZ_SCALES) { store64(scl + z * 8, f64_from(z + 1)); z = z + 1; }

    var buf0 = build_valid();
    var len0 = tula_total_len(buf0);
    var scratch = alloc(FZ_MAXBUF);

    var t0 = now_ns();

    # ---- phase A: structured mutation of the valid buffer ----
    var a = 0;
    while (a < FZ_MUT_ITERS) {
        memcpy_n(scratch, buf0, len0);
        mutate(s, scratch, len0);
        var testlen = rng_below(s, len0 + 32);
        var r = tula_open(place(guard, scratch, testlen), testlen);
        if (r != 0) {
            store64(st + 8, load64(st + 8) + 1);
            if (check_opened(r, testlen) == 0) { store64(st + 16, load64(st + 16) + 1); }
            store64(st + 48, load64(st + 48) + consume(r, st, out, scl));
            strict_check(r, testlen, st);
        }
        store64(st + 0, load64(st + 0) + 1);
        a = a + 1;
    }

    # ---- phase B: pure random bytes (occasionally with a real magic prefix) ----
    var bph = 0;
    while (bph < FZ_RAND_ITERS) {
        var blen = rng_below(s, 513);
        var w = 0;
        while (w * 8 < blen) { store64(scratch + w * 8, rng_next(s)); w = w + 1; }
        if (rng_below(s, 4) == 0) {
            store64(scratch + 0, TULA_MAGIC);
            store64(scratch + 8, TULA_VERSION);
        }
        var r2 = tula_open(place(guard, scratch, blen), blen);
        if (r2 != 0) {
            store64(st + 8, load64(st + 8) + 1);
            if (check_opened(r2, blen) == 0) { store64(st + 16, load64(st + 16) + 1); }
            store64(st + 48, load64(st + 48) + consume(r2, st, out, scl));
            strict_check(r2, blen, st);
        }
        store64(st + 0, load64(st + 0) + 1);
        bph = bph + 1;
    }

    # ---- phase D: mutate a SIGNED buffer + tula_verify (bounded count) ----
    var sk = alloc(64);
    var pk = alloc(32);
    var seed = alloc(32);
    var q = 0;
    while (q < 32) { store8(seed + q, (q + 1) & 0xFF); q = q + 1; }
    ed25519_keypair(seed, sk, pk);
    var bufs = build_signed(sk);
    var slen0 = tula_total_len(bufs);

    var d = 0;
    while (d < FZ_SIGNED_ITERS) {
        memcpy_n(scratch, bufs, slen0);
        # mutate less aggressively so open() sometimes still succeeds
        if (rng_below(s, 2) == 0) { mutate(s, scratch, slen0); }
        var tl = slen0;
        if (rng_below(s, 3) == 0) { tl = rng_below(s, slen0 + 8); }
        var r3 = tula_open(place(guard, scratch, tl), tl);
        if (r3 != 0) {
            store64(st + 8, load64(st + 8) + 1);
            if (check_opened(r3, tl) == 0) { store64(st + 16, load64(st + 16) + 1); }
            store64(st + 48, load64(st + 48) + consume(r3, st, out, scl));
            strict_check(r3, tl, st);
            var v = tula_verify(r3, pk);
            if (v == TULA_SIG_UNSIGNED) { store64(st + 24, load64(st + 24) + 1); }
            if (v == TULA_SIG_OK)       { store64(st + 32, load64(st + 32) + 1); }
            if (v == TULA_SIG_BAD)      { store64(st + 40, load64(st + 40) + 1); }
            if (v < 0) { store64(st + 16, load64(st + 16) + 1); }
            if (v > 2) { store64(st + 16, load64(st + 16) + 1); }
        }
        store64(st + 0, load64(st + 0) + 1);
        d = d + 1;
    }

    # ---- phase E: a 40-tensor canonical file; mutations + injected duplicates ----
    var bufe = build_strict_base();
    var elen = tula_total_len(bufe);
    var ep = 0;
    while (ep < FZ_STRICT_ITERS) {
        memcpy_n(scratch, bufe, elen);
        var how = rng_below(s, 4);
        if (how == 0) { mutate(s, scratch, elen); }
        if (how >= 1) {
            # copy one name field over another: a duplicate, everything else canonical
            var src = rng_below(s, FZ_STRICT_N);
            var dst = rng_below(s, FZ_STRICT_N);
            memcpy_n(scratch + 64 + dst * 144, scratch + 64 + src * 144, 48);
            if (how == 3) { mutate(s, scratch, elen); }
        }
        var re = tula_open(place(guard, scratch, elen), elen);
        if (re != 0) {
            store64(st + 8, load64(st + 8) + 1);
            if (check_opened(re, elen) == 0) { store64(st + 16, load64(st + 16) + 1); }
            strict_check(re, elen, st);
        }
        store64(st + 0, load64(st + 0) + 1);
        ep = ep + 1;
    }

    # ---- phase F: a long-name file; mutations aimed at the names table ----
    var bufl = build_long_base();
    var llen = tula_total_len(bufl);
    var lt = load64(bufl + 32) + load64(tula_entry(bufl, tula_count(bufl) - 1) + 128);   # table offset
    var lf = 0;
    while (lf < FZ_LONG_ITERS) {
        memcpy_n(scratch, bufl, llen);
        var nm2 = 1 + rng_below(s, 4);
        var mk = 0;
        while (mk < nm2) {
            var where = rng_below(s, 4);
            if (where == 0) { mutate(s, scratch, llen); }
            if (where >= 1) {
                # inside the table: a byte, or a record word set to an edge value
                var tl = llen - lt;
                if (rng_below(s, 2) == 0) {
                    store8(scratch + lt + rng_below(s, tl), rng_below(s, 256));
                } else {
                    var wv = rng_below(s, 6);
                    var val = rng_next(s);
                    if (wv == 1) { val = 0 - 1; }
                    if (wv == 2) { val = 0; }
                    if (wv == 3) { val = tl; }
                    if (wv == 4) { val = 0x7FFFFFFFFFFFFFFF; }
                    if (wv == 5) { val = rng_below(s, 16); }
                    store64(scratch + lt + 8 + rng_below(s, (tl - 8) / 8) * 8, val);
                }
            }
            mk = mk + 1;
        }
        var rl = tula_open(place(guard, scratch, llen), llen);
        if (rl != 0) {
            store64(st + 8, load64(st + 8) + 1);
            if (check_opened(rl, llen) == 0) { store64(st + 16, load64(st + 16) + 1); }
            store64(st + 48, load64(st + 48) + consume(rl, st, out, scl));
            strict_check(rl, llen, st);
        }
        store64(st + 0, load64(st + 0) + 1);
        lf = lf + 1;
    }

    # ---- phase G: metadata + names; mutations aimed at the metadata table ----
    var bufm = build_meta_base();
    var mlen = tula_total_len(bufm);
    var rm0 = tula_open(bufm, mlen);
    var mte = tula_entry(rm0, tula_count(rm0) - 2);                 # the metadata entry
    var mt0 = load64(bufm + 32) + load64(mte + 128);                # its payload offset
    var mtl = load64(mte + 136);
    var mg = 0;
    while (mg < FZ_META_ITERS) {
        memcpy_n(scratch, bufm, mlen);
        var nmg = 1 + rng_below(s, 4);
        var mm = 0;
        while (mm < nmg) {
            var how = rng_below(s, 5);
            if (how == 0) { mutate(s, scratch, mlen); }
            if (how == 1) { store8(scratch + mt0 + rng_below(s, mtl), rng_below(s, 256)); }
            if (how == 2) {
                # a record word set to an edge value
                var wv = rng_below(s, 6);
                var val = rng_next(s);
                if (wv == 1) { val = 0 - 1; }
                if (wv == 2) { val = 0; }
                if (wv == 3) { val = mtl; }
                if (wv == 4) { val = 0x7FFFFFFFFFFFFFFF; }
                if (wv == 5) { val = rng_below(s, mtl); }
                store64(scratch + mt0 + 8 + rng_below(s, (mtl - 8) / 8) * 8, val);
            }
            if (how >= 3) {
                # a high byte (UTF-8 edge) or NUL into the key/value bytes
                var hb = 0;
                var pick = rng_below(s, 6);
                if (pick == 0) { hb = 0xC0; }
                if (pick == 1) { hb = 0xED; }
                if (pick == 2) { hb = 0xF4; }
                if (pick == 3) { hb = 0x80; }
                if (pick == 4) { hb = 0xFF; }
                var dstart = 16 + 6 * 32;
                store8(scratch + mt0 + dstart + rng_below(s, mtl - dstart), hb);
            }
            mm = mm + 1;
        }
        var rg = tula_open(place(guard, scratch, mlen), mlen);
        if (rg != 0) {
            store64(st + 8, load64(st + 8) + 1);
            if (check_opened(rg, mlen) == 0) { store64(st + 16, load64(st + 16) + 1); }
            strict_check(rg, mlen, st);
        }
        store64(st + 0, load64(st + 0) + 1);
        mg = mg + 1;
    }

    # ---- phase H: random builders through the streaming writers ----
    xmkdir("build/fuzz_write", 0x1ED);
    var wpath = "build/fuzz_write/f.tula";
    var pool = alloc(FZ_POOL);
    z = 0;
    while (z < FZ_POOL / 8) { store64(pool + z * 8, rng_next(s)); z = z + 1; }
    var bpool = alloc(FZ_POOL);   # 0/1 bytes: canonical BOOL payloads (1.7.0)
    z = 0;
    while (z < FZ_POOL / 8) { store64(bpool + z * 8, rng_next(s) & 0x0101010101010101); z = z + 1; }
    var wcap = FZ_POOL + 65536;
    var wbuf = alloc(wcap);
    var nm = alloc(160);
    var vb = alloc(160);
    var wshape = alloc(64);
    var ne = alloc(8);
    var canon = alloc(8);
    var h = 0;
    while (h < FZ_WRITE_ITERS) {
        var bw = rand_builder(s, pool, bpool, nm, vb, wshape, ne, canon);
        var signed = 0;
        if (rng_below(s, 6) == 0) { signed = 1; }
        var want = 0;
        if (signed == 1) { want = tula_builder_finish_signed(bw, sk); }
        else             { want = tula_builder_finish(bw); }
        var wl = tula_total_len(want);
        _tula_nameless_off = rng_below(s, 2);
        var got = 0;
        if (signed == 1) { got = tula_builder_write_file_signed(bw, wpath, sk); }
        else             { got = tula_builder_write_file(bw, wpath); }
        var wok = 1;
        if (got != wl) { wok = 0; }
        if (wok == 1) {
            if (file_read_all(wpath, wbuf, wcap) != wl) { wok = 0; }
        }
        if (wok == 1) { wok = same_bytes(wbuf, want, wl); }
        if (load64(canon) == 1) {
            store64(st + 88, load64(st + 88) + 1);
            if (tula_validate_strict(want, wl) != TULA_OK) { wok = 0; }
        }
        if (wok == 0) { store64(st + 16, load64(st + 16) + 1); }
        store64(st + 72, load64(st + 72) + 1);
        store64(st + 80, load64(st + 80) + _tula_nameless_used);
        store64(st + 0, load64(st + 0) + 1);
        h = h + 1;
    }
    _tula_nameless_off = 0;
    # every temp was renamed into place or removed: the directory holds the target only
    if (vec_len(dir_list(str_from("build/fuzz_write"))) != 1) { store64(st + 16, load64(st + 16) + 1); }

    # ---- phase I (1.7.0): the integer and boolean dtypes; mutations aimed at
    #      the BOOL payloads, the dtype fields and the shapes ----
    var bufi = build_int_base();
    var ilen = tula_total_len(bufi);
    var icount = tula_count(bufi);
    var ipay = load64(bufi + 32);
    var ii = 0;
    while (ii < FZ_INT_ITERS) {
        memcpy_n(scratch, bufi, ilen);
        var nmi = 1 + rng_below(s, 3);
        var mi = 0;
        while (mi < nmi) {
            var ek = rng_below(s, icount);
            var ei = scratch + 64 + ek * 144;
            var eo = bufi + 64 + ek * 144;                # offsets from the pristine entry
            var how = rng_below(s, 6);
            if (how == 0) { mutate(s, scratch, ilen); }
            if (how == 1) { store64(ei + 48, rng_below(s, 18)); }                         # any code; 16, 17 unknown
            if (how == 2) { store64(ei + 64 + rng_below(s, 2) * 8, rng_below(s, 9)); }    # a dim
            if (how == 3) { store64(ei + 136, load64(eo + 136) + rng_below(s, 3) - 1); }  # data_len -1 / 0 / +1
            if (how >= 4) {
                # a payload byte (a BOOL's, mostly): 0 or 1 half the time
                var pdl = load64(eo + 136);
                if (pdl > 0) {
                    var pv = rng_below(s, 2);
                    if (rng_below(s, 2) == 0) { pv = rng_below(s, 256); }
                    store8(scratch + ipay + load64(eo + 128) + rng_below(s, pdl), pv);
                }
            }
            mi = mi + 1;
        }
        var ri = tula_open(place(guard, scratch, ilen), ilen);
        if (ri != 0) {
            store64(st + 8, load64(st + 8) + 1);
            if (check_opened(ri, ilen) == 0) { store64(st + 16, load64(st + 16) + 1); }
            store64(st + 48, load64(st + 48) + consume(ri, st, out, scl));
            strict_check(ri, ilen, st);
        }
        store64(st + 0, load64(st + 0) + 1);
        ii = ii + 1;
    }

    # ---- phase J (1.9.0): the parallel unpack against the serial helpers ----
    store64(st + 16, load64(st + 16) + par_phase(s, st));

    # ---- phase K (1.11.0): shard lists against the fuzzer's reading, corrupt sets ----
    store64(st + 16, load64(st + 16) + shard_phase(s, st, guard, scratch));

    var t1 = now_ns();

    sput("tula fuzz — reader hardening (M3) under hostile input\n");
    kv("  iterations         : ", load64(st + 0));
    kv("  opened (accepted)  : ", load64(st + 8));
    kv("  verify UNSIGNED    : ", load64(st + 24));
    kv("  verify OK          : ", load64(st + 32));
    kv("  verify BAD         : ", load64(st + 40));
    kv("  unpacked entries   : ", load64(st + 48));
    kv("  strict accepted    : ", load64(st + 56));
    kv("  strict DUP_NAME    : ", load64(st + 64));
    kv("  strict VALUE       : ", load64(st + 96));
    kv("  parallel unpacks   : ", load64(st + 104));
    kv("  manifests accepted : ", load64(st + 112));
    kv("  strict SHARDS      : ", load64(st + 120));
    kv("  corrupt sets refused: ", load64(st + 128));
    kv("  stream writes      : ", load64(st + 72));
    kv("    nameless         : ", load64(st + 80));
    kv("    canonical        : ", load64(st + 88));
    kv("  elapsed ms         : ", (t1 - t0) / 1000000);
    var fails = load64(st + 16);
    kv("  invariant failures : ", fails);
    if (fails == 0) {
        sput("RESULT: PASS (no crash or guard-page fault; every accepted buffer was sound;\n");
        sput("        every streamed file matched finish)\n");
        return 0;
    }
    sput("RESULT: FAIL (invariant breach)\n");
    return 1;
}

var exit_code = main();
syscall(60, exit_code);
